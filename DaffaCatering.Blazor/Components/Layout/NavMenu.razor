<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@(Collapsed ? "DC" : "Daffa Catering")</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        @* ================= 1. DASHBOARD (semua role) ================= *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Home">
                <i class="fa-solid fa-house fa-fw"></i>
                @if (!Collapsed)
                {
                    <span>Dashboard</span>
                }
            </NavLink>
        </div>

        @* ================= 2. MASTER DATA (isi submenu per role) ================= *@
        <div class="nav-item px-3">
            <button class="nav-link btn-submenu" @onclick="ToggleMasterData" title="Master Data">
                <i class="fa-solid fa-database fa-fw"></i>
                @if (!Collapsed)
                {
                    <span>Master Data</span>
                    <i class="fa-solid fa-chevron-down chevron @(masterDataOpen ? "rotated" : "")"></i>
                }
            </button>

            @if (masterDataOpen && !Collapsed)
            {
                <div class="submenu">
                    <AuthorizeView Roles="@AppRoles.AdminPenjualan">
                        <NavLink class="nav-link submenu-link" href="pelanggan">
                            <i class="fa-solid fa-circle-dot fa-fw"></i> Pelanggan
                        </NavLink>
                    </AuthorizeView>
                    <AuthorizeView Roles="@AppRoles.AdminPembelian">
                        <NavLink class="nav-link submenu-link" href="pemasok">
                            <i class="fa-solid fa-circle-dot fa-fw"></i> Pemasok
                        </NavLink>
                    </AuthorizeView>
                    <AuthorizeView Roles="@AppRoles.AdminPersediaan">
                        <NavLink class="nav-link submenu-link" href="master-bahan-baku">
                            <i class="fa-solid fa-circle-dot fa-fw"></i> Bahan Baku
                        </NavLink>
                        <NavLink class="nav-link submenu-link" href="satuan-bahan-baku">
                            <i class="fa-solid fa-circle-dot fa-fw"></i> Satuan Bahan Baku
                        </NavLink>
                        <NavLink class="nav-link submenu-link" href="konversi-satuan">
                            <i class="fa-solid fa-circle-dot fa-fw"></i> Konversi Satuan
                        </NavLink>
                    </AuthorizeView>
                    <AuthorizeView Roles="@AppRoles.AdminPenjualan">
                        <NavLink class="nav-link submenu-link" href="menu-makanan">
                            <i class="fa-solid fa-circle-dot fa-fw"></i> Menu Makanan
                        </NavLink>
                    </AuthorizeView>
                </div>
            }
        </div>

        @* ================= 3. PENJUALAN ================= *@
        <AuthorizeView Roles="@AppRoles.AdminPenjualan">
            <div class="nav-item px-3">
                <button class="nav-link btn-submenu" @onclick="TogglePenjualan" title="Penjualan">
                    <i class="fa-solid fa-cart-shopping fa-fw"></i>
                    @if (!Collapsed)
                    {
                        <span>Penjualan</span>
                        <i class="fa-solid fa-chevron-down chevron @(penjualanOpen ? "rotated" : "")"></i>
                    }
                </button>
                @if (penjualanOpen && !Collapsed)
                {
                    <div class="submenu">
                        <NavLink class="nav-link submenu-link" href="pesanan-penjualan">
                            <i class="fa-solid fa-circle-dot fa-fw"></i> Pesanan Penjualan
                        </NavLink>
                        <NavLink class="nav-link submenu-link" href="penjualan">
                            <i class="fa-solid fa-circle-dot fa-fw"></i> Penjualan
                        </NavLink>
                    </div>
                }
            </div>
        </AuthorizeView>

        @* ================= 4. PEMBELIAN ================= *@
        <AuthorizeView Roles="@AppRoles.AdminPembelian">
            <div class="nav-item px-3">
                <button class="nav-link btn-submenu" @onclick="TogglePembelian" title="Pembelian">
                    <i class="fa-solid fa-truck-fast fa-fw"></i>
                    @if (!Collapsed)
                    {
                        <span>Pembelian</span>
                        <i class="fa-solid fa-chevron-down chevron @(pembelianOpen ? "rotated" : "")"></i>
                    }
                </button>
                @if (pembelianOpen && !Collapsed)
                {
                    <div class="submenu">
                        <NavLink class="nav-link submenu-link" href="pembelian-bahan-baku">
                            <i class="fa-solid fa-circle-dot fa-fw"></i> Pembelian
                        </NavLink>
                        <NavLink class="nav-link submenu-link" href="penerimaan-bahan-baku">
                            <i class="fa-solid fa-circle-dot fa-fw"></i> Penerimaan BB
                        </NavLink>
                    </div>
                }
            </div>
        </AuthorizeView>

        @* ================= 5. PERSEDIAAN ================= *@
        <AuthorizeView Roles="@AppRoles.AdminPersediaan">
            <div class="nav-item px-3">
                <button class="nav-link btn-submenu" @onclick="ToggleInventory" title="Persediaan">
                    <i class="fa-solid fa-warehouse fa-fw"></i>
                    @if (!Collapsed)
                    {
                        <span>Persediaan</span>
                        <i class="fa-solid fa-chevron-down chevron @(inventoryOpen ? "rotated" : "")"></i>
                    }
                </button>
                @if (inventoryOpen && !Collapsed)
                {
                    <div class="submenu">
                        <NavLink class="nav-link submenu-link" href="penggunaan-bahan-baku">
                            <i class="fa-solid fa-circle-dot fa-fw"></i> Penggunaan BB
                        </NavLink>
                        <NavLink class="nav-link submenu-link" href="penyesuaian-bahan-baku">
                            <i class="fa-solid fa-circle-dot fa-fw"></i> Penyesuaian BB
                        </NavLink>
                    </div>
                }
            </div>
        </AuthorizeView>

        @* ================= 6. LAPORAN (isi submenu per role) ================= *@
        <AuthorizeView Roles="@AppRoles.Semua" Context="grupLaporan">
            <div class="nav-item px-3">
                <button class="nav-link btn-submenu" @onclick="ToggleLaporan" title="Laporan">
                    <i class="fa-solid fa-chart-column fa-fw"></i>
                    @if (!Collapsed)
                    {
                        <span>Laporan</span>
                        <i class="fa-solid fa-chevron-down chevron @(laporanOpen ? "rotated" : "")"></i>
                    }
                </button>
                @if (laporanOpen && !Collapsed)
                {
                    <div class="submenu">
                        <AuthorizeView Roles="@AppRoles.AdminPenjualan">
                            <NavLink class="nav-link submenu-link" href="laporan/penjualan">
                                <i class="fa-solid fa-circle-dot fa-fw"></i> Penjualan
                            </NavLink>
                        </AuthorizeView>
                        <AuthorizeView Roles="@AppRoles.AdminPembelian">
                            <NavLink class="nav-link submenu-link" href="laporan/pembelian">
                                <i class="fa-solid fa-circle-dot fa-fw"></i> Pembelian
                            </NavLink>
                        </AuthorizeView>
                        <AuthorizeView Roles="@AppRoles.AdminPersediaan">
                            <NavLink class="nav-link submenu-link" href="laporan/bahan-baku">
                                <i class="fa-solid fa-circle-dot fa-fw"></i> Bahan Baku
                            </NavLink>
                        </AuthorizeView>
                        <AuthorizeView Roles="@AppRoles.BacaMenuMakanan">
                            <NavLink class="nav-link submenu-link" href="laporan/menu-makanan">
                                <i class="fa-solid fa-circle-dot fa-fw"></i> Menu Makanan
                            </NavLink>
                        </AuthorizeView>
                        <AuthorizeView Roles="@AppRoles.AdminPenjualan">
                            <NavLink class="nav-link submenu-link" href="laporan/pelanggan">
                                <i class="fa-solid fa-circle-dot fa-fw"></i> Pelanggan
                            </NavLink>
                        </AuthorizeView>
                        <AuthorizeView Roles="@AppRoles.AdminPembelian">
                            <NavLink class="nav-link submenu-link" href="laporan/pemasok">
                                <i class="fa-solid fa-circle-dot fa-fw"></i> Pemasok
                            </NavLink>
                        </AuthorizeView>
                    </div>
                }
            </div>
        </AuthorizeView>

        @* ================= 7. PENGATURAN (khusus Admin) ================= *@
        <AuthorizeView Roles="@AppRoles.Admin">
            <hr class="text-white-50 mx-3" />
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="settings" title="Settings">
                    <i class="fa-solid fa-gear fa-fw"></i>
                    @if (!Collapsed)
                    {
                        <span>Pengaturan</span>
                    }
                </NavLink>
            </div>
        </AuthorizeView>

    </nav>
</div>

@code {
    [Parameter]
    public bool Collapsed { get; set; }

    private bool masterDataOpen = false;
    private bool penjualanOpen = false;
    private bool pembelianOpen = false;
    private bool inventoryOpen = false;
    private bool laporanOpen = false;

    private void ToggleMasterData()
    {
        masterDataOpen = !masterDataOpen;
        penjualanOpen = false;
        pembelianOpen = false;
        inventoryOpen = false;
        laporanOpen = false;
    }

    private void TogglePenjualan()
    {
        penjualanOpen = !penjualanOpen;
        masterDataOpen = false;
        pembelianOpen = false;
        inventoryOpen = false;
        laporanOpen = false;
    }

    private void TogglePembelian()
    {
        pembelianOpen = !pembelianOpen;
        masterDataOpen = false;
        penjualanOpen = false;
        inventoryOpen = false;
        laporanOpen = false;
    }

    private void ToggleInventory()
    {
        inventoryOpen = !inventoryOpen;
        masterDataOpen = false;
        penjualanOpen = false;
        pembelianOpen = false;
        laporanOpen = false;
    }

    private void ToggleLaporan()
    {
        laporanOpen = !laporanOpen;
        masterDataOpen = false;
        penjualanOpen = false;
        pembelianOpen = false;
        inventoryOpen = false;
    }
}