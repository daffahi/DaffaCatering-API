<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@(Collapsed ? "DC" : "Daffa Catering")</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Home">
                <i class="fa-solid fa-house fa-fw"></i>
                @if (!Collapsed)
                {
                    <span>Home</span>
                }
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <button class="nav-link btn-submenu" @onclick="ToggleMasterData" title="Master Data">
                <i class="fa-solid fa-database fa-fw"></i>
                @if (!Collapsed)
                {
                    <span>Master Data</span>
                    <i class="fa-solid fa-chevron-down chevron @(masterDataOpen ? "rotated" : "")"></i>
                }
            </button>

            @if (masterDataOpen && !Collapsed)
            {
                <div class="submenu">
                    <NavLink class="nav-link submenu-link" href="pelanggan">
                        <i class="fa-solid fa-circle-dot fa-fw"></i> Customer
                    </NavLink>
                    <NavLink class="nav-link submenu-link" href="pemasok">
                        <i class="fa-solid fa-circle-dot fa-fw"></i> Supplier
                    </NavLink>
                    <NavLink class="nav-link submenu-link" href="bahan-baku">
                        <i class="fa-solid fa-circle-dot fa-fw"></i> Raw Materials
                    </NavLink>
                    <NavLink class="nav-link submenu-link" href="satuan-bahan-baku">
                        <i class="fa-solid fa-circle-dot fa-fw"></i> Unit of Raw Materials
                    </NavLink>
                    <NavLink class="nav-link submenu-link" href="konversi-satuan">
                        <i class="fa-solid fa-circle-dot fa-fw"></i> Unit Conversion
                    </NavLink>
                    <NavLink class="nav-link submenu-link" href="menu-makanan">
                        <i class="fa-solid fa-circle-dot fa-fw"></i> Food Menu
                    </NavLink>
                </div>
            }
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="sales-data" title="Sales">
                <i class="fa-solid fa-cart-shopping fa-fw"></i>
                @if (!Collapsed)
                {
                    <span>Sales</span>
                }
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="purchase-data" title="Purchase">
                <i class="fa-solid fa-truck-fast fa-fw"></i>
                @if (!Collapsed)
                {
                    <span>Purchase</span>
                }
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="inventory-data" title="Inventory">
                <i class="fa-solid fa-warehouse fa-fw"></i>
                @if (!Collapsed)
                {
                    <span>Inventory</span>
                }
            </NavLink>
        </div>
        <hr class="text-white-50 mx-3" />
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings" title="Settings">
                <i class="fa-solid fa-gear fa-fw"></i>
                @if (!Collapsed)
                {
                    <span>Settings</span>
                }
            </NavLink>
        </div>
    </nav>
</div>

@code {
    [Parameter]
    public bool Collapsed { get; set; }

    private bool masterDataOpen = false;

    private void ToggleMasterData()
    {
        masterDataOpen = !masterDataOpen;
    }
}