@inherits LayoutComponentBase
@inject JwtAuthStateProvider AuthProvider
@inject NavigationManager Nav

<AuthorizeView>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <span class="me-3">@context.User.Identity?.Name</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="Keluar">Keluar</button>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private async Task Keluar()
    {
        await AuthProvider.KeluarAsync();
        Nav.NavigateTo("/login");
    }
}