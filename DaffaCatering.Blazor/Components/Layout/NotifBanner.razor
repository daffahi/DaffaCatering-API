@if (!string.IsNullOrEmpty(Pesan))
{
    <div class="banner @(Sukses ? "ok" : "") @Class" role="@(Sukses ? "status" : "alert")">
        <i class="fa-solid @(Sukses ? "fa-circle-check" : "fa-circle-exclamation")" aria-hidden="true"></i>
        <span>@Pesan</span>
        <button type="button" class="banner-close" aria-label="Tutup notifikasi" @onclick="Tutup">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
    </div>
}

@code {
    [Parameter] public string? Pesan { get; set; }
    [Parameter] public EventCallback<string?> PesanChanged { get; set; }
    [Parameter] public bool Sukses { get; set; }
    [Parameter] public string? Class { get; set; }

    private Task Tutup() => PesanChanged.InvokeAsync(string.Empty);
}