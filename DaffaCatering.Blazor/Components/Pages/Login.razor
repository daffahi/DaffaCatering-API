@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@inject IHttpClientFactory Factory
@inject JwtAuthStateProvider AuthProvider
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Authorization;

<PageTitle>Daffa Catering</PageTitle>

<div class="card shadow-sm login-card" style="width: 380px;">
    <div class="card-body p-4">
        <h4 class="text-center mb-1 login-title">Daffa Catering</h4>
        <p class="text-center text-muted mb-4">Silahkan login</p>

        <EditForm Model="model" OnValidSubmit="ProsesLogin">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">ID Pengguna</label>
                <InputText class="form-control" @bind-Value="model.IdUser" />
                <ValidationMessage For="() => model.IdUser" />
            </div>

            <div class="mb-3">
                <label class="form-label">Kata Sandi</label>
                <div class="password-wrapper">
                    <InputText type="@(showPassword ? "text" : "password")" class="form-control" @bind-Value="model.Password" />
                    <button type="button" class="btn-toggle-password" @onclick="TogglePassword" tabindex="-1">
                        <i class="fa-solid @(showPassword ? "fa-eye-slash" : "fa-eye")"></i>
                    </button>
                </div>
                <ValidationMessage For="() => model.Password" />
            </div>

            @if (pesanError != "")
            {
                <div class="alert alert-danger py-2">@pesanError</div>
            }

            <button type="submit" class="btn btn-login w-100" disabled="@sedangProses">
                @if (sedangProses)
                {
                    <span>Sedang proses...</span>
                }
                else
                {
                    <span>Masuk</span>
                }
            </button>
        </EditForm>
    </div>
</div>

@code {
    private LoginRequest model = new LoginRequest();
    private string pesanError = "";
    private bool sedangProses = false;
    private bool showPassword = false;

    private async Task ProsesLogin()
    {
        pesanError = "";
        sedangProses = true;

        try
        {
            var http = Factory.CreateClient("API");
            var response = await http.PostAsJsonAsync("api/User/login", model);

            if (response.IsSuccessStatusCode)
            {
                var hasil = await response.Content.ReadFromJsonAsync<LoginResponse>();
                if (hasil != null && hasil.Token != "")
                {
                    await AuthProvider.MasukAsync(hasil.Token);
                    Nav.NavigateTo("/");
                }
                else
                {
                    pesanError = "Respons dari server tidak valid";
                }
            }
            else
            {
                // Pesan dari API, misalnya "ID User atau Password salah"
                pesanError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            pesanError = "Tidak bisa terhubung ke server: " + ex.Message;
        }

        sedangProses = false;
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }
}