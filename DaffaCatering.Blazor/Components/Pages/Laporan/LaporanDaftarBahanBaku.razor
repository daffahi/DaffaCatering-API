@page "/laporan/bahan-baku"
@attribute [Authorize(Roles = AppRoles.AdminPersediaan)]
@implements IAsyncDisposable

@using System.Globalization
@using DaffaCatering.Blazor.Models.Persediaan
@using DaffaCatering.Blazor.Services.Persediaan
@inject LaporanDaftarBahanBakuService LaporanService
@inject IConfiguration Config
@inject IJSRuntime JS

@{
    var tampil = Tampil;
    var kelompok = tampil.GroupBy(b => b.Jenis).ToList();
    var jmlPersediaan = tampil.Count(b => b.Jenis == JenisPersediaan);
    var jmlHabisPakai = tampil.Count(b => b.Jenis == JenisHabisPakai);
}

<div class="laporan-page">

    @* ================= 1. HEADER HALAMAN ================= *@
    <header class="page-head">
        <div>
            <h1>Laporan Bahan Baku</h1>
            <p>Daftar bahan baku per jenis beserta satuannya</p>
        </div>
        <button class="btn-cetak" disabled="@(isLoading || tampil.Count == 0)" @onclick="Cetak">
            <i class="fa-solid fa-print"></i> Cetak
        </button>
    </header>

    @* ================= 2. BANNER ERROR ================= *@
    @if (!string.IsNullOrEmpty(errorLaporan))
    {
        <div class="banner">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@errorLaporan</span>
            <button class="banner-close" @onclick="TutupError">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @* ================= 3. FILTER LAPORAN ================= *@
    <section class="filter-card">
        <label class="search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="Cari kode atau nama bahan baku..."
                   @bind="teksCari" @bind:event="oninput" />
        </label>
    </section>

    @* ================= 4. KARTU RINGKASAN ================= *@
    @if (!isLoading)
    {
        <section class="dashboard-cards">
            <div class="dashboard-card">
                <div class="card-icon"><i class="fa-solid fa-wheat-awn"></i></div>
                <div class="card-content">
                    <div class="card-title">@tampil.Count Bahan Baku</div>
                    <div class="card-subtitle">Bahan baku dalam laporan</div>
                </div>
            </div>
            <div class="dashboard-card">
                <div class="card-icon"><i class="fa-solid fa-boxes-stacked"></i></div>
                <div class="card-content">
                    <div class="card-title">@jmlPersediaan Bahan Baku</div>
                    <div class="card-subtitle">Persediaan</div>
                </div>
            </div>
            <div class="dashboard-card">
                <div class="card-icon"><i class="fa-solid fa-basket-shopping"></i></div>
                <div class="card-content">
                    <div class="card-title">@jmlHabisPakai Bahan Baku</div>
                    <div class="card-subtitle">Bahan habis pakai</div>
                </div>
            </div>
        </section>
    }

    @* ================= 5. TABEL LAPORAN ================= *@
    <section class="panel">

        @if (isLoading)
        {
            <div class="skeleton">
                @for (var s = 0; s < 6; s++)
                {
                    <div class="sk-row">
                        <div class="sk-avatar"></div>
                        <div class="sk-lines"><div></div><div></div></div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Bahan Baku</th>
                            <th>Satuan</th>
                        </tr>
                    </thead>

                    @foreach (var g in kelompok)
                    {
                        <tbody @key="g.Key">
                            <tr class="grp-head">
                                <td colspan="2">
                                    <div class="name">Jenis Bahan Baku: @g.Key</div>
                                    <div class="sub">@g.Count() bahan baku</div>
                                </td>
                            </tr>

                            @foreach (var b in g)
                            {
                                <tr class="row-trx" @key="b.IdBahanBaku">
                                    <td>
                                        <div class="who">
                                            <div class="avatar tone-@Warna(b.NamaBahanBaku)">@Inisial(b.NamaBahanBaku)</div>
                                            <div>
                                                <div class="name">@b.NamaBahanBaku</div>
                                                <div class="sub">@b.IdBahanBaku</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@b.NamaSatuan</td>
                                </tr>
                            }
                        </tbody>
                    }
                </table>

                @if (tampil.Count == 0)
                {
                    <div class="empty">
                        <i class="fa-regular fa-face-frown-open"></i>
                        <strong>Bahan baku tidak ditemukan</strong>
                        <span>Tidak ada bahan baku yang cocok, coba ubah kata kunci</span>
                    </div>
                }
            </div>

            <div class="panel-foot">
                <span>Menampilkan <b>@tampil.Count</b> dari <b>@data.Count</b> bahan baku</span>
            </div>
        }
    </section>

    @* ================= 6. DOKUMEN CETAK (tidak tampil di layar) ================= *@
    @if (!isLoading && tampil.Count > 0)
    {
        <div id="dokumen-cetak" class="doc">

            <header class="doc-kop">
                <img src="images/logo.png" class="doc-logo" alt="" onerror="this.style.display='none'" />
                <div class="doc-judul">
                    <h1>@JudulLaporan</h1>
                    <div class="doc-usaha">@NamaUsaha</div>
                    <div class="doc-alamat">@AlamatUsaha</div>
                </div>
                <div></div>
            </header>

            <hr class="doc-garis" />

            <div class="doc-meta">
                <span>Dicetak oleh: <b>@namaPencetak</b></span>
                <span>Tanggal Cetak: <b>@Tgl(DateOnly.FromDateTime(DateTime.Today))</b></span>
            </div>
            @if (!string.IsNullOrWhiteSpace(teksCari))
            {
                <div class="doc-meta">
                    <span>Pencarian: <b>@teksCari</b></span>
                </div>
            }

            @* Satu blok per jenis, penomoran mulai dari 1 di tiap blok *@
            @foreach (var g in kelompok)
            {
                var nomor = 0;

                <section class="doc-blok">
                    <table class="doc-info">
                        <tr>
                            <th>Jenis Bahan Baku</th>
                            <td class="sep">:</td>
                            <td>@g.Key</td>
                        </tr>
                    </table>

                    <table class="doc-tabel">
                        <colgroup>
                            <col style="width:44px" />
                            <col style="width:130px" />
                            <col />
                            <col style="width:120px" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Kode Bahan Baku</th>
                                <th>Nama Bahan Baku</th>
                                <th>Satuan</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in g)
                            {
                                <tr>
                                    <td class="c">@(++nomor)</td>
                                    <td class="c">@b.IdBahanBaku</td>
                                    <td>@b.NamaBahanBaku</td>
                                    <td class="c">@b.NamaSatuan</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>
            }
        </div>
    }

</div>

@code {
    // =====================================================
    // 1. STATE
    // =====================================================
    private static readonly CultureInfo IdCulture = new("id-ID");

    private const string JenisPersediaan = "Persediaan";
    private const string JenisHabisPakai = "Bahan Habis Pakai";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    // --- data ---
    private List<LaporanDaftarBahanBakuModels> data = new();

    // --- halaman ---
    private bool isLoading = true;
    private string errorLaporan = "";
    private string teksCari = "";
    private string namaPencetak = "";
    private IJSObjectReference? modulCetak;

    private void TutupError() => errorLaporan = "";

    // =====================================================
    // 2. LIFECYCLE & MUAT DATA
    // =====================================================
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            namaPencetak = state.User.Identity?.Name ?? "";
        }

        await MuatLaporan();
    }

    public async ValueTask DisposeAsync()
    {
        if (modulCetak is null) return;

        try { await modulCetak.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }

    private async Task MuatLaporan()
    {
        isLoading = true;
        errorLaporan = "";

        try
        {
            var (hasilApi, error) = await LaporanService.AmbilAsync();

            if (hasilApi is null)
            {
                errorLaporan = "Gagal memuat laporan: " + error;
                data = new();
            }
            else
            {
                data = hasilApi;
            }
        }
        catch (Exception ex)
        {
            errorLaporan = "Gagal memuat laporan: " + ex.Message;
            data = new();
        }

        isLoading = false;
    }

    // =====================================================
    // 3. HELPER UMUM (format)
    // =====================================================
    private static string Tgl(DateOnly d) => d.ToString("dd/MM/yyyy", IdCulture);

    private static string Inisial(string? nama)
    {
        var p = (nama ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length == 0 ? "?"
             : p.Length == 1 ? p[0][..1].ToUpper()
             : (p[0][..1] + p[^1][..1]).ToUpper();
    }

    // Warna avatar stabil per nama (string.GetHashCode() berubah tiap proses, jadi tidak dipakai)
    private static int Warna(string? nama) => (nama ?? "").Sum(ch => ch) % 5;

    // =====================================================
    // 4. TAMPILAN: PENCARIAN & URUTAN
    // =====================================================
    private bool Cocok(LaporanDaftarBahanBakuModels b)
    {
        if (string.IsNullOrWhiteSpace(teksCari)) return true;

        return b.IdBahanBaku.Contains(teksCari, StringComparison.OrdinalIgnoreCase)
            || b.NamaBahanBaku.Contains(teksCari, StringComparison.OrdinalIgnoreCase);
    }

    // Urutan (jenis lalu kode) sudah diatur oleh API
    private List<LaporanDaftarBahanBakuModels> Tampil => data.Where(Cocok).ToList();

    // =====================================================
    // 5. DOKUMEN CETAK
    // =====================================================
    private string NamaUsaha => Config["Usaha:Nama"] ?? "";

    private string AlamatUsaha => Config["Usaha:Alamat"] ?? "";

    private const string JudulLaporan = "Daftar Bahan Baku";

    private async Task Cetak()
    {
        modulCetak ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/cetak.js");
        await modulCetak.InvokeVoidAsync("cetakElemen", "dokumen-cetak", JudulLaporan);
    }
}