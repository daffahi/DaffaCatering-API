@page "/laporan/menu-makanan"
@attribute [Authorize(Roles = AppRoles.AdminPenjualan)]
@implements IAsyncDisposable

@using System.Globalization
@using DaffaCatering.Blazor.Models.MasterMakanan
@using DaffaCatering.Blazor.Services.MasterMakanan
@inject LaporanMenuMakananService LaporanService
@inject IConfiguration Config
@inject IJSRuntime JS

@{
    var tampil = Tampil;
    var hargaMin = tampil.Count == 0 ? 0m : tampil.Min(m => m.Harga);
    var hargaMax = tampil.Count == 0 ? 0m : tampil.Max(m => m.Harga);

    var hasil = tampil;
    var totalHalaman = Math.Max(1, (int)Math.Ceiling(hasil.Count / (double)UkuranHalaman));
    if (halaman > totalHalaman) halaman = totalHalaman;
    var view = hasil.Skip((halaman - 1) * UkuranHalaman).Take(UkuranHalaman).ToList();
    var awal = hasil.Count == 0 ? 0 : (halaman - 1) * UkuranHalaman + 1;
    var akhir = awal == 0 ? 0 : awal + view.Count - 1;
}

<div class="laporan-page">

    @* ================= HEADER HALAMAN ================= *@
    <header class="page-head">
        <div>
            <h1>Laporan Menu Makanan</h1>
            <p>Daftar menu makanan beserta jumlah, satuan, dan harga</p>
        </div>
        <button class="btn-cetak" disabled="@(isLoading || tampil.Count == 0)" @onclick="Cetak">
            <i class="fa-solid fa-print"></i> Cetak
        </button>
    </header>

    @* ================= BANNER ERROR ================= *@
    <NotifBanner @bind-Pesan="PesanError" />

    @* ================= FILTER LAPORAN ================= *@
    <section class="filter-card">
        <label class="search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="Cari kode atau nama menu..."
                   @bind="teksCari" @bind:event="oninput" />
        </label>
    </section>

    @* ================= KARTU RINGKASAN ================= *@
    @if (!isLoading)
    {
        <section class="dashboard-cards">
            <div class="dashboard-card">
                <div class="card-icon"><i class="fa-solid fa-utensils"></i></div>
                <div class="card-content">
                    <div class="card-title">@tampil.Count Menu</div>
                    <div class="card-subtitle">Menu dalam laporan</div>
                </div>
            </div>
            <div class="dashboard-card">
                <div class="card-icon"><i class="fa-solid fa-arrow-down-wide-short"></i></div>
                <div class="card-content">
                    <div class="card-title">@FormatRupiah(hargaMin)</div>
                    <div class="card-subtitle">Harga terendah</div>
                </div>
            </div>
            <div class="dashboard-card">
                <div class="card-icon"><i class="fa-solid fa-arrow-up-wide-short"></i></div>
                <div class="card-content">
                    <div class="card-title">@FormatRupiah(hargaMax)</div>
                    <div class="card-subtitle">Harga tertinggi</div>
                </div>
            </div>
        </section>
    }

    @* ================= TABEL LAPORAN ================= *@
    <section class="panel">

        @if (isLoading)
        {
            <div class="skeleton">
                @for (var s = 0; s < 6; s++)
                {
                    <div class="sk-row">
                        <div class="sk-avatar"></div>
                        <div class="sk-lines"><div></div><div></div></div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Menu</th>
                            <th>Jumlah</th>
                            <th class="num">Harga</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in view)
                        {
                            <tr class="row-trx" @key="m.IdMenu">
                                <td>
                                    <div class="who">
                                        <div class="avatar tone-@Warna(m.NamaMenu)">@Inisial(m.NamaMenu)</div>
                                        <div>
                                            <div class="name">@m.NamaMenu</div>
                                            <div class="sub">@m.IdMenu</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="mono">@FormatAngka(m.Jumlah) @m.NamaSatuan</td>
                                <td class="num mono">@FormatRupiah(m.Harga)</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (tampil.Count == 0)
                {
                    <div class="empty">
                        <i class="fa-regular fa-face-frown-open"></i>
                        <strong>Menu tidak ditemukan</strong>
                        <span>Tidak ada menu yang cocok, coba ubah kata kunci</span>
                    </div>
                }
            </div>

            <div class="panel-foot">
                <span>Menampilkan <b>@awal–@akhir</b> dari <b>@hasil.Count</b> menu makanan</span>

                <div class="pager">
                    @if (halaman > 1)
                    {
                        <button class="pg-btn" @onclick="() => halaman--">
                            <i class="fa-solid fa-chevron-left"></i> Sebelumnya
                        </button>
                    }

                    <span class="pg-info">Halaman <b>@halaman</b> / @totalHalaman</span>

                    @if (halaman < totalHalaman)
                    {
                        <button class="pg-btn" @onclick="() => halaman++">
                            Berikutnya <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    }
                </div>
            </div>
        }
    </section>

    @* ================= 6. DOKUMEN CETAK (tidak tampil di layar) ================= *@
    @if (!isLoading && tampil.Count > 0)
    {
        var nomor = 0;

        <div id="dokumen-cetak" class="doc">

            <header class="doc-kop">
                <img src="images/logo.png" class="doc-logo" alt="" onerror="this.style.display='none'" />
                <div class="doc-judul">
                    <h1>@JudulLaporan</h1>
                    <div class="doc-usaha">@NamaUsaha</div>
                    <div class="doc-alamat">@AlamatUsaha</div>
                </div>
                <div></div>
            </header>

            <hr class="doc-garis" />

            <div class="doc-meta">
                <span>Dicetak oleh: <b>@namaPencetak</b></span>
                <span>Tanggal Cetak: <b>@Tgl(DateOnly.FromDateTime(DateTime.Today))</b></span>
            </div>
            @if (!string.IsNullOrWhiteSpace(teksCari))
            {
                <div class="doc-meta">
                    <span>Pencarian: <b>@teksCari</b></span>
                </div>
            }

            <section class="doc-blok">
                <table class="doc-tabel">
                    <colgroup>
                        <col style="width:44px" />
                        <col style="width:110px" />
                        <col />
                        <col style="width:70px" />
                        <col style="width:90px" />
                        <col style="width:130px" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>No</th>
                            <th>Kode Menu</th>
                            <th>Nama Menu</th>
                            <th>Jumlah</th>
                            <th>Satuan</th>
                            <th>Harga</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in tampil)
                        {
                            <tr>
                                <td class="c">@(++nomor)</td>
                                <td class="c">@m.IdMenu</td>
                                <td>@m.NamaMenu</td>
                                <td class="c">@FormatAngka(m.Jumlah)</td>
                                <td class="c">@m.NamaSatuan</td>
                                <td>@Rp(m.Harga)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        </div>
    }

</div>

@code {
    // =====================================================
    // STATE
    // =====================================================
    private static readonly CultureInfo IdCulture = new("id-ID");

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    // --- data ---
    private List<LaporanMenuMakananModels> data = new();

    // --- halaman ---
    private bool isLoading = true;
    private string errorMaster = "";
    private string errorLaporan = "";
    private string namaPencetak = "";
    private IJSObjectReference? modulCetak;

    // --- pagination & pencarian ---
    private const int UkuranHalaman = 10;
    private int halaman = 1;

    private string _teksCari = "";
    private string teksCari
    {
        get => _teksCari;
        set { _teksCari = value; halaman = 1; }
    }

    // Gabungan error master + laporan; saat banner ditutup (nilai kosong), keduanya dikosongkan
    private string PesanError
    {
        get => string.Join(" ",
            new[] { errorMaster, errorLaporan }.Where(s => !string.IsNullOrEmpty(s)));
        set
        {
            if (!string.IsNullOrEmpty(value)) return;
            errorMaster = "";
            errorLaporan = "";
        }
    }

    // =====================================================
    // LIFECYCLE & MUAT DATA
    // =====================================================
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            namaPencetak = state.User.Identity?.Name ?? "";
        }

        await MuatLaporan();
    }

    public async ValueTask DisposeAsync()
    {
        if (modulCetak is null) return;

        try { await modulCetak.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }

    private async Task MuatLaporan()
    {
        isLoading = true;
        errorLaporan = "";

        try
        {
            var (hasilApi, error) = await LaporanService.AmbilAsync();

            if (hasilApi is null)
            {
                errorLaporan = $"Gagal memuat laporan menu makanan: {error.TrimEnd('.')}";
                data = new();
            }
            else
            {
                data = hasilApi;
            }
        }
        catch (Exception ex)
        {
            errorLaporan = $"Gagal memuat laporan menu makanan: {ex.Message.TrimEnd('.')}.";
            data = new();
        }

        isLoading = false;
    }

    // =====================================================
    // HELPER UMUM (format)
    // =====================================================
    private static string Tgl(DateOnly d) => d.ToString("dd/MM/yyyy", IdCulture);

    private static string FormatAngka(decimal v) => v.ToString("#,##0.##", IdCulture);

    private static string FormatRupiah(decimal v) => v.ToString("C0", IdCulture);

    // "Rp" rata kiri dan angka rata kanan, seperti di Crystal Report
    private RenderFragment Rp(decimal v) => @<div class="rp"><span>Rp</span><span>@FormatAngka(v)</span></div>;

    private static string Inisial(string? nama)
    {
        var p = (nama ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length == 0 ? "?"
             : p.Length == 1 ? p[0][..1].ToUpper()
             : (p[0][..1] + p[^1][..1]).ToUpper();
    }

    // Warna avatar stabil per nama (string.GetHashCode() berubah tiap proses, jadi tidak dipakai)
    private static int Warna(string? nama) => (nama ?? "").Sum(ch => ch) % 5;

    private static bool TryParseTgl(string? teks, out DateOnly hasil)
        => DateOnly.TryParseExact(teks, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out hasil);

    // =====================================================
    // TAMPILAN: PENCARIAN & URUTAN
    // =====================================================
    private bool Cocok(LaporanMenuMakananModels m)
    {
        if (string.IsNullOrWhiteSpace(teksCari)) return true;

        return m.IdMenu.Contains(teksCari, StringComparison.OrdinalIgnoreCase)
            || m.NamaMenu.Contains(teksCari, StringComparison.OrdinalIgnoreCase);
    }

    private List<LaporanMenuMakananModels> Tampil
        => data.Where(Cocok).OrderBy(m => m.IdMenu, StringComparer.Ordinal).ToList();

    // =====================================================
    // DOKUMEN CETAK
    // =====================================================
    private string NamaUsaha => Config["Usaha:Nama"] ?? "";

    private string AlamatUsaha => Config["Usaha:Alamat"] ?? "";

    private const string JudulLaporan = "Daftar Menu";

    private async Task Cetak()
    {
        modulCetak ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/cetak.js");
        await modulCetak.InvokeVoidAsync("cetakElemen", "dokumen-cetak", JudulLaporan);
    }
}