@page "/laporan/pemasok"
@attribute [Authorize(Roles = AppRoles.AdminPembelian)]
@implements IAsyncDisposable

@using System.Globalization
@inject DaftarPemasokService LaporanService
@inject IConfiguration Config
@inject IJSRuntime JS

@{
    var view = Filtered.ToList();
    var jmlAktif = view.Count(p => p.Status);
    var jmlNonaktif = view.Count - jmlAktif;
}

<div class="laporan-page">

    @* ================= 1. HEADER HALAMAN ================= *@
    <header class="page-head">
        <div>
            <h1>Daftar Pemasok</h1>
            <p>Rekap data pemasok beserta status keaktifannya</p>
        </div>
        <button class="btn-add" disabled="@(isLoading || view.Count == 0)" @onclick="Cetak">
            <i class="fa-solid fa-print"></i> Cetak
        </button>
    </header>

    @* ================= 2. BANNER ERROR ================= *@
    @if (!string.IsNullOrEmpty(errorLaporan))
    {
        <div class="banner">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@errorLaporan</span>
            <button class="banner-close" @onclick="() => errorLaporan = string.Empty">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @* ================= 3. TOOLBAR: SEARCH + FILTER ================= *@
    <section class="toolbar-card">
        <label class="search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="Cari ID, Nama, kontak, atau alamat..."
                   @bind="teksCari" @bind:event="oninput" />
        </label>

        <div class="toolbar-right">
            <div class="segmented">
                <button class="@Seg(FilterStatus.Semua)" @onclick="() => filterStatus = FilterStatus.Semua">
                    Semua <span>@data.Count</span>
                </button>
                <button class="@Seg(FilterStatus.Aktif)" @onclick="() => filterStatus = FilterStatus.Aktif">
                    Aktif <span>@JumlahAktif</span>
                </button>
                <button class="@Seg(FilterStatus.NonAktif)" @onclick="() => filterStatus = FilterStatus.NonAktif">
                    Tidak Aktif <span>@(data.Count - JumlahAktif)</span>
                </button>
            </div>
        </div>
    </section>

    @* ================= 4. TABEL PEMASOK ================= *@
    <section class="panel">

        @if (isLoading)
        {
            <div class="skeleton">
                @for (var s = 0; s < 6; s++)
                {
                    <div class="sk-row">
                        <div class="sk-avatar"></div>
                        <div class="sk-lines"><div></div><div></div></div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Pemasok</th>
                            <th>Kontak</th>
                            <th class="col-addr">Alamat</th>
                            <th class="col-date">Bergabung</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (item, i) in view.Select((item, i) => (item, i)))
                        {
                            <tr @key="item.IdPemasok" style="--i:@Math.Min(i, 12)">
                                <td>
                                    <div class="who">
                                        <div class="avatar tone-@Warna(item.NamaPemasok)">@Inisial(item.NamaPemasok)</div>
                                        <div>
                                            <div class="name">@item.NamaPemasok</div>
                                            <div class="sub">@item.IdPemasok</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="mono">@Kosong(item.NoKontak)</td>
                                <td class="col-addr muted">@Kosong(item.Alamat)</td>
                                <td class="col-date muted">@($"{item.TglBergabung:dd MMM yyyy}")</td>
                                <td>
                                    <span class="pill @(item.Status ? "on" : "off")">
                                        <i></i>@LabelStatus(item.Status)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (view.Count == 0)
                {
                    <div class="empty">
                        <i class="fa-regular fa-face-frown-open"></i>
                        <strong>Pemasok tidak ditemukan</strong>
                        <span>Coba ubah kata kunci atau filter status.</span>
                    </div>
                }
            </div>

            <div class="panel-foot">
                Menampilkan <b>@view.Count</b> dari <b>@data.Count</b> pemasok
            </div>
        }
    </section>

    @* ================= 5. DOKUMEN CETAK (tidak tampil di layar) ================= *@
    @if (!isLoading && view.Count > 0)
    {
        <div id="dokumen-cetak" class="doc">

            <header class="doc-kop">
                <img src="images/logo.png" class="doc-logo" alt="" onerror="this.style.display='none'" />
                <div class="doc-judul">
                    <h1>Daftar Pemasok</h1>
                    <div class="doc-usaha">@NamaUsaha</div>
                    <div class="doc-alamat">@AlamatUsaha</div>
                </div>
                <div></div>
            </header>

            <hr class="doc-garis" />

            <div class="doc-meta">
                <span>Dicetak oleh: <b>@namaPencetak</b></span>
                <span>Tanggal Cetak: <b>@Tgl(DateOnly.FromDateTime(DateTime.Today))</b></span>
            </div>

            @if (filterStatus != FilterStatus.Semua || !string.IsNullOrWhiteSpace(teksCari))
            {
                <div class="doc-meta">
                    <span>
                        @if (filterStatus != FilterStatus.Semua)
                        {
                            <text>Status: <b>@LabelFilter(filterStatus)</b></text>
                        }
                        @if (!string.IsNullOrWhiteSpace(teksCari))
                        {
                            <text>@(filterStatus != FilterStatus.Semua ? " | " : "")Pencarian: <b>@teksCari</b></text>
                        }
                    </span>
                </div>
            }

            @{
                var nomor = 0;
            }
            <section class="doc-blok">
                <table class="doc-tabel">
                    <colgroup>
                        <col style="width:36px" />
                        <col style="width:90px" />
                        <col style="width:130px" />
                        <col style="width:105px" />
                        <col />
                        <col style="width:72px" />
                        <col style="width:60px" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Kode Pemasok</th>
                            <th>Nama Pemasok</th>
                            <th>Nomor Kontak</th>
                            <th>Alamat</th>
                            <th>Tanggal<br />Bergabung</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in view)
                        {
                            <tr>
                                <td class="c">@(++nomor)</td>
                                <td class="c">@item.IdPemasok</td>
                                <td>@item.NamaPemasok</td>
                                <td class="c">@Kosong(item.NoKontak)</td>
                                <td>@Kosong(item.Alamat)</td>
                                <td class="c" style="white-space:nowrap">@Tgl(item.TglBergabung)</td>
                                <td class="c">@LabelStatus(item.Status)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        </div>
    }

</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private static readonly CultureInfo IdCulture = new("id-ID");

    private List<DaftarPemasokModels> data = new();
    private bool isLoading = true;
    private string errorLaporan = "";
    private string namaPencetak = "";
    private IJSObjectReference? modulCetak;

    // --- filter & pencarian ---
    private enum FilterStatus { Semua, Aktif, NonAktif }

    private string teksCari = "";
    private FilterStatus filterStatus = FilterStatus.Semua;

    private int JumlahAktif => data.Count(c => c.Status);

    private IEnumerable<DaftarPemasokModels> Filtered => data
        .Where(c => filterStatus switch
        {
            FilterStatus.Aktif => c.Status,
            FilterStatus.NonAktif => !c.Status,
            _ => true
        })
        .Where(c => string.IsNullOrWhiteSpace(teksCari)
            || (c.IdPemasok ?? "").Contains(teksCari, StringComparison.OrdinalIgnoreCase)
            || (c.NamaPemasok ?? "").Contains(teksCari, StringComparison.OrdinalIgnoreCase)
            || (c.NoKontak ?? "").Contains(teksCari, StringComparison.OrdinalIgnoreCase)
            || (c.Alamat ?? "").Contains(teksCari, StringComparison.OrdinalIgnoreCase));

    private string Seg(FilterStatus f) => filterStatus == f ? "seg active" : "seg";

    private static string LabelFilter(FilterStatus f) => f switch
    {
        FilterStatus.Aktif => "Aktif",
        FilterStatus.NonAktif => "Tidak Aktif",
        _ => "Semua"
    };

    // --- helper tampilan ---
    private static string Inisial(string? nama)
    {
        var p = (nama ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length == 0 ? "?"
             : p.Length == 1 ? p[0][..1].ToUpper()
             : (p[0][..1] + p[^1][..1]).ToUpper();
    }

    // Warna avatar stabil per nama (string.GetHashCode() berubah tiap proses, jadi tidak dipakai)
    private static int Warna(string? nama) => (nama ?? "").Sum(ch => ch) % 5;

    private static string Tgl(DateOnly d) => d.ToString("dd/MM/yyyy", IdCulture);

    private static string Kosong(string? s) => string.IsNullOrWhiteSpace(s) ? "-" : s;

    private static string LabelStatus(bool aktif) => aktif ? "Aktif" : "Tidak Aktif";

    // --- lifecycle & muat data ---
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            namaPencetak = state.User.Identity?.Name ?? "";
        }

        await MuatData();
    }

    public async ValueTask DisposeAsync()
    {
        if (modulCetak is null) return;

        try { await modulCetak.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }

    private async Task MuatData()
    {
        isLoading = true;
        errorLaporan = "";

        try
        {
            // dimuat semua sekali, filter ditangani di sisi klien
            var (hasilApi, error) = await LaporanService.AmbilAsync("semua");

            if (hasilApi is null)
            {
                errorLaporan = "Gagal memuat laporan: " + error;
                data = new();
            }
            else
            {
                data = hasilApi;
            }
        }
        catch (Exception ex)
        {
            errorLaporan = "Gagal memuat laporan: " + ex.Message;
            data = new();
        }

        isLoading = false;
    }

    // --- dokumen cetak ---
    private string NamaUsaha => Config["Usaha:Nama"] ?? "";

    private string AlamatUsaha => Config["Usaha:Alamat"] ?? "";

    // Judul ini juga menjadi nama file bawaan saat disimpan sebagai PDF
    private string JudulDokumen => $"Daftar Pemasok {DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}";

    private async Task Cetak()
    {
        modulCetak ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/cetak.js");
        await modulCetak.InvokeVoidAsync("cetakElemen", "dokumen-cetak", JudulDokumen);
    }
}