@page "/laporan/persediaan"
@attribute [Authorize(Roles = AppRoles.AdminPersediaan)]
@implements IAsyncDisposable

@using System.Globalization
@using DaffaCatering.Blazor.Models.Persediaan
@using DaffaCatering.Blazor.Services.Persediaan
@inject LaporanStokBahanBakuService LaporanService
@inject BahanBakuService BahanBakuService
@inject SatuanBahanBakuService SatuanBahanBakuService
@inject IConfiguration Config
@inject IJSRuntime JS

@{
    var tampil = Tampil;
    var stok = jenis == JenisLaporan.Stok;
    var kdl = jenis == JenisLaporan.Kadaluwarsa;
    var pakai = jenis == JenisLaporan.Penggunaan;
    var sesuai = jenis == JenisLaporan.Penyesuaian;
    var semuaBaris = tampil.SelectMany(g => g.Baris).ToList();
    var jmlTransaksi = semuaBaris.Select(b => b.IdTransaksi).Distinct().Count();
    var jmlHabis = tampil.Count(g => g.StokAkhir <= 0);
    var jmlSudahKdl = semuaBaris.Count(b => b.SisaHari < 0);
    var jmlKolom = stok ? 6 : kdl ? 5 : 4;
}

<div class="laporan-page">

    @* ================= 1. HEADER HALAMAN ================= *@
    <header class="page-head">
        <div>
            <h1>Laporan Persediaan</h1>
            <p>Rekap stok, kadaluwarsa, penggunaan, dan penyesuaian bahan baku</p>
        </div>
        <button class="btn-cetak" disabled="@(isLoading || tampil.Count == 0)" @onclick="Cetak">
            <i class="fa-solid fa-print"></i> Cetak
        </button>
    </header>

    @* ================= 2. BANNER ERROR ================= *@
    @if (!string.IsNullOrEmpty(PesanError))
    {
        <div class="banner">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@PesanError</span>
            <button class="banner-close" @onclick="TutupError">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @* ================= 3. FILTER LAPORAN ================= *@
    <section class="filter-card">
        <div class="filter-row">

            <div class="fg">
                <span class="fl">Jenis</span>
                <div class="segmented">
                    <button class="@Seg(stok)" @onclick="() => PilihJenis(JenisLaporan.Stok)">Stok</button>
                    <button class="@Seg(kdl)" @onclick="() => PilihJenis(JenisLaporan.Kadaluwarsa)">Kadaluwarsa</button>
                    <button class="@Seg(pakai)" @onclick="() => PilihJenis(JenisLaporan.Penggunaan)">Penggunaan</button>
                    <button class="@Seg(sesuai)" @onclick="() => PilihJenis(JenisLaporan.Penyesuaian)">Penyesuaian</button>
                </div>
            </div>

            @if (kdl)
            {
                <div class="fg">
                    <span class="fl">Status</span>
                    <div class="segmented">
                        <button class="@Seg(statusKdl == StatusKadaluwarsa.Sudah)" @onclick="() => PilihStatusKdl(StatusKadaluwarsa.Sudah)">Sudah Kadaluwarsa</button>
                        <button class="@Seg(statusKdl == StatusKadaluwarsa.TujuhHari)" @onclick="() => PilihStatusKdl(StatusKadaluwarsa.TujuhHari)">7 Hari</button>
                        <button class="@Seg(statusKdl == StatusKadaluwarsa.TigaPuluhHari)" @onclick="() => PilihStatusKdl(StatusKadaluwarsa.TigaPuluhHari)">30 Hari</button>
                    </div>
                </div>
            }
            else
            {
                <div class="fg">
                    <span class="fl">Periode</span>
                    <div class="segmented">
                        @if (stok)
                        {
                            <button class="@Seg(preset == PresetPeriode.Semua)" @onclick="() => PilihPreset(PresetPeriode.Semua)">Semua</button>
                        }
                        <button class="@Seg(preset == PresetPeriode.HariIni)" @onclick="() => PilihPreset(PresetPeriode.HariIni)">Hari Ini</button>
                        <button class="@Seg(preset == PresetPeriode.TujuhHari)" @onclick="() => PilihPreset(PresetPeriode.TujuhHari)">7 Hari</button>
                        <button class="@Seg(preset == PresetPeriode.BulanIni)" @onclick="() => PilihPreset(PresetPeriode.BulanIni)">Bulan Ini</button>
                    </div>
                </div>

                <label class="fg">
                    <span class="fl">Dari</span>
                    <input type="date" value="@Iso(dari)" max="@Iso(sampai)"
                           disabled="@(preset == PresetPeriode.Semua)" @onchange="UbahDari" />
                </label>

                <label class="fg">
                    <span class="fl">Sampai</span>
                    <input type="date" value="@Iso(sampai)" min="@Iso(dari)"
                           disabled="@(preset == PresetPeriode.Semua)" @onchange="UbahSampai" />
                </label>
            }
        </div>

        <label class="search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="Cari kode atau nama bahan baku..."
                   @bind="teksCari" @bind:event="oninput" />
        </label>
    </section>

    @* ================= 4. KARTU RINGKASAN ================= *@
    @if (!isLoading)
    {
        <section class="dashboard-cards">
            <div class="dashboard-card">
                <div class="card-icon"><i class="fa-solid fa-wheat-awn"></i></div>
                <div class="card-content">
                    <div class="card-title">@tampil.Count Bahan Baku</div>
                    <div class="card-subtitle">@(stok ? "Bahan baku dalam laporan" : kdl ? "Bahan baku terdampak" : pakai ? "Bahan baku terpakai" : "Bahan baku disesuaikan")</div>
                </div>
            </div>

            @if (stok)
            {
                <div class="dashboard-card">
                    <div class="card-icon"><i class="fa-solid fa-right-left"></i></div>
                    <div class="card-content">
                        <div class="card-title">@semuaBaris.Count Mutasi</div>
                        <div class="card-subtitle">Transaksi masuk dan keluar</div>
                    </div>
                </div>
                <div class="dashboard-card">
                    <div class="card-icon"><i class="fa-solid fa-box-open"></i></div>
                    <div class="card-content">
                        <div class="card-title">@jmlHabis Bahan Baku</div>
                        <div class="card-subtitle">Stok habis</div>
                    </div>
                </div>
            }
            else if (kdl)
            {
                <div class="dashboard-card">
                    <div class="card-icon"><i class="fa-solid fa-boxes-stacked"></i></div>
                    <div class="card-content">
                        <div class="card-title">@semuaBaris.Count Batch</div>
                        <div class="card-subtitle">Batch bahan baku</div>
                    </div>
                </div>
                <div class="dashboard-card">
                    <div class="card-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
                    <div class="card-content">
                        <div class="card-title">@jmlSudahKdl Batch</div>
                        <div class="card-subtitle">Sudah kadaluwarsa</div>
                    </div>
                </div>
            }
            else
            {
                <div class="dashboard-card">
                    <div class="card-icon"><i class="fa-solid fa-receipt"></i></div>
                    <div class="card-content">
                        <div class="card-title">@jmlTransaksi Transaksi</div>
                        <div class="card-subtitle">@(pakai ? "Jumlah penggunaan" : "Jumlah penyesuaian")</div>
                    </div>
                </div>
                <div class="dashboard-card">
                    <div class="card-icon"><i class="fa-solid fa-list-check"></i></div>
                    <div class="card-content">
                        <div class="card-title">@semuaBaris.Count Item</div>
                        <div class="card-subtitle">Baris bahan baku</div>
                    </div>
                </div>
            }
        </section>
    }

    @* ================= 5. TABEL LAPORAN ================= *@
    <section class="panel">

        @if (isLoading)
        {
            <div class="skeleton">
                @for (var s = 0; s < 6; s++)
                {
                    <div class="sk-row">
                        <div class="sk-avatar"></div>
                        <div class="sk-lines"><div></div><div></div></div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        @if (stok)
                        {
                            <tr>
                                <th>Bahan Baku</th>
                                <th class="num">Stok Awal</th>
                                <th class="num">Total Masuk</th>
                                <th class="num">Total Keluar</th>
                                <th class="num">Stok Akhir</th>
                                <th class="actions">Detail</th>
                            </tr>
                        }
                        else if (kdl)
                        {
                            <tr>
                                <th>Bahan Baku</th>
                                <th class="num">Jumlah Batch</th>
                                <th class="num">Total Sisa Stok</th>
                                <th>Kadaluwarsa Terdekat</th>
                                <th class="actions">Detail</th>
                            </tr>
                        }
                        else if (pakai)
                        {
                            <tr>
                                <th>Bahan Baku</th>
                                <th class="num">Jumlah Transaksi</th>
                                <th class="num">Total Digunakan</th>
                                <th class="actions">Detail</th>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <th>Bahan Baku</th>
                                <th class="num">Jumlah Penyesuaian</th>
                                <th class="num">Total Selisih</th>
                                <th class="actions">Detail</th>
                            </tr>
                        }
                    </thead>

                    <tbody>
                        @foreach (var g in tampil)
                        {
                            var nama = NamaBahanBaku(g.Id);
                            var satuan = NamaSatuan(g.IdSatuan);
                            var terbuka = expandedId == g.Id;
                            var jmlTrx = g.Baris.Select(x => x.IdTransaksi).Distinct().Count();
                            var totalJumlah = g.Baris.Sum(x => x.Jumlah);
                            var totalSelisih = g.Baris.Sum(x => x.Selisih);
                            int? terdekat = g.Baris.Min(x => x.SisaHari);

                            <tr class="usage-row" @key="g.Id" @onclick="() => ToggleDetail(g.Id)">
                                <td>
                                    <div class="who">
                                        <div class="avatar tone-@Warna(nama)">@Inisial(nama)</div>
                                        <div>
                                            <div class="name">@nama</div>
                                            <div class="sub">@g.Id - @satuan</div>
                                        </div>
                                    </div>
                                </td>

                                @if (stok)
                                {
                                    <td class="num mono">@FormatAngka(g.StokAwal)</td>
                                    <td class="num mono">@FormatAngka(g.TotalMasuk)</td>
                                    <td class="num mono">@FormatAngka(g.TotalKeluar)</td>
                                    <td class="num usage-total">@FormatAngka(g.StokAkhir)</td>
                                }
                                else if (kdl)
                                {
                                    <td class="num mono">@g.Baris.Count batch</td>
                                    <td class="num usage-total">@FormatAngka(totalJumlah) @satuan</td>
                                    <td>
                                        <span class="pill @KelasKdl(terdekat)"><i></i>@LabelKdl(terdekat)</span>
                                    </td>
                                }
                                else if (pakai)
                                {
                                    <td class="num mono">@jmlTrx transaksi</td>
                                    <td class="num usage-total">@FormatAngka(totalJumlah) @satuan</td>
                                }
                                else
                                {
                                    <td class="num mono">@jmlTrx penyesuaian</td>
                                    <td class="num usage-total">@(totalSelisih > 0 ? "+" : "")@FormatAngka(totalSelisih) @satuan</td>
                                }

                                <td class="actions">
                                    <button type="button" class="usage-chevron @(terbuka ? "open" : "")" title="Lihat detail">
                                        <i class="fa-solid fa-chevron-down"></i>
                                    </button>
                                </td>
                            </tr>

                            @if (terbuka)
                            {
                                <tr class="usage-detail-row">
                                    <td colspan="@jmlKolom">
                                        <div class="usage-detail">
                                            <table class="usage-detail-table">
                                                @if (stok)
                                                {
                                                    <thead>
                                                        <tr>
                                                            <th>Tgl Transaksi</th>
                                                            <th>Keterangan</th>
                                                            <th class="num">Qty Masuk</th>
                                                            <th class="num">Qty Keluar</th>
                                                            <th class="num">Sisa Stok</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr class="row-awal">
                                                            <td></td>
                                                            <td>Stok Awal</td>
                                                            <td></td>
                                                            <td></td>
                                                            <td class="num mono">@FormatAngka(g.StokAwal)</td>
                                                        </tr>
                                                        @foreach (var b in g.Baris)
                                                        {
                                                            <tr>
                                                                <td class="mono">@Tgl(b.Tanggal)</td>
                                                                <td>@b.Keterangan</td>
                                                                <td class="num mono">@FormatAngka(b.QtyMasuk)</td>
                                                                <td class="num mono">@FormatAngka(b.QtyKeluar)</td>
                                                                <td class="num mono">@FormatAngka(b.SisaStok)</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                }
                                                else if (kdl)
                                                {
                                                    <thead>
                                                        <tr>
                                                            <th>No. Penerimaan</th>
                                                            <th>Tgl Kadaluwarsa</th>
                                                            <th class="num">Sisa Stok</th>
                                                            <th>Status</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var b in g.Baris)
                                                        {
                                                            <tr>
                                                                <td class="mono">@b.IdTransaksi</td>
                                                                <td>@Tgl(b.TglKadaluwarsa)</td>
                                                                <td class="num mono">@FormatAngka(b.Jumlah) @satuan</td>
                                                                <td>
                                                                    <span class="pill @KelasKdl(b.SisaHari)"><i></i>@LabelKdl(b.SisaHari)</span>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                }
                                                else if (pakai)
                                                {
                                                    <thead>
                                                        <tr>
                                                            <th>Tanggal</th>
                                                            <th>No. Penggunaan</th>
                                                            <th class="num">Jumlah</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var b in g.Baris)
                                                        {
                                                            <tr>
                                                                <td>@Tgl(b.Tanggal)</td>
                                                                <td class="mono">@b.IdTransaksi</td>
                                                                <td class="num mono">@FormatAngka(b.Jumlah) @satuan</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                }
                                                else
                                                {
                                                    <thead>
                                                        <tr>
                                                            <th>Tanggal</th>
                                                            <th>No. Penyesuaian</th>
                                                            <th class="num">Selisih</th>
                                                            <th>Alasan</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var b in g.Baris)
                                                        {
                                                            <tr>
                                                                <td>@Tgl(b.Tanggal)</td>
                                                                <td class="mono">@b.IdTransaksi</td>
                                                                <td class="num mono">@(b.Selisih > 0 ? "+" : "")@FormatAngka(b.Selisih) @satuan</td>
                                                                <td>@(string.IsNullOrWhiteSpace(b.Alasan) ? "-" : b.Alasan)</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                }
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                @if (tampil.Count == 0)
                {
                    <div class="empty">
                        <i class="fa-regular fa-face-frown-open"></i>
                        @if (BelumSiap)
                        {
                            <strong>Laporan ini belum tersedia</strong>
                            <span>Laporan @LabelJenis sedang dalam pengerjaan</span>
                        }
                        else
                        {
                            <strong>Data laporan tidak ditemukan</strong>
                            <span>Tidak ada data @LabelJenis pada pilihan ini, coba ubah filter atau kata kunci</span>
                        }
                    </div>
                }
            </div>

            <div class="panel-foot">
                <span>Menampilkan <b>@tampil.Count</b> bahan baku dengan <b>@semuaBaris.Count</b> baris</span>
            </div>
        }
    </section>

    @* ================= 6. DOKUMEN CETAK (tidak tampil di layar) ================= *@
    @if (!isLoading && tampil.Count > 0)
    {
        <div id="dokumen-cetak" class="doc">

            <header class="doc-kop">
                <img src="images/logo.png" class="doc-logo" alt="" onerror="this.style.display='none'" />
                <div class="doc-judul">
                    <h1>@JudulLaporan</h1>
                    <div class="doc-usaha">@NamaUsaha</div>
                    <div class="doc-alamat">@AlamatUsaha</div>
                </div>
                <div></div>
            </header>

            <hr class="doc-garis" />

            <div class="doc-meta">
                <span>Dicetak oleh: <b>@namaPencetak</b></span>
                <span>Tanggal Cetak: <b>@Tgl(DateOnly.FromDateTime(DateTime.Today))</b></span>
            </div>
            <div class="doc-meta">
                <span>
                    @TeksFilterCetak
                    @if (!string.IsNullOrWhiteSpace(teksCari))
                    {
                        <text> | Pencarian: <b>@teksCari</b></text>
                    }
                </span>
            </div>

            @foreach (var g in tampil)
            {
                var nomor = 0;
                var satuan = NamaSatuan(g.IdSatuan);

                <section class="doc-blok">
                    <table class="doc-info">
                        <tr>
                            <th>Kode Bahan Baku</th>
                            <td class="sep">:</td>
                            <td>@g.Id</td>
                        </tr>
                        <tr>
                            <th>Nama Bahan Baku</th>
                            <td class="sep">:</td>
                            <td>@NamaBahanBaku(g.Id)</td>
                        </tr>
                        <tr>
                            <th>Satuan</th>
                            <td class="sep">:</td>
                            <td>@satuan</td>
                        </tr>
                    </table>

                    @if (stok)
                    {
                        <table class="doc-tabel">
                            <colgroup>
                                <col style="width:110px" />
                                <col />
                                <col style="width:100px" />
                                <col style="width:100px" />
                                <col style="width:100px" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Tgl Transaksi</th>
                                    <th>Keterangan</th>
                                    <th>Qty Masuk</th>
                                    <th>Qty Keluar</th>
                                    <th>Sisa Stok</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td></td>
                                    <td><b>Stok Awal</b></td>
                                    <td></td>
                                    <td></td>
                                    <td class="c">@FormatAngka(g.StokAwal)</td>
                                </tr>
                                @foreach (var b in g.Baris)
                                {
                                    <tr>
                                        <td class="c">@Tgl(b.Tanggal)</td>
                                        <td>@b.Keterangan</td>
                                        <td class="c">@FormatAngka(b.QtyMasuk)</td>
                                        <td class="c">@FormatAngka(b.QtyKeluar)</td>
                                        <td class="c">@FormatAngka(b.SisaStok)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else if (kdl)
                    {
                        <table class="doc-tabel">
                            <colgroup>
                                <col style="width:44px" />
                                <col style="width:130px" />
                                <col style="width:120px" />
                                <col style="width:110px" />
                                <col />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>No. Penerimaan</th>
                                    <th>Tgl Kadaluwarsa</th>
                                    <th>Sisa Stok</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in g.Baris)
                                {
                                    <tr>
                                        <td class="c">@(++nomor)</td>
                                        <td class="c">@b.IdTransaksi</td>
                                        <td class="c">@Tgl(b.TglKadaluwarsa)</td>
                                        <td class="c">@FormatAngka(b.Jumlah)</td>
                                        <td class="c">@LabelKdl(b.SisaHari)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else if (pakai)
                    {
                        <table class="doc-tabel">
                            <colgroup>
                                <col style="width:44px" />
                                <col style="width:110px" />
                                <col />
                                <col style="width:110px" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>Tanggal</th>
                                    <th>No. Penggunaan</th>
                                    <th>Jumlah</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in g.Baris)
                                {
                                    <tr>
                                        <td class="c">@(++nomor)</td>
                                        <td class="c">@Tgl(b.Tanggal)</td>
                                        <td class="c">@b.IdTransaksi</td>
                                        <td class="c">@FormatAngka(b.Jumlah)</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="r"><b>Total</b></td>
                                    <td class="c">@FormatAngka(g.Baris.Sum(x => x.Jumlah))</td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                    else
                    {
                        <table class="doc-tabel">
                            <colgroup>
                                <col style="width:44px" />
                                <col style="width:110px" />
                                <col style="width:130px" />
                                <col style="width:90px" />
                                <col />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>Tanggal</th>
                                    <th>No. Penyesuaian</th>
                                    <th>Selisih</th>
                                    <th>Alasan</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in g.Baris)
                                {
                                    <tr>
                                        <td class="c">@(++nomor)</td>
                                        <td class="c">@Tgl(b.Tanggal)</td>
                                        <td class="c">@b.IdTransaksi</td>
                                        <td class="c">@(b.Selisih > 0 ? "+" : "")@FormatAngka(b.Selisih)</td>
                                        <td>@(string.IsNullOrWhiteSpace(b.Alasan) ? "-" : b.Alasan)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>
            }
        </div>
    }

</div>

@code {
    // =====================================================
    // 1. STATE
    // =====================================================
    private static readonly CultureInfo IdCulture = new("id-ID");

    private enum JenisLaporan { Stok, Kadaluwarsa, Penggunaan, Penyesuaian }
    private enum PresetPeriode { Semua, HariIni, TujuhHari, BulanIni, Kustom }
    private enum StatusKadaluwarsa { Sudah, TujuhHari, TigaPuluhHari }

    // Jenis yang backend-nya sudah dibuat. Tambahkan jenis baru di sini setiap endpoint-nya selesai
    private static readonly HashSet<JenisLaporan> JenisSiap = new() { JenisLaporan.Stok };

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    // --- data ---
    private List<LaporanStokBahanBakuKelompok> data = new();
    private List<BahanBakuModels> daftarBahanBaku = new();
    private List<SatuanBahanBakuModels> daftarSatuan = new();

    // --- halaman ---
    private bool isLoading = true;
    private string errorMaster = "";
    private string errorLaporan = "";
    private string teksCari = "";
    private string namaPencetak = "";
    private int permintaanKe;
    private IJSObjectReference? modulCetak;
    private string? expandedId;

    // --- filter ---
    private JenisLaporan jenis = JenisLaporan.Stok;
    private StatusKadaluwarsa statusKdl = StatusKadaluwarsa.Sudah;
    private PresetPeriode preset = PresetPeriode.Semua;
    private DateOnly dari;
    private DateOnly sampai;

    private bool BelumSiap => !JenisSiap.Contains(jenis);

    private string PesanError => string.Join(" ",
        new[] { errorMaster, errorLaporan }.Where(s => !string.IsNullOrEmpty(s)));

    private void TutupError()
    {
        errorMaster = "";
        errorLaporan = "";
    }

    // =====================================================
    // 2. LIFECYCLE & MUAT DATA
    // =====================================================
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            namaPencetak = state.User.Identity?.Name ?? "";
        }

        AturPreset(PresetPeriode.Semua);
        await MuatMaster();
        await MuatLaporan();
    }

    public async ValueTask DisposeAsync()
    {
        if (modulCetak is null) return;

        try { await modulCetak.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }

    // Master dipakai untuk menampilkan nama dari kode
    private async Task MuatMaster()
    {
        var galat = new List<string>();

        try { daftarBahanBaku = await BahanBakuService.GetAllAsync(); }
        catch (Exception ex) { galat.Add("Gagal memuat bahan baku: " + ex.Message); }

        try { daftarSatuan = await SatuanBahanBakuService.GetAllAsync(); }
        catch (Exception ex) { galat.Add("Gagal memuat satuan: " + ex.Message); }

        errorMaster = string.Join(" ", galat);
    }

    private async Task MuatLaporan()
    {
        // permintaan lama yang masih berjalan dibatalkan hasilnya
        var permintaan = ++permintaanKe;
        errorLaporan = "";

        // jenis yang backend-nya belum dibuat tidak memanggil API
        if (BelumSiap)
        {
            data = new();
            isLoading = false;
            return;
        }

        if (preset != PresetPeriode.Semua && dari > sampai)
        {
            errorLaporan = "Tanggal awal tidak boleh lebih besar dari tanggal akhir";
            data = new();
            isLoading = false;
            return;
        }

        isLoading = true;

        try
        {
            var semua = preset == PresetPeriode.Semua || jenis == JenisLaporan.Kadaluwarsa;

            var (hasilApi, error) = await LaporanService.AmbilAsync(
                jenis.ToString().ToLowerInvariant(),
                semua ? null : dari,
                semua ? null : sampai,
                jenis == JenisLaporan.Kadaluwarsa ? KodeStatusKdl : null);

            if (permintaan != permintaanKe) return;

            if (hasilApi is null)
            {
                errorLaporan = "Gagal memuat laporan: " + error;
                data = new();
            }
            else
            {
                data = hasilApi;
            }
        }
        catch (Exception ex)
        {
            if (permintaan != permintaanKe) return;
            errorLaporan = "Gagal memuat laporan: " + ex.Message;
            data = new();
        }

        isLoading = false;
    }

    // =====================================================
    // 3. HELPER UMUM (format & lookup nama)
    // =====================================================
    private static string Iso(DateOnly d) => d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private static string Tgl(DateOnly? d) => d is null ? "-" : d.Value.ToString("dd/MM/yyyy", IdCulture);

    private static string FormatAngka(decimal v) => v.ToString("#,##0.##", IdCulture);

    private static string Seg(bool aktif) => aktif ? "seg active" : "seg";

    private static string Inisial(string? nama)
    {
        var p = (nama ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length == 0 ? "?"
             : p.Length == 1 ? p[0][..1].ToUpper()
             : (p[0][..1] + p[^1][..1]).ToUpper();
    }

    // Warna avatar stabil per nama (string.GetHashCode() berubah tiap proses, jadi tidak dipakai)
    private static int Warna(string? nama) => (nama ?? "").Sum(ch => ch) % 5;

    private string NamaBahanBaku(string? id)
        => daftarBahanBaku.FirstOrDefault(b => b.IdBahanBaku == id)?.NamaBahanBaku ?? (id ?? "-");

    private string NamaSatuan(string? id)
        => daftarSatuan.FirstOrDefault(s => s.IdSatuan == id)?.NamaSatuan ?? (id ?? "-");

    // Status kadaluwarsa: sisa hari negatif = sudah lewat
    private static string KelasKdl(int? sisaHari)
        => sisaHari is null ? "closed" : sisaHari < 0 ? "danger" : sisaHari <= 7 ? "pending" : "closed";

    private static string LabelKdl(int? sisaHari)
        => sisaHari is null ? "-"
         : sisaHari < 0 ? $"Lewat {-sisaHari} hari"
         : sisaHari == 0 ? "Hari ini"
         : $"{sisaHari} hari lagi";

    private string LabelJenis => jenis switch
    {
        JenisLaporan.Stok => "stok bahan baku",
        JenisLaporan.Kadaluwarsa => "bahan baku kadaluwarsa",
        JenisLaporan.Penggunaan => "penggunaan bahan baku",
        _ => "penyesuaian bahan baku"
    };

    private string KodeStatusKdl => statusKdl switch
    {
        StatusKadaluwarsa.Sudah => "sudah",
        StatusKadaluwarsa.TujuhHari => "7hari",
        _ => "30hari"
    };

    // =====================================================
    // 4. TAMPILAN: PENCARIAN & URUTAN
    // =====================================================
    private bool Cocok(LaporanStokBahanBakuKelompok g)
    {
        if (string.IsNullOrWhiteSpace(teksCari)) return true;

        return g.Id.Contains(teksCari, StringComparison.OrdinalIgnoreCase)
            || NamaBahanBaku(g.Id).Contains(teksCari, StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleDetail(string id)
    {
        expandedId = expandedId == id ? null : id;
    }

    private List<LaporanStokBahanBakuKelompok> Tampil
        => data.Where(Cocok).OrderBy(g => g.Id, StringComparer.Ordinal).ToList();

    // =====================================================
    // 5. FILTER: PERIODE & PILIHAN
    // =====================================================
    private void AturPreset(PresetPeriode p)
    {
        var hariIni = DateOnly.FromDateTime(DateTime.Today);
        preset = p;

        switch (p)
        {
            case PresetPeriode.Semua:
            case PresetPeriode.HariIni:
                dari = hariIni;
                sampai = hariIni;
                break;
            case PresetPeriode.TujuhHari:
                dari = hariIni.AddDays(-6);
                sampai = hariIni;
                break;
            case PresetPeriode.BulanIni:
                dari = new DateOnly(hariIni.Year, hariIni.Month, 1);
                sampai = hariIni;
                break;
        }
    }

    private async Task PilihPreset(PresetPeriode p)
    {
        AturPreset(p);
        await MuatLaporan();
    }

    private async Task PilihJenis(JenisLaporan j)
    {
        if (jenis == j) return;

        jenis = j;
        teksCari = "";
        expandedId = null;

        // "Semua" periode hanya ada di laporan stok
        if (j != JenisLaporan.Stok && preset == PresetPeriode.Semua)
            AturPreset(PresetPeriode.TujuhHari);

        await MuatLaporan();
    }

    private async Task PilihStatusKdl(StatusKadaluwarsa s)
    {
        if (statusKdl == s) return;

        statusKdl = s;
        await MuatLaporan();
    }

    private async Task UbahDari(ChangeEventArgs e)
    {
        if (!DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var tgl)) return;

        dari = tgl;
        preset = PresetPeriode.Kustom;
        await MuatLaporan();
    }

    private async Task UbahSampai(ChangeEventArgs e)
    {
        if (!DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var tgl)) return;

        sampai = tgl;
        preset = PresetPeriode.Kustom;
        await MuatLaporan();
    }

    // =====================================================
    // 6. DOKUMEN CETAK
    // =====================================================
    private string NamaUsaha => Config["Usaha:Nama"] ?? "";

    private string AlamatUsaha => Config["Usaha:Alamat"] ?? "";

    private string JudulLaporan => jenis switch
    {
        JenisLaporan.Stok => "Laporan Stok Bahan Baku",
        JenisLaporan.Kadaluwarsa => "Laporan Bahan Baku Kadaluwarsa",
        JenisLaporan.Penggunaan => "Laporan Penggunaan Bahan Baku",
        _ => "Laporan Penyesuaian Bahan Baku"
    };

    // Keterangan filter di bawah kop dokumen
    private MarkupString TeksFilterCetak
    {
        get
        {
            if (jenis == JenisLaporan.Kadaluwarsa)
            {
                var status = statusKdl switch
                {
                    StatusKadaluwarsa.Sudah => "Sudah kadaluwarsa",
                    StatusKadaluwarsa.TujuhHari => "Kadaluwarsa dalam 7 hari",
                    _ => "Kadaluwarsa dalam 30 hari"
                };
                return new MarkupString($"Status: <b>{status}</b>");
            }

            if (preset == PresetPeriode.Semua)
                return new MarkupString("Periode: <b>Semua</b>");

            return dari == sampai
                ? new MarkupString($"Tanggal Transaksi: <b>{Tgl(dari)}</b>")
                : new MarkupString($"Tanggal Transaksi: <b>{Tgl(dari)} s/d {Tgl(sampai)}</b>");
        }
    }

    // Judul ini juga menjadi nama file bawaan saat disimpan sebagai PDF
    private string JudulDokumen => preset == PresetPeriode.Semua || jenis == JenisLaporan.Kadaluwarsa
        ? JudulLaporan
        : $"{JudulLaporan} {Iso(dari)} sd {Iso(sampai)}";

    private async Task Cetak()
    {
        modulCetak ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/cetak.js");
        await modulCetak.InvokeVoidAsync("cetakElemen", "dokumen-cetak", JudulDokumen);
    }
}