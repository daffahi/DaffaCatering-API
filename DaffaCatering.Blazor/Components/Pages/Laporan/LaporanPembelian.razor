@page "/laporan/pembelian"
@attribute [Authorize(Roles = AppRoles.AdminPembelian)]
@implements IAsyncDisposable

@using System.Globalization
@inject LaporanPembelianService LaporanService
@inject PemasokService PemasokService
@inject BahanBakuService BahanBakuService
@inject SatuanBahanBakuService SatuanBahanBakuService
@inject IConfiguration Config
@inject IJSRuntime JS

@{
    var tampil = Tampil;
    var penerimaan = jenis == JenisLaporan.Penerimaan;
    var perPemasok = !penerimaan && kelompok == KelompokLaporan.Pemasok;
    var labelJenis = penerimaan ? "penerimaan" : "pembelian";
    var jmlTransaksi = tampil.SelectMany(g => g.Baris).Select(b => b.IdTransaksi).Distinct().Count();
    var jmlItem = tampil.Sum(g => g.Baris.Count);
    var jmlBahanBaku = tampil.SelectMany(g => g.Baris).Select(b => b.IdBahanBaku).Distinct().Count();
    var totalNilai = tampil.Sum(g => g.Subtotal);
    var jmlKolom = penerimaan ? 4 : perPemasok ? 3 : 6;
}

<div class="laporan-page">

    @* ================= 1. HEADER HALAMAN ================= *@
    <header class="page-head">
        <div>
            <h1>Laporan Pembelian</h1>
            <p>Rekap pembelian dan penerimaan bahan baku per periode</p>
        </div>
        <button class="btn-cetak" disabled="@(isLoading || tampil.Count == 0)" @onclick="Cetak">
            <i class="fa-solid fa-print"></i> Cetak
        </button>
    </header>

    @* ================= 2. BANNER ERROR ================= *@
    @if (!string.IsNullOrEmpty(PesanError))
    {
        <div class="banner">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@PesanError</span>
            <button class="banner-close" @onclick="TutupError">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @* ================= 3. FILTER LAPORAN ================= *@
    <section class="filter-card">
        <div class="filter-row">

            <div class="fg">
                <span class="fl">Jenis</span>
                <div class="segmented">
                    <button class="@Seg(jenis == JenisLaporan.Pembelian)" @onclick="() => PilihJenis(JenisLaporan.Pembelian)">Pembelian</button>
                    <button class="@Seg(jenis == JenisLaporan.Penerimaan)" @onclick="() => PilihJenis(JenisLaporan.Penerimaan)">Penerimaan</button>
                </div>
            </div>

            @if (!penerimaan)
            {
                <div class="fg">
                    <span class="fl">Kelompok</span>
                    <div class="segmented">
                        <button class="@Seg(kelompok == KelompokLaporan.Pemasok)" @onclick="() => PilihKelompok(KelompokLaporan.Pemasok)">
                            Per Pemasok
                        </button>
                        <button class="@Seg(kelompok == KelompokLaporan.BahanBaku)" @onclick="() => PilihKelompok(KelompokLaporan.BahanBaku)">
                            Per Bahan Baku
                        </button>
                    </div>
                </div>
            }

            <div class="fg">
                <span class="fl">Periode</span>
                <div class="segmented">
                    <button class="@Seg(preset == PresetPeriode.HariIni)" @onclick="() => PilihPreset(PresetPeriode.HariIni)">
                        Hari Ini
                    </button>
                    <button class="@Seg(preset == PresetPeriode.TujuhHari)" @onclick="() => PilihPreset(PresetPeriode.TujuhHari)">
                        7 Hari
                    </button>
                    <button class="@Seg(preset == PresetPeriode.BulanIni)" @onclick="() => PilihPreset(PresetPeriode.BulanIni)">
                        Bulan Ini
                    </button>
                </div>
            </div>

            <label class="fg">
                <span class="fl">Dari</span>
                <input type="date" value="@Iso(dari)" max="@Iso(sampai)" @onchange="UbahDari" />
            </label>

            <label class="fg">
                <span class="fl">Sampai</span>
                <input type="date" value="@Iso(sampai)" min="@Iso(dari)" @onchange="UbahSampai" />
            </label>
        </div>

        <label class="search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="@PlaceholderCari"
                   @bind="teksCari" @bind:event="oninput" />
        </label>
    </section>

    @* ================= 4. KARTU RINGKASAN ================= *@
    @if (!isLoading)
    {
        <section class="dashboard-cards">
            @if (penerimaan)
            {
                <div class="dashboard-card">
                    <div class="card-icon"><i class="fa-solid fa-truck-ramp-box"></i></div>
                    <div class="card-content">
                        <div class="card-title">@tampil.Count Penerimaan</div>
                        <div class="card-subtitle">Jumlah penerimaan</div>
                    </div>
                </div>
                <div class="dashboard-card">
                    <div class="card-icon"><i class="fa-solid fa-boxes-stacked"></i></div>
                    <div class="card-content">
                        <div class="card-title">@jmlItem Item</div>
                        <div class="card-subtitle">Bahan baku diterima</div>
                    </div>
                </div>
                <div class="dashboard-card">
                    <div class="card-icon"><i class="fa-solid fa-wheat-awn"></i></div>
                    <div class="card-content">
                        <div class="card-title">@jmlBahanBaku Bahan Baku</div>
                        <div class="card-subtitle">Jenis bahan baku</div>
                    </div>
                </div>
            }
            else
            {
                <div class="dashboard-card">
                    <div class="card-icon"><i class="fa-solid @(perPemasok ? "fa-truck" : "fa-wheat-awn")"></i></div>
                    <div class="card-content">
                        <div class="card-title">@tampil.Count @(perPemasok ? "Pemasok" : "Bahan Baku")</div>
                        <div class="card-subtitle">@(perPemasok ? "Pemasok bertransaksi" : "Bahan baku dibeli")</div>
                    </div>
                </div>
                <div class="dashboard-card">
                    <div class="card-icon"><i class="fa-solid fa-receipt"></i></div>
                    <div class="card-content">
                        <div class="card-title">@jmlTransaksi Transaksi</div>
                        <div class="card-subtitle">Jumlah @labelJenis</div>
                    </div>
                </div>
                <div class="dashboard-card">
                    <div class="card-icon"><i class="fa-solid fa-money-bills"></i></div>
                    <div class="card-content">
                        <div class="card-title">@FormatRupiah(totalNilai)</div>
                        <div class="card-subtitle">Total nilai @labelJenis</div>
                    </div>
                </div>
            }
        </section>
    }

    @* ================= 5. TABEL LAPORAN ================= *@
    <section class="panel">

        @if (isLoading)
        {
            <div class="skeleton">
                @for (var s = 0; s < 6; s++)
                {
                    <div class="sk-row">
                        <div class="sk-avatar"></div>
                        <div class="sk-lines"><div></div><div></div></div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        @if (penerimaan)
                        {
                            <tr>
                                <th>Nama Bahan Baku</th>
                                <th>Tgl Kadaluwarsa</th>
                                <th class="num">Jumlah</th>
                                <th>Status</th>
                            </tr>
                        }
                        else if (perPemasok)
                        {
                            <tr>
                                <th>No. Pembelian</th>
                                <th>Tanggal</th>
                                <th class="num">Total</th>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <th>No. Pembelian</th>
                                <th>Tanggal</th>
                                <th>Pemasok</th>
                                <th class="num">Jumlah</th>
                                <th class="num">Harga</th>
                                <th class="num">Subtotal</th>
                            </tr>
                        }
                    </thead>

                    @foreach (var g in tampil)
                    {
                        var nama = NamaKelompok(g);
                        var pertama = g.Baris[0];

                        <tbody @key="g.Id">
                            <tr class="grp-head">
                                <td colspan="@jmlKolom">
                                    <div class="who">
                                        <div class="avatar tone-@Warna(nama)">@(penerimaan ? "PN" : Inisial(nama))</div>
                                        <div>
                                            <div class="name">@nama</div>
                                            @if (penerimaan)
                                            {
                                                <div class="sub">@pertama.Tanggal.ToString("dd MMM yyyy", IdCulture) - Pembelian @pertama.IdPembelian - @NamaPemasok(pertama.IdPemasok)</div>
                                            }
                                            else
                                            {
                                                <div class="sub">@g.Id - @g.JumlahTransaksi transaksi</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>

                            @if (penerimaan)
                            {
                                foreach (var b in g.Baris)
                                {
                                    <tr class="row-trx">
                                        <td>@NamaBahanBaku(b.IdBahanBaku)</td>
                                        <td>@Tgl(b.TglKadaluwarsa)</td>
                                        <td class="num mono">@FormatAngka(b.Jumlah) @NamaSatuan(b.IdSatuan)</td>
                                        <td>
                                            <span class="pill @(IsDiterima(b.Status) ? "closed" : "pending")">
                                                <i></i>@(string.IsNullOrWhiteSpace(b.Status) ? "-" : b.Status)
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else if (perPemasok)
                            {
                                foreach (var t in g.Baris.GroupBy(x => x.IdTransaksi))
                                {
                                    var b = t.First();

                                    <tr class="row-trx">
                                        <td class="mono">@b.IdTransaksi</td>
                                        <td>@b.Tanggal.ToString("dd MMM yyyy", IdCulture)</td>
                                        <td class="num mono">@FormatAngka(b.TotalTransaksi)</td>
                                    </tr>
                                }

                                <tr class="grp-total">
                                    <td colspan="2">Subtotal</td>
                                    <td class="num mono">@FormatAngka(g.Subtotal)</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var b in g.Baris)
                                {
                                    <tr class="row-trx">
                                        <td class="mono">@b.IdTransaksi</td>
                                        <td>@b.Tanggal.ToString("dd MMM yyyy", IdCulture)</td>
                                        <td>@NamaPemasok(b.IdPemasok)</td>
                                        <td class="num mono">@FormatAngka(b.Jumlah) @NamaSatuan(b.IdSatuan)</td>
                                        <td class="num mono">@FormatAngka(b.Harga)</td>
                                        <td class="num mono">@FormatAngka(b.Subtotal)</td>
                                    </tr>
                                }

                                <tr class="grp-total">
                                    <td colspan="5">Subtotal</td>
                                    <td class="num mono">@FormatAngka(g.Subtotal)</td>
                                </tr>
                            }
                        </tbody>
                    }
                </table>

                @if (tampil.Count == 0)
                {
                    <div class="empty">
                        <i class="fa-regular fa-face-frown-open"></i>
                        <strong>Data laporan tidak ditemukan</strong>
                        <span>Tidak ada @labelJenis pada periode ini, coba ubah periode atau kata kunci</span>
                    </div>
                }
            </div>

            <div class="panel-foot">
                <span>
                    Menampilkan <b>@jmlTransaksi</b> transaksi
                    @if (!penerimaan)
                    {
                        <text> dari <b>@tampil.Count</b> @(perPemasok ? "pemasok" : "bahan baku")</text>
                    }
                </span>
                @if (!penerimaan)
                {
                    <span>Total <b>@FormatRupiah(totalNilai)</b></span>
                }
            </div>
        }
    </section>

    @* ================= 6. DOKUMEN CETAK (tidak tampil di layar) ================= *@
    @if (!isLoading && tampil.Count > 0)
    {
        <div id="dokumen-cetak" class="doc">

            <header class="doc-kop">
                <img src="images/logo.png" class="doc-logo" alt="" onerror="this.style.display='none'" />
                <div class="doc-judul">
                    <h1>@JudulLaporan</h1>
                    <div class="doc-usaha">@NamaUsaha</div>
                    <div class="doc-alamat">@AlamatUsaha</div>
                </div>
                <div></div>
            </header>

            <hr class="doc-garis" />

            <div class="doc-meta">
                <span>Dicetak oleh: <b>@namaPencetak</b></span>
                <span>Tanggal Cetak: <b>@Tgl(DateOnly.FromDateTime(DateTime.Today))</b></span>
            </div>
            <div class="doc-meta">
                <span>
                    Periode: <b>@Tgl(dari) s/d @Tgl(sampai)</b>
                    @if (!string.IsNullOrWhiteSpace(teksCari))
                    {
                        <text> | Pencarian: <b>@teksCari</b></text>
                    }
                </span>
            </div>

            @if (penerimaan)
            {
                @* ---------- Penerimaan: satu blok per nomor penerimaan ---------- *@
                foreach (var g in tampil)
                {
                    var pertama = g.Baris[0];
                    var nomor = 0;

                    <section class="doc-blok">
                        <div class="doc-info-baris">
                            <table class="doc-info">
                                <tr>
                                    <th>No. Penerimaan</th>
                                    <td class="sep">:</td>
                                    <td>@g.Id</td>
                                </tr>
                                <tr>
                                    <th>No. Pembelian</th>
                                    <td class="sep">:</td>
                                    <td>@pertama.IdPembelian</td>
                                </tr>
                            </table>
                            <table class="doc-info">
                                <tr>
                                    <th>Tgl Penerimaan</th>
                                    <td class="sep">:</td>
                                    <td>@Tgl(pertama.Tanggal)</td>
                                </tr>
                            </table>
                        </div>

                        <table class="doc-tabel">
                            <colgroup>
                                <col style="width:44px" />
                                <col />
                                <col style="width:110px" />
                                <col style="width:80px" />
                                <col style="width:100px" />
                                <col style="width:100px" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>Nama Bahan Baku</th>
                                    <th>Tgl Kadaluwarsa</th>
                                    <th>Jumlah</th>
                                    <th>Satuan</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in g.Baris)
                                {
                                    <tr>
                                        <td class="c">@(++nomor)</td>
                                        <td>@NamaBahanBaku(b.IdBahanBaku)</td>
                                        <td class="c">@Tgl(b.TglKadaluwarsa)</td>
                                        <td class="c">@FormatAngka(b.Jumlah)</td>
                                        <td class="c">@NamaSatuan(b.IdSatuan)</td>
                                        <td class="c">@(string.IsNullOrWhiteSpace(b.Status) ? "-" : b.Status)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </section>
                }
            }
            else if (perPemasok)
            {
                @* ---------- Pembelian per pemasok: satu blok per pembelian ---------- *@
                foreach (var x in TransaksiUrut(tampil))
                {
                    var pertama = x.Baris[0];
                    var nomor = 0;

                    <section class="doc-blok">
                        <table class="doc-info">
                            <tr>
                                <th>Kode Pemasok</th>
                                <td class="sep">:</td>
                                <td>@x.IdPemasok</td>
                                <td>@x.Nama</td>
                            </tr>
                            <tr>
                                <th>No. Pembelian</th>
                                <td class="sep">:</td>
                                <td colspan="2">@pertama.IdTransaksi</td>
                            </tr>
                            <tr>
                                <th>Tgl Pembelian</th>
                                <td class="sep">:</td>
                                <td colspan="2">@Tgl(pertama.Tanggal)</td>
                            </tr>
                        </table>

                        <table class="doc-tabel">
                            <colgroup>
                                <col style="width:44px" />
                                <col />
                                <col style="width:80px" />
                                <col style="width:100px" />
                                <col style="width:120px" />
                                <col style="width:130px" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>Nama Bahan Baku</th>
                                    <th>Jumlah</th>
                                    <th>Satuan</th>
                                    <th>Harga</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in x.Baris)
                                {
                                    <tr>
                                        <td class="c">@(++nomor)</td>
                                        <td>@NamaBahanBaku(b.IdBahanBaku)</td>
                                        <td class="c">@FormatAngka(b.Jumlah)</td>
                                        <td class="c">@NamaSatuan(b.IdSatuan)</td>
                                        <td>@Rp(b.Harga)</td>
                                        <td>@Rp(b.Subtotal)</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" class="r"><b>Total</b></td>
                                    <td>@Rp(pertama.TotalTransaksi)</td>
                                </tr>
                            </tfoot>
                        </table>
                    </section>
                }
            }
            else
            {
                @* ---------- Pembelian per bahan baku: satu blok per bahan baku ---------- *@
                foreach (var g in tampil)
                {
                    var nomor = 0;

                    <section class="doc-blok">
                        <table class="doc-info">
                            <tr>
                                <th>Kode Bahan Baku</th>
                                <td class="sep">:</td>
                                <td>@g.Id</td>
                            </tr>
                            <tr>
                                <th>Nama Bahan Baku</th>
                                <td class="sep">:</td>
                                <td>@NamaKelompok(g)</td>
                            </tr>
                        </table>

                        <table class="doc-tabel">
                            <colgroup>
                                <col style="width:40px" />
                                <col style="width:105px" />
                                <col style="width:80px" />
                                <col />
                                <col style="width:70px" />
                                <col style="width:80px" />
                                <col style="width:95px" />
                                <col style="width:110px" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>No. Pembelian</th>
                                    <th>Tgl Pembelian</th>
                                    <th>Nama Pemasok</th>
                                    <th>Jumlah</th>
                                    <th>Satuan</th>
                                    <th>Harga</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in g.Baris.OrderBy(b => b.IdTransaksi, StringComparer.Ordinal))
                                {
                                    <tr>
                                        <td class="c">@(++nomor)</td>
                                        <td>@b.IdTransaksi</td>
                                        <td class="c">@Tgl(b.Tanggal)</td>
                                        <td>@NamaPemasok(b.IdPemasok)</td>
                                        <td class="c">@FormatAngka(b.Jumlah)</td>
                                        <td class="c">@NamaSatuan(b.IdSatuan)</td>
                                        <td>@Rp(b.Harga)</td>
                                        <td>@Rp(b.Subtotal)</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="7" class="r"><b>Total</b></td>
                                    <td>@Rp(g.Subtotal)</td>
                                </tr>
                            </tfoot>
                        </table>
                    </section>
                }
            }

            @if (!penerimaan)
            {
                <div class="doc-grand">
                    <span>Total Keseluruhan</span>
                    @Rp(totalNilai)
                </div>
            }
        </div>
    }

</div>

@code {
    // =====================================================
    // 1. STATE
    // =====================================================
    private static readonly CultureInfo IdCulture = new("id-ID");

    private enum JenisLaporan { Pembelian, Penerimaan }
    private enum KelompokLaporan { Pemasok, BahanBaku }
    private enum PresetPeriode { HariIni, TujuhHari, BulanIni, Kustom }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    // --- data ---
    private List<LaporanPembelianKelompok> data = new();
    private List<PemasokModels> daftarPemasok = new();
    private List<BahanBakuModels> daftarBahanBaku = new();
    private List<SatuanBahanBakuModels> daftarSatuan = new();

    // --- halaman ---
    private bool isLoading = true;
    private string errorMaster = "";
    private string errorLaporan = "";
    private string teksCari = "";
    private string namaPencetak = "";
    private int permintaanKe;
    private IJSObjectReference? modulCetak;

    // --- filter ---
    private JenisLaporan jenis = JenisLaporan.Pembelian;
    private KelompokLaporan kelompok = KelompokLaporan.Pemasok;
    private PresetPeriode preset = PresetPeriode.TujuhHari;
    private DateOnly dari;
    private DateOnly sampai;

    private string PesanError => string.Join(" ",
        new[] { errorMaster, errorLaporan }.Where(s => !string.IsNullOrEmpty(s)));

    private void TutupError()
    {
        errorMaster = "";
        errorLaporan = "";
    }

    // =====================================================
    // 2. LIFECYCLE & MUAT DATA
    // =====================================================
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            namaPencetak = state.User.Identity?.Name ?? "";
        }

        AturPreset(PresetPeriode.TujuhHari);
        await MuatMaster();
        await MuatLaporan();
    }

    public async ValueTask DisposeAsync()
    {
        if (modulCetak is null) return;

        try { await modulCetak.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }

    // Master dipakai untuk menampilkan nama dari kode
    private async Task MuatMaster()
    {
        var galat = new List<string>();

        try { daftarPemasok = await PemasokService.GetAllAsync(); }
        catch (Exception ex) { galat.Add("Gagal memuat pemasok: " + ex.Message); }

        try { daftarBahanBaku = await BahanBakuService.GetAllAsync(); }
        catch (Exception ex) { galat.Add("Gagal memuat bahan baku: " + ex.Message); }

        try { daftarSatuan = await SatuanBahanBakuService.GetAllAsync(); }
        catch (Exception ex) { galat.Add("Gagal memuat satuan: " + ex.Message); }

        errorMaster = string.Join(" ", galat);
    }

    private async Task MuatLaporan()
    {
        // permintaan lama yang masih berjalan dibatalkan hasilnya
        var permintaan = ++permintaanKe;
        errorLaporan = "";

        if (dari > sampai)
        {
            errorLaporan = "Tanggal awal tidak boleh lebih besar dari tanggal akhir";
            data = new();
            isLoading = false;
            return;
        }

        isLoading = true;

        try
        {
            var (hasilApi, error) = await LaporanService.AmbilAsync(
                jenis.ToString().ToLowerInvariant(),
                kelompok.ToString().ToLowerInvariant(),
                dari, sampai);

            if (permintaan != permintaanKe) return;

            if (hasilApi is null)
            {
                errorLaporan = "Gagal memuat laporan: " + error;
                data = new();
            }
            else
            {
                data = hasilApi;
            }
        }
        catch (Exception ex)
        {
            if (permintaan != permintaanKe) return;
            errorLaporan = "Gagal memuat laporan: " + ex.Message;
            data = new();
        }

        isLoading = false;
    }

    // =====================================================
    // 3. HELPER UMUM (format & lookup nama)
    // =====================================================
    private static string Iso(DateOnly d) => d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private static string Tgl(DateOnly? d) => d is null ? "-" : d.Value.ToString("dd/MM/yyyy", IdCulture);

    private static string FormatAngka(decimal v) => v.ToString("#,##0.##", IdCulture);

    private static string FormatRupiah(decimal v) => v.ToString("C0", IdCulture);

    private static string Seg(bool aktif) => aktif ? "seg active" : "seg";

    private static bool IsDiterima(string? s) => string.Equals(s, "Diterima", StringComparison.OrdinalIgnoreCase);

    // "Rp" rata kiri dan angka rata kanan, seperti di Crystal Report
    private RenderFragment Rp(decimal v) => @<div class="rp"><span>Rp</span><span>@FormatAngka(v)</span></div>;

    private static string Inisial(string? nama)
    {
        var p = (nama ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length == 0 ? "?"
             : p.Length == 1 ? p[0][..1].ToUpper()
             : (p[0][..1] + p[^1][..1]).ToUpper();
    }

    // Warna avatar stabil per nama (string.GetHashCode() berubah tiap proses, jadi tidak dipakai)
    private static int Warna(string? nama) => (nama ?? "").Sum(ch => ch) % 5;

    private string NamaPemasok(string? id)
        => daftarPemasok.FirstOrDefault(p => p.IdPemasok == id)?.NamaPemasok ?? (id ?? "-");

    private string NamaBahanBaku(string? id)
        => daftarBahanBaku.FirstOrDefault(b => b.IdBahanBaku == id)?.NamaBahanBaku ?? (id ?? "-");

    private string NamaSatuan(string? id)
        => daftarSatuan.FirstOrDefault(s => s.IdSatuan == id)?.NamaSatuan ?? (id ?? "-");

    // Penerimaan dikelompokkan per nomor penerimaan, jadi namanya nomor itu sendiri
    private string NamaKelompok(LaporanPembelianKelompok g)
    {
        if (jenis == JenisLaporan.Penerimaan) return g.Id;

        return kelompok == KelompokLaporan.Pemasok ? NamaPemasok(g.Id) : NamaBahanBaku(g.Id);
    }

    // =====================================================
    // 4. TAMPILAN: PENCARIAN & URUTAN
    // =====================================================
    private string PlaceholderCari => jenis == JenisLaporan.Penerimaan
        ? "Cari no. penerimaan, no. pembelian, atau pemasok..."
        : kelompok == KelompokLaporan.Pemasok
            ? "Cari kode atau nama pemasok..."
            : "Cari kode atau nama bahan baku...";

    private bool Cocok(LaporanPembelianKelompok g)
    {
        if (string.IsNullOrWhiteSpace(teksCari)) return true;

        var cocok = g.Id.Contains(teksCari, StringComparison.OrdinalIgnoreCase)
            || NamaKelompok(g).Contains(teksCari, StringComparison.OrdinalIgnoreCase);

        if (jenis != JenisLaporan.Penerimaan) return cocok;

        var pertama = g.Baris[0];
        return cocok
            || (pertama.IdPembelian ?? "").Contains(teksCari, StringComparison.OrdinalIgnoreCase)
            || NamaPemasok(pertama.IdPemasok).Contains(teksCari, StringComparison.OrdinalIgnoreCase);
    }

    private List<LaporanPembelianKelompok> Tampil
    {
        get
        {
            var hasil = data.Where(Cocok);

            // Penerimaan dan per bahan baku: urut kode. Per pemasok: urut nama pemasok
            // (urutan di dokumen cetak per pemasok diatur terpisah oleh TransaksiUrut)
            return jenis == JenisLaporan.Pembelian && kelompok == KelompokLaporan.Pemasok
                ? hasil.OrderBy(g => NamaKelompok(g)).ToList()
                : hasil.OrderBy(g => g.Id, StringComparer.Ordinal).ToList();
        }
    }

    // =====================================================
    // 5. FILTER: PERIODE & PILIHAN
    // =====================================================
    private void AturPreset(PresetPeriode p)
    {
        var hariIni = DateOnly.FromDateTime(DateTime.Today);
        preset = p;

        switch (p)
        {
            case PresetPeriode.HariIni:
                dari = hariIni;
                sampai = hariIni;
                break;
            case PresetPeriode.TujuhHari:
                dari = hariIni.AddDays(-6);
                sampai = hariIni;
                break;
            case PresetPeriode.BulanIni:
                dari = new DateOnly(hariIni.Year, hariIni.Month, 1);
                sampai = hariIni;
                break;
        }
    }

    private async Task PilihPreset(PresetPeriode p)
    {
        AturPreset(p);
        await MuatLaporan();
    }

    private async Task PilihJenis(JenisLaporan j)
    {
        if (jenis == j) return;

        jenis = j;
        teksCari = "";
        await MuatLaporan();
    }

    private async Task PilihKelompok(KelompokLaporan k)
    {
        if (kelompok == k) return;

        kelompok = k;
        teksCari = "";
        await MuatLaporan();
    }

    private async Task UbahDari(ChangeEventArgs e)
    {
        if (!DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var tgl)) return;

        dari = tgl;
        preset = PresetPeriode.Kustom;
        await MuatLaporan();
    }

    private async Task UbahSampai(ChangeEventArgs e)
    {
        if (!DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var tgl)) return;

        sampai = tgl;
        preset = PresetPeriode.Kustom;
        await MuatLaporan();
    }

    // =====================================================
    // 6. DOKUMEN CETAK
    // =====================================================
    private string NamaUsaha => Config["Usaha:Nama"] ?? "";

    private string AlamatUsaha => Config["Usaha:Alamat"] ?? "";

    private string JudulLaporan => jenis == JenisLaporan.Penerimaan
        ? "Laporan Penerimaan Bahan Baku"
        : $"Laporan Pembelian per {(kelompok == KelompokLaporan.Pemasok ? "Pemasok" : "Bahan Baku")}";

    // Judul ini juga menjadi nama file bawaan saat disimpan sebagai PDF
    private string JudulDokumen => $"{JudulLaporan} {Iso(dari)} sd {Iso(sampai)}";

    private async Task Cetak()
    {
        modulCetak ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/cetak.js");
        await modulCetak.InvokeVoidAsync("cetakElemen", "dokumen-cetak", JudulDokumen);
    }

    // Dokumen cetak per pemasok: satu blok per pembelian, urut nomor pembelian
    private IEnumerable<(string IdPemasok, string Nama, List<LaporanPembelianBaris> Baris)> TransaksiUrut(List<LaporanPembelianKelompok> kelompokTampil)
        => kelompokTampil
            .SelectMany(g => g.Baris
                .GroupBy(b => b.IdTransaksi)
                .Select(t => (IdPemasok: g.Id, Nama: NamaKelompok(g), Baris: t.ToList())))
            .OrderBy(x => x.Baris[0].IdTransaksi, StringComparer.Ordinal);
}