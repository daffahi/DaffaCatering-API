@page "/laporan/pelanggan"
@attribute [Authorize(Roles = AppRoles.AdminPenjualan)]
@implements IAsyncDisposable

@using System.Globalization
@inject DaftarPelangganService LaporanService
@inject IConfiguration Config
@inject IJSRuntime JS

@{
    var tampil = Tampil;
    var jmlAktif = tampil.Count(p => p.Status);
    var jmlNonaktif = tampil.Count - jmlAktif;
}

<div class="laporan-page">

    @* ================= 1. HEADER HALAMAN ================= *@
    <header class="page-head">
        <div>
            <h1>Daftar Pelanggan</h1>
            <p>Rekap data pelanggan beserta status keaktifannya</p>
        </div>
        <button class="btn-ghost" disabled="@(isLoading || tampil.Count == 0)" @onclick="Cetak">
            <i class="fa-solid fa-print"></i> Cetak
        </button>
    </header>

    @* ================= 2. BANNER ERROR ================= *@
    @if (!string.IsNullOrEmpty(errorLaporan))
    {
        <div class="banner">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@errorLaporan</span>
            <button class="banner-close" @onclick="TutupError">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @* ================= 3. FILTER LAPORAN ================= *@
    <section class="filter-card">
        <div class="filter-row">
            <div class="fg">
                <span class="fl">Status</span>
                <div class="segmented">
                    <button class="@Seg(status == StatusFilter.Semua)" @onclick="() => PilihStatus(StatusFilter.Semua)">Semua</button>
                    <button class="@Seg(status == StatusFilter.Aktif)" @onclick="() => PilihStatus(StatusFilter.Aktif)">Aktif</button>
                    <button class="@Seg(status == StatusFilter.Nonaktif)" @onclick="() => PilihStatus(StatusFilter.Nonaktif)">Nonaktif</button>
                </div>
            </div>
        </div>

        <label class="search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="Cari kode, nama, kontak, atau alamat pelanggan..."
                   @bind="teksCari" @bind:event="oninput" />
        </label>
    </section>

    @* ================= 4. KARTU RINGKASAN ================= *@
    @if (!isLoading)
    {
        <section class="dashboard-cards">
            <div class="dashboard-card">
                <div class="card-icon"><i class="fa-solid fa-users"></i></div>
                <div class="card-content">
                    <div class="card-title">@tampil.Count Pelanggan</div>
                    <div class="card-subtitle">Total pelanggan</div>
                </div>
            </div>
            <div class="dashboard-card">
                <div class="card-icon"><i class="fa-solid fa-user-check"></i></div>
                <div class="card-content">
                    <div class="card-title">@jmlAktif Pelanggan</div>
                    <div class="card-subtitle">Pelanggan aktif</div>
                </div>
            </div>
            <div class="dashboard-card">
                <div class="card-icon"><i class="fa-solid fa-user-xmark"></i></div>
                <div class="card-content">
                    <div class="card-title">@jmlNonaktif Pelanggan</div>
                    <div class="card-subtitle">Pelanggan nonaktif</div>
                </div>
            </div>
        </section>
    }

    @* ================= 5. TABEL LAPORAN ================= *@
    <section class="panel">

        @if (isLoading)
        {
            <div class="skeleton">
                @for (var s = 0; s < 6; s++)
                {
                    <div class="sk-row">
                        <div class="sk-avatar"></div>
                        <div class="sk-lines"><div></div><div></div></div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Pelanggan</th>
                            <th>Nomor Kontak</th>
                            <th>Alamat</th>
                            <th>Tgl Bergabung</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in tampil)
                        {
                            <tr class="row-trx" @key="p.IdPelanggan">
                                <td>
                                    <div class="who">
                                        <div class="avatar tone-@Warna(p.NamaPelanggan)">@Inisial(p.NamaPelanggan)</div>
                                        <div>
                                            <div class="name">@p.NamaPelanggan</div>
                                            <div class="sub">@p.IdPelanggan</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="mono">@Kosong(p.NoKontak)</td>
                                <td>@Kosong(p.Alamat)</td>
                                <td>@Tgl(p.TglBergabung)</td>
                                <td>
                                    <span class="pill @(p.Status ? "closed" : "pending")">
                                        <i></i>@LabelStatus(p.Status)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (tampil.Count == 0)
                {
                    <div class="empty">
                        <i class="fa-regular fa-face-frown-open"></i>
                        <strong>Data pelanggan tidak ditemukan</strong>
                        <span>Tidak ada pelanggan yang sesuai, coba ubah filter atau kata kunci</span>
                    </div>
                }
            </div>

            <div class="panel-foot">
                <span>Menampilkan <b>@tampil.Count</b> pelanggan</span>
            </div>
        }
    </section>

    @* ================= 6. DOKUMEN CETAK (tidak tampil di layar) ================= *@
    @if (!isLoading && tampil.Count > 0)
    {
        <div id="dokumen-cetak" class="doc">

            <header class="doc-kop">
                <img src="images/logo.png" class="doc-logo" alt="" onerror="this.style.display='none'" />
                <div class="doc-judul">
                    <h1>Daftar Pelanggan</h1>
                    <div class="doc-usaha">@NamaUsaha</div>
                    <div class="doc-alamat">@AlamatUsaha</div>
                </div>
                <div></div>
            </header>

            <hr class="doc-garis" />

            <div class="doc-meta">
                <span>Dicetak oleh: <b>@namaPencetak</b></span>
                <span>Tanggal Cetak: <b>@Tgl(DateOnly.FromDateTime(DateTime.Today))</b></span>
            </div>
            @if (status != StatusFilter.Semua || !string.IsNullOrWhiteSpace(teksCari))
            {
                <div class="doc-meta">
                    <span>
                        @if (status != StatusFilter.Semua)
                        {
                            <text>Status: <b>@status</b></text>
                        }
                        @if (!string.IsNullOrWhiteSpace(teksCari))
                        {
                            <text>@(status != StatusFilter.Semua ? " | " : "")Pencarian: <b>@teksCari</b></text>
                        }
                    </span>
                </div>
            }

            @{ var nomor = 0; }
            <section class="doc-blok">
                <table class="doc-tabel">
                    <colgroup>
                        <col style="width:36px" />
                        <col style="width:90px" />
                        <col style="width:130px" />
                        <col style="width:105px" />
                        <col />
                        <col style="width:72px" />
                        <col style="width:60px" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Kode Pelanggan</th>
                            <th>Nama Pelanggan</th>
                            <th>Nomor Kontak</th>
                            <th>Alamat</th>
                            <th>Tanggal<br />Bergabung</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in tampil)
                        {
                            <tr>
                                <td class="c">@(++nomor)</td>
                                <td class="c">@p.IdPelanggan</td>
                                <td>@p.NamaPelanggan</td>
                                <td class="c">@Kosong(p.NoKontak)</td>
                                <td>@Kosong(p.Alamat)</td>
                                <td class="c" style="white-space:nowrap">@Tgl(p.TglBergabung)</td>
                                <td class="c">@LabelStatus(p.Status)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        </div>
    }

</div>

@code {
    // =====================================================
    // 1. STATE
    // =====================================================
    private static readonly CultureInfo IdCulture = new("id-ID");

    private enum StatusFilter { Semua, Aktif, Nonaktif }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    // --- data ---
    private List<DaftarPelangganModels> data = new();

    // --- halaman ---
    private bool isLoading = true;
    private string errorLaporan = "";
    private string teksCari = "";
    private string namaPencetak = "";
    private int permintaanKe;
    private IJSObjectReference? modulCetak;

    // --- filter ---
    private StatusFilter status = StatusFilter.Semua;

    private void TutupError() => errorLaporan = "";

    // =====================================================
    // 2. LIFECYCLE & MUAT DATA
    // =====================================================
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            namaPencetak = state.User.Identity?.Name ?? "";
        }

        await MuatLaporan();
    }

    public async ValueTask DisposeAsync()
    {
        if (modulCetak is null) return;

        try { await modulCetak.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }

    private async Task MuatLaporan()
    {
        // permintaan lama yang masih berjalan dibatalkan hasilnya
        var permintaan = ++permintaanKe;
        errorLaporan = "";
        isLoading = true;

        try
        {
            var (hasilApi, error) = await LaporanService.AmbilAsync(status.ToString().ToLowerInvariant());

            if (permintaan != permintaanKe) return;

            if (hasilApi is null)
            {
                errorLaporan = "Gagal memuat laporan: " + error;
                data = new();
            }
            else
            {
                data = hasilApi;
            }
        }
        catch (Exception ex)
        {
            if (permintaan != permintaanKe) return;
            errorLaporan = "Gagal memuat laporan: " + ex.Message;
            data = new();
        }

        isLoading = false;
    }

    // =====================================================
    // 3. HELPER UMUM (format)
    // =====================================================
    private static string Tgl(DateOnly d) => d.ToString("dd/MM/yyyy", IdCulture);

    private static string Seg(bool aktif) => aktif ? "seg active" : "seg";

    private static string Kosong(string? s) => string.IsNullOrWhiteSpace(s) ? "-" : s;

    private static string LabelStatus(bool aktif) => aktif ? "Aktif" : "Nonaktif";

    private static string Inisial(string? nama)
    {
        var p = (nama ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length == 0 ? "?"
             : p.Length == 1 ? p[0][..1].ToUpper()
             : (p[0][..1] + p[^1][..1]).ToUpper();
    }

    // Warna avatar stabil per nama (string.GetHashCode() berubah tiap proses, jadi tidak dipakai)
    private static int Warna(string? nama) => (nama ?? "").Sum(ch => ch) % 5;

    // =====================================================
    // 4. TAMPILAN: PENCARIAN
    // =====================================================
    private bool Cocok(DaftarPelangganModels p)
    {
        if (string.IsNullOrWhiteSpace(teksCari)) return true;

        return p.IdPelanggan.Contains(teksCari, StringComparison.OrdinalIgnoreCase)
            || p.NamaPelanggan.Contains(teksCari, StringComparison.OrdinalIgnoreCase)
            || (p.NoKontak ?? "").Contains(teksCari, StringComparison.OrdinalIgnoreCase)
            || (p.Alamat ?? "").Contains(teksCari, StringComparison.OrdinalIgnoreCase);
    }

    // Urutan kode pelanggan sudah diatur oleh API
    private List<DaftarPelangganModels> Tampil => data.Where(Cocok).ToList();

    // =====================================================
    // 5. FILTER
    // =====================================================
    private async Task PilihStatus(StatusFilter s)
    {
        if (status == s) return;

        status = s;
        teksCari = "";
        await MuatLaporan();
    }

    // =====================================================
    // 6. DOKUMEN CETAK
    // =====================================================
    private string NamaUsaha => Config["Usaha:Nama"] ?? "";

    private string AlamatUsaha => Config["Usaha:Alamat"] ?? "";

    // Judul ini juga menjadi nama file bawaan saat disimpan sebagai PDF
    private string JudulDokumen => $"Daftar Pelanggan {DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}";

    private async Task Cetak()
    {
        modulCetak ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/cetak.js");
        await modulCetak.InvokeVoidAsync("cetakElemen", "dokumen-cetak", JudulDokumen);
    }
}