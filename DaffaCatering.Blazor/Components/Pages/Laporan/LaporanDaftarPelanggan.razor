
@page "/laporan/pelanggan"
@attribute [Authorize(Roles = AppRoles.AdminPenjualan)]
@implements IAsyncDisposable

@using System.Globalization
@inject DaftarPelangganService LaporanService
@inject IConfiguration Config
@inject IJSRuntime JS

@{
    var tampil = Tampil;

    var jmlAktif = tampil.Count(p => p.Status);
    var jmlNonaktif = tampil.Count - jmlAktif;

    var hasil = tampil;
    var totalHalaman = Math.Max(1, (int)Math.Ceiling(hasil.Count / (double)UkuranHalaman));

    if (halaman > totalHalaman)
        halaman = totalHalaman;

    var view = hasil.Skip((halaman - 1) * UkuranHalaman)
                    .Take(UkuranHalaman)
                    .ToList();

    var awal = hasil.Count == 0 ? 0 : (halaman - 1) * UkuranHalaman + 1;
    var akhir = awal == 0 ? 0 : awal + view.Count - 1;
}

<div class="laporan-page">

    @* ================= HEADER HALAMAN ================= *@
    <header class="page-head">
        <div>
            <h1>Daftar Pelanggan</h1>
            <p>Rekap data pelanggan beserta status keaktifannya</p>
        </div>
        <button class="btn-add" disabled="@(isLoading || tampil.Count == 0)" @onclick="Cetak">
            <i class="fa-solid fa-print"></i> Cetak
        </button>
    </header>

    @* ================= BANNER ERROR ================= *@
    <NotifBanner @bind-Pesan="PesanError" />

    @* ================= TOOLBAR: SEARCH + FILTER ================= *@
    <section class="toolbar-card">
        <label class="search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="Cari ID, Nama, kontak, atau alamat..."
                   @bind="teksCari" @bind:event="oninput" />
        </label>

        <div class="toolbar-right">
            <div class="segmented">
                <button class="@Seg(FilterStatus.Semua)" @onclick="() => UbahFilter(FilterStatus.Semua)">
                    Semua <span>@data.Count</span>
                </button>
                <button class="@Seg(FilterStatus.Aktif)" @onclick="() => UbahFilter(FilterStatus.Aktif)">
                    Aktif <span>@JumlahAktif</span>
                </button>
                <button class="@Seg(FilterStatus.NonAktif)" @onclick="() => UbahFilter(FilterStatus.NonAktif)">
                    Tidak Aktif <span>@(data.Count - JumlahAktif)</span>
                </button>
            </div>
        </div>
    </section>

    @* ================= TABEL PELANGGAN ================= *@
    <section class="panel">

        @if (isLoading)
        {
            <div class="skeleton">
                @for (var s = 0; s < 6; s++)
                {
                    <div class="sk-row">
                        <div class="sk-avatar"></div>
                        <div class="sk-lines"><div></div><div></div></div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Pelanggan</th>
                            <th>Kontak</th>
                            <th class="col-addr">Alamat</th>
                            <th class="col-date">Bergabung</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (item, i) in view.Select((item, i) => (item, i)))
                        {
                            <tr @key="item.IdPelanggan" style="--i:@Math.Min(i, 12)">
                                <td>
                                    <div class="who">
                                        <div class="avatar tone-@Warna(item.NamaPelanggan)">@Inisial(item.NamaPelanggan)</div>
                                        <div>
                                            <div class="name">@item.NamaPelanggan</div>
                                            <div class="sub">@item.IdPelanggan</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="mono">@Kosong(item.NoKontak)</td>
                                <td class="col-addr muted">@Kosong(item.Alamat)</td>
                                <td class="col-date muted">@($"{item.TglBergabung:dd MMM yyyy}")</td>
                                <td>
                                    <span class="pill @(item.Status ? "on" : "off")">
                                        <i></i>@LabelStatus(item.Status)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (tampil.Count == 0)
                {
                    <div class="empty">
                        <i class="fa-regular fa-face-frown-open"></i>
                        <strong>Pelanggan tidak ditemukan</strong>
                        <span>Tidak ada pelanggan yang cocok, coba ubah kata kunci atau filter status</span>
                    </div>
                }
            </div>

            <div class="panel-foot">
                <span>
                    Menampilkan <b>@awal–@akhir</b> dari <b>@hasil.Count</b> pelanggan
                </span>

                <div class="pager">
                    @if (halaman > 1)
                    {
                        <button class="pg-btn" @onclick="() => halaman--">
                            <i class="fa-solid fa-chevron-left"></i> Sebelumnya
                        </button>
                    }

                    <span class="pg-info">
                        Halaman <b>@halaman</b> / @totalHalaman
                    </span>

                    @if (halaman < totalHalaman)
                    {
                        <button class="pg-btn" @onclick="() => halaman++">
                            Berikutnya <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    }
                </div>
            </div>
        }
    </section>

    @* ================= DOKUMEN CETAK (tidak tampil di layar) ================= *@
    @if (!isLoading && tampil.Count > 0)
    {
        var nomor = 0;

        <div id="dokumen-cetak" class="doc">

            <header class="doc-kop">
                <img src="images/logo.png" class="doc-logo" alt="" onerror="this.style.display='none'" />
                <div class="doc-judul">
                    <h1>Daftar Pelanggan</h1>
                    <div class="doc-usaha">@NamaUsaha</div>
                    <div class="doc-alamat">@AlamatUsaha</div>
                </div>
                <div></div>
            </header>

            <hr class="doc-garis" />

            <div class="doc-meta">
                <span>Dicetak oleh: <b>@namaPencetak</b></span>
                <span>Tanggal Cetak: <b>@Tgl(DateOnly.FromDateTime(DateTime.Today))</b></span>
            </div>

            @if (filterStatus != FilterStatus.Semua || !string.IsNullOrWhiteSpace(teksCari))
            {
                <div class="doc-meta">
                    <span>
                        @if (filterStatus != FilterStatus.Semua)
                        {
                            <text>Status: <b>@LabelFilter(filterStatus)</b></text>
                        }
                        @if (!string.IsNullOrWhiteSpace(teksCari))
                        {
                            <text>@(filterStatus != FilterStatus.Semua ? " | " : "")Pencarian: <b>@teksCari</b></text>
                        }
                    </span>
                </div>
            }

            <section class="doc-blok">
                <table class="doc-tabel">
                    <colgroup>
                        <col style="width:36px" />
                        <col style="width:90px" />
                        <col style="width:130px" />
                        <col style="width:105px" />
                        <col />
                        <col style="width:72px" />
                        <col style="width:60px" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Kode Pelanggan</th>
                            <th>Nama Pelanggan</th>
                            <th>Nomor Kontak</th>
                            <th>Alamat</th>
                            <th>Tanggal<br />Bergabung</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in hasil)
                        {
                            <tr>
                                <td class="c">@(++nomor)</td>
                                <td class="c">@item.IdPelanggan</td>
                                <td>@item.NamaPelanggan</td>
                                <td class="c">@Kosong(item.NoKontak)</td>
                                <td>@Kosong(item.Alamat)</td>
                                <td class="c" style="white-space:nowrap">@Tgl(item.TglBergabung)</td>
                                <td class="c">@LabelStatus(item.Status)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        </div>
    }

</div>

@code {
    // =====================================================
    // STATE
    // =====================================================
    private static readonly CultureInfo IdCulture = new("id-ID");

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    // --- data ---
    private List<DaftarPelangganModels> data = new();

    // --- halaman ---
    private bool isLoading = true;
    private string errorMaster = "";
    private string errorLaporan = "";
    private string namaPencetak = "";
    private IJSObjectReference? modulCetak;

    // --- pagination & pencarian ---
    private const int UkuranHalaman = 10;
    private int halaman = 1;

    private string _teksCari = "";
    private string teksCari
    {
        get => _teksCari;
        set
        {
            _teksCari = value;
            halaman = 1;
        }
    }

    // --- filter status ---
    private enum FilterStatus { Semua, Aktif, NonAktif }

    private FilterStatus filterStatus = FilterStatus.Semua;

    private void UbahFilter(FilterStatus filter)
    {
        filterStatus = filter;
        halaman = 1;
    }

    private int JumlahAktif => data.Count(c => c.Status);

    // Gabungan error master + laporan; saat banner ditutup, keduanya dikosongkan
    private string PesanError
    {
        get => string.Join(" ",
            new[] { errorMaster, errorLaporan }.Where(s => !string.IsNullOrEmpty(s)));

        set
        {
            if (!string.IsNullOrEmpty(value)) return;

            errorMaster = "";
            errorLaporan = "";
        }
    }

    // =====================================================
    // LIFECYCLE & MUAT DATA
    // =====================================================
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            namaPencetak = state.User.Identity?.Name ?? "";
        }

        await MuatData();
    }

    public async ValueTask DisposeAsync()
    {
        if (modulCetak is null) return;

        try { await modulCetak.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }

    private async Task MuatData()
    {
        isLoading = true;
        errorLaporan = "";

        try
        {
            // Dimuat semua sekali, filter ditangani di sisi klien
            var (hasilApi, error) = await LaporanService.AmbilAsync("semua");

            if (hasilApi is null)
            {
                errorLaporan = $"Gagal memuat laporan pelanggan: {error.TrimEnd('.')}";
                data = new();
            }
            else
            {
                data = hasilApi;
            }
        }
        catch (Exception ex)
        {
            errorLaporan = $"Gagal memuat laporan pelanggan: {ex.Message.TrimEnd('.')}.";
            data = new();
        }

        isLoading = false;
    }

    // =====================================================
    // HELPER UMUM (format)
    // =====================================================
    private static string Tgl(DateOnly d) => d.ToString("dd/MM/yyyy", IdCulture);

    private static string Kosong(string? s)
        => string.IsNullOrWhiteSpace(s) ? "-" : s;

    private static string LabelStatus(bool aktif)
        => aktif ? "Aktif" : "Tidak Aktif";

    private static string Inisial(string? nama)
    {
        var p = (nama ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);

        return p.Length == 0 ? "?"
             : p.Length == 1 ? p[0][..1].ToUpper()
             : (p[0][..1] + p[^1][..1]).ToUpper();
    }

    // Warna avatar stabil per nama
    private static int Warna(string? nama)
        => (nama ?? "").Sum(ch => ch) % 5;

    // =====================================================
    // TAMPILAN: FILTER & PENCARIAN
    // =====================================================
    private IEnumerable<DaftarPelangganModels> Filtered => data
        .Where(c => filterStatus switch
        {
            FilterStatus.Aktif => c.Status,
            FilterStatus.NonAktif => !c.Status,
            _ => true
        })
        .Where(c => string.IsNullOrWhiteSpace(teksCari)
            || (c.IdPelanggan ?? "").Contains(teksCari, StringComparison.OrdinalIgnoreCase)
            || (c.NamaPelanggan ?? "").Contains(teksCari, StringComparison.OrdinalIgnoreCase)
            || (c.NoKontak ?? "").Contains(teksCari, StringComparison.OrdinalIgnoreCase)
            || (c.Alamat ?? "").Contains(teksCari, StringComparison.OrdinalIgnoreCase));

    private List<DaftarPelangganModels> Tampil => Filtered.ToList();

    private string Seg(FilterStatus f)
        => filterStatus == f ? "seg active" : "seg";

    private static string LabelFilter(FilterStatus f) => f switch
    {
        FilterStatus.Aktif => "Aktif",
        FilterStatus.NonAktif => "Tidak Aktif",
        _ => "Semua"
    };

    // =====================================================
    // DOKUMEN CETAK
    // =====================================================
    private string NamaUsaha => Config["Usaha:Nama"] ?? "";

    private string AlamatUsaha => Config["Usaha:Alamat"] ?? "";

    private string JudulDokumen =>
        $"Daftar Pelanggan {DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}";

    private async Task Cetak()
    {
        modulCetak ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/cetak.js");
        await modulCetak.InvokeVoidAsync("cetakElemen", "dokumen-cetak", JudulDokumen);
    }
}