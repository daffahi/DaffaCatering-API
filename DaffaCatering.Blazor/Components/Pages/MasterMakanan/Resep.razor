@page "/resep-makanan"
@attribute [Authorize(Roles = AppRoles.AdminPenjualan)]

@inject ResepService ResepService
@inject MenuMakananService MenuMakananService
@inject BahanBakuService BahanBakuService
@inject SatuanBahanBakuService SatuanBahanBakuService

@{
    var hasil = Filtered.ToList();
    var totalHalaman = Math.Max(1, (int)Math.Ceiling(hasil.Count / (double)UkuranHalaman));
    if (halaman > totalHalaman) halaman = totalHalaman;

    var view = hasil.Skip((halaman - 1) * UkuranHalaman).Take(UkuranHalaman).ToList();
    var awal = hasil.Count == 0 ? 0 : (halaman - 1) * UkuranHalaman + 1;
    var akhir = awal == 0 ? 0 : awal + view.Count - 1;
}

<div class="resep-page">

    @* ================= HEADER HALAMAN ================= *@
    <header class="page-head">
        <div>
            <h1>Resep</h1>
            <p>Kelola komposisi bahan baku untuk setiap menu</p>
        </div>
        <button class="btn-add" @onclick="BukaModalTambah">
            <i class="fa-solid fa-plus"></i> Tambah Resep
        </button>
    </header>

    @* ================= NOTIFIKASI ================= *@
    <NotifBanner Sukses @bind-Pesan="pesanSukses" />
    <NotifBanner @bind-Pesan="pesanError" />

    @* ================= TOOLBAR: SEARCH + FILTER ================= *@
    <section class="toolbar-card">
        <label class="search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="Cari ID atau menu..."
                   @bind="teksCari" @bind:event="oninput" />
        </label>

        <div class="toolbar-right">
            <div class="segmented">
                <button class="@Seg(FilterStatus.Semua)" @onclick="() => filterStatus = FilterStatus.Semua">
                    Semua <span>@daftarResep.Count</span>
                </button>
                <button class="@Seg(FilterStatus.Aktif)" @onclick="() => filterStatus = FilterStatus.Aktif">
                    Aktif <span>@JumlahAktif</span>
                </button>
                <button class="@Seg(FilterStatus.NonAktif)" @onclick="() => filterStatus = FilterStatus.NonAktif">
                    Tidak Aktif <span>@(daftarResep.Count - JumlahAktif)</span>
                </button>
            </div>
        </div>
    </section>

    @* ================= TABEL RESEP ================= *@
    <section class="panel">

        @if (isLoading)
        {
            <div class="skeleton">
                @for (var s = 0; s < 6; s++)
                {
                    <div class="sk-row">
                        <div class="sk-avatar"></div>
                        <div class="sk-lines"><div></div><div></div></div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Resep</th>
                            <th>Menu</th>
                            <th>Status</th>
                            <th class="actions">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (item, i) in view.Select((item, i) => (item, i)))
                        {
                            <tr @key="item.IdResep" style="--i:@Math.Min(i, 12)">
                                <td>
                                    <div class="who">
                                        <div class="avatar tone-@Warna(item.IdResep)">@item.IdResep[..2]</div>
                                        <div>
                                            <div class="name">@item.IdResep</div>
                                            <div class="sub">Resep</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@NamaMenu(item.IdMenu)</td>
                                <td>
                                    <span class="pill @(item.Status ? "on" : "off")">
                                        <i></i>@(item.Status ? "Aktif" : "Tidak Aktif")
                                    </span>
                                </td>
                                <td class="actions">
                                    <button class="icon-btn" title="Edit" @onclick="() => BukaModalEdit(item)">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (view.Count == 0)
                {
                    <div class="empty">
                        <i class="fa-regular fa-face-frown-open"></i>
                        <strong>Resep tidak ditemukan</strong>
                        <span>Coba ubah kata kunci atau filter pencarian.</span>
                    </div>
                }
            </div>

            <div class="panel-foot">
                <span>Menampilkan <b>@awal–@akhir</b> dari <b>@hasil.Count</b> resep</span>

                <div class="pager">
                    @if (halaman > 1)
                    {
                        <button class="pg-btn" @onclick="() => halaman--">
                            <i class="fa-solid fa-chevron-left"></i> Sebelumnya
                        </button>
                    }

                    <span class="pg-info">Halaman <b>@halaman</b> / @totalHalaman</span>

                    @if (halaman < totalHalaman)
                    {
                        <button class="pg-btn" @onclick="() => halaman++">
                            Berikutnya <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    }
                </div>
            </div>
        }
    </section>

    @* ================= MODAL FORM RESEP ================= *@
    @if (modalTampil)
    {
        <div class="overlay" @onclick="TutupModal">
            <div class="dialog wide" @onclick:stopPropagation>
                <EditForm Model="formModel" OnValidSubmit="SimpanData">
                    <DataAnnotationsValidator />

                    @* ---------- Header modal ---------- *@
                    <header class="dialog-head">
                        <div>
                            <h5>@(isEditMode ? "Ubah" : "Tambah") Resep</h5>
                            <p>@(isEditMode ? "Perbarui komposisi resep" : "Buat resep baru untuk sebuah menu")</p>
                        </div>
                        <button type="button" class="dialog-close" title="Tutup" @onclick="TutupModal">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </header>

                    <div class="dialog-body">

                        @* ---------- Data utama ---------- *@
                        <div class="row2">
                            <div class="field">
                                <label>ID Resep <small>(otomatis)</small></label>
                                <input value="@formModel.IdResep" disabled />
                            </div>
                            <div class="field">
                                <label>Menu <b class="req">*</b></label>
                                <InputSelect @bind-Value="formModel.IdMenu">
                                    <option value="">Pilih menu</option>
                                    @foreach (var m in daftarMenu)
                                    {
                                        <option value="@m.IdMenu">@m.NamaMenu</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => formModel.IdMenu" />
                            </div>
                        </div>

                        <div class="status-row">
                            <span class="status-label">Status</span>
                            <label class="switch">
                                <span class="status-value">@(formModel.Status ? "Aktif" : "Tidak Aktif")</span>
                                <InputCheckbox @bind-Value="formModel.Status" />
                                <span class="sw-track"></span>
                            </label>
                        </div>

                        @* ---------- Komposisi bahan baku ---------- *@
                        <div class="section-head">
                            <h6>Komposisi Bahan Baku</h6>
                            <span class="count-tag">@formModel.Details.Count item</span>
                        </div>

                        <div class="detail-form @(editingIndex >= 0 ? "editing" : "")">
                            <div class="add-item-grid">
                                <div class="field">
                                    <label>Bahan Baku <b class="req">*</b></label>
                                    <select @bind="pilihBahanBaku">
                                        <option value="">Pilih bahan baku</option>
                                        @foreach (var b in daftarBahanBaku)
                                        {
                                            <option value="@b.IdBahanBaku">@b.NamaBahanBaku</option>
                                        }
                                    </select>
                                </div>
                                <div class="field">
                                    <label>Satuan <b class="req">*</b></label>
                                    <select @bind="pilihSatuan">
                                        <option value="">Pilih satuan</option>
                                        @foreach (var s in daftarSatuan)
                                        {
                                            <option value="@s.IdSatuan">@s.NamaSatuan</option>
                                        }
                                    </select>
                                </div>
                                <div class="field">
                                    <label>Jumlah <b class="req">*</b></label>
                                    <input type="number" step="0.01" min="0" placeholder="0" @bind="inputJumlah" />
                                </div>
                            </div>

                            <NotifBanner @bind-Pesan="itemError" />

                            <div class="detail-actions">
                                @if (editingIndex >= 0)
                                {
                                    <button type="button" class="btn-mini" @onclick="ResetStagingItem">Batal Ubah</button>
                                }
                                <button type="button" class="btn-mini solid" @onclick="TambahDetail">
                                    <i class="fa-solid @(editingIndex >= 0 ? "fa-check" : "fa-plus")"></i>
                                    @(editingIndex >= 0 ? "Perbarui Item" : "Tambah Item")
                                </button>
                            </div>
                        </div>

                        <div class="detail-wrap">
                            <table class="detail-table">
                                <thead>
                                    <tr>
                                        <th>Bahan Baku</th>
                                        <th>Satuan</th>
                                        <th>Jumlah</th>
                                        <th class="actions">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < formModel.Details.Count; i++)
                                    {
                                        var index = i;
                                        var d = formModel.Details[index];
                                        <tr class="@(index == editingIndex ? "row-edit" : "")">
                                            <td>@NamaBahanBaku(d.IdBahanBaku)</td>
                                            <td>@NamaSatuan(d.IdSatuan)</td>
                                            <td class="mono">@d.Jumlah.ToString("0.##")</td>
                                            <td class="actions">
                                                <button type="button" class="icon-btn" title="Ubah item"
                                                        @onclick="() => EditDetail(index)">
                                                    <i class="fa-solid fa-pen"></i>
                                                </button>
                                                <button type="button" class="icon-btn danger" title="Hapus item"
                                                        @onclick="() => HapusDetail(index)">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            @if (formModel.Details.Count == 0)
                            {
                                <div class="detail-empty">Belum ada bahan baku ditambahkan</div>
                            }
                        </div>

                        <NotifBanner @bind-Pesan="modalError" />
                    </div>

                    @* ---------- Footer modal ---------- *@
                    <footer class="dialog-foot">
                        <button type="button" class="btn-ghost" @onclick="TutupModal">Batalkan</button>
                        <button type="submit" class="btn-solid" disabled="@sedangSimpan">
                            @if (sedangSimpan)
                            {
                                <i class="fa-solid fa-spinner fa-spin"></i> <span>Menyimpan...</span>
                            }
                            else
                            {
                                <span>Simpan</span>
                            }
                        </button>
                    </footer>
                </EditForm>
            </div>
        </div>
    }

</div>

@code {
    // =====================================================
    // STATE
    // =====================================================
    private enum FilterStatus { Semua, Aktif, NonAktif }

    // --- data ---
    private List<ResepModel> daftarResep = new();
    private List<MenuMakananModels> daftarMenu = new();
    private List<BahanBakuModels> daftarBahanBaku = new();
    private List<SatuanBahanBakuModels> daftarSatuan = new();

    // --- halaman utama ---
    private bool isLoading = true;
    private string pesanSukses = "";
    private string pesanError = "";

    // --- pagination, pencarian & filter ---
    private const int UkuranHalaman = 10;
    private int halaman = 1;

    private string _teksCari = "";
    private string teksCari
    {
        get => _teksCari;
        set { _teksCari = value; halaman = 1; }
    }

    private FilterStatus _filterStatus = FilterStatus.Semua;
    private FilterStatus filterStatus
    {
        get => _filterStatus;
        set { _filterStatus = value; halaman = 1; }
    }

    // --- modal form ---
    private bool modalTampil = false;
    private bool isEditMode = false;
    private bool sedangSimpan = false;
    private string modalError = "";
    private ResepModel formModel = new();

    // --- input komposisi ---
    private string pilihBahanBaku = "";
    private string pilihSatuan = "";
    private decimal? inputJumlah;
    private int editingIndex = -1;          // -1 = tambah item, >= 0 = ubah item
    private string itemError = "";

    // =====================================================
    // LIFECYCLE & MUAT DATA
    // =====================================================
    protected override async Task OnInitializedAsync()
    {
        await MuatData();
    }

    private async Task MuatData()
    {
        isLoading = true;
        var galat = new List<string>();

        try { daftarResep = await ResepService.GetAllAsync(); }
        catch (Exception ex) { galat.Add($"Gagal memuat resep: {ex.Message.TrimEnd('.')}."); }

        try { daftarMenu = await MenuMakananService.GetAllAsync(); }
        catch (Exception ex) { galat.Add($"Gagal memuat menu makanan: {ex.Message.TrimEnd('.')}."); }

        try { daftarBahanBaku = await BahanBakuService.GetAllAsync(); }
        catch (Exception ex) { galat.Add($"Gagal memuat bahan baku: {ex.Message.TrimEnd('.')}."); }

        try { daftarSatuan = await SatuanBahanBakuService.GetAllAsync(); }
        catch (Exception ex) { galat.Add($"Gagal memuat satuan bahan baku: {ex.Message.TrimEnd('.')}."); }

        pesanError = string.Join(" ", galat);
        isLoading = false;
    }

    // =====================================================
    // HELPER UMUM (lookup nama)
    // =====================================================
    // Warna avatar stabil per teks (string.GetHashCode() berubah tiap proses, jadi tidak dipakai)
    private static int Warna(string? teks) => (teks ?? "").Sum(ch => ch) % 5;

    private string NamaMenu(string? id)
        => daftarMenu.FirstOrDefault(m => m.IdMenu == id)?.NamaMenu ?? (id ?? "-");

    private string NamaBahanBaku(string? id)
        => daftarBahanBaku.FirstOrDefault(b => b.IdBahanBaku == id)?.NamaBahanBaku ?? (id ?? "-");

    private string NamaSatuan(string? id)
        => daftarSatuan.FirstOrDefault(s => s.IdSatuan == id)?.NamaSatuan ?? (id ?? "-");

    // =====================================================
    // DAFTAR: FILTER & PENCARIAN
    // =====================================================
    private int JumlahAktif => daftarResep.Count(c => c.Status);

    private IEnumerable<ResepModel> Filtered => daftarResep
        .Where(c => filterStatus switch
        {
            FilterStatus.Aktif => c.Status,
            FilterStatus.NonAktif => !c.Status,
            _ => true
        })
        .Where(c => string.IsNullOrWhiteSpace(teksCari)
            || (c.IdResep ?? "").Contains(teksCari, StringComparison.OrdinalIgnoreCase)
            || NamaMenu(c.IdMenu).Contains(teksCari, StringComparison.OrdinalIgnoreCase));

    private string Seg(FilterStatus f) => filterStatus == f ? "seg active" : "seg";

    // =====================================================
    // MODAL FORM: BUKA / TUTUP
    // =====================================================
    // ID otomatis: RS + 7 digit
    private static string BuatIdBerikutnya(IEnumerable<ResepModel> data)
    {
        const string prefix = "RS";

        var max = data
            .Select(c => c.IdResep)
            .Where(id => !string.IsNullOrEmpty(id)
                         && id.StartsWith(prefix)
                         && int.TryParse(id[prefix.Length..], out _))
            .Select(id => int.Parse(id[prefix.Length..]))
            .DefaultIfEmpty(0)
            .Max();

        return $"{prefix}{max + 1:D7}";
    }

    private async Task BukaModalTambah()
    {
        pesanSukses = "";
        formModel = new ResepModel { Status = true };
        isEditMode = false;
        modalError = "";
        ResetStagingItem();

        try
        {
            // data terbaru supaya nomor urut tidak basi
            var terbaru = await ResepService.GetAllAsync();
            formModel.IdResep = BuatIdBerikutnya(terbaru);
        }
        catch (Exception ex)
        {
            pesanError = $"Gagal menghasilkan ID: {ex.Message.TrimEnd('.')}.";
            return;
        }

        modalTampil = true;
    }

    private async Task BukaModalEdit(ResepModel item)
    {
        pesanSukses = "";
        pesanError = "";
        modalError = "";
        ResetStagingItem();

        // daftar tidak membawa Details, jadi ambil ulang data lengkapnya
        var lengkap = await ResepService.GetByIdAsync(item.IdResep);
        if (lengkap == null)
        {
            pesanError = "Gagal memuat detail resep.";
            return;
        }

        formModel = lengkap;
        isEditMode = true;
        modalTampil = true;
    }

    private void TutupModal()
    {
        modalTampil = false;
    }

    // =====================================================
    // MODAL FORM: KOMPOSISI BAHAN BAKU
    // =====================================================
    private void ResetStagingItem()
    {
        pilihBahanBaku = "";
        pilihSatuan = "";
        inputJumlah = null;
        editingIndex = -1;
        itemError = "";
    }

    private void EditDetail(int idx)
    {
        var d = formModel.Details[idx];

        pilihBahanBaku = d.IdBahanBaku;
        pilihSatuan = d.IdSatuan;
        inputJumlah = d.Jumlah;
        editingIndex = idx;
        itemError = "";
    }

    private void TambahDetail()
    {
        itemError = "";

        if (string.IsNullOrEmpty(pilihBahanBaku))
        {
            itemError = "Pilih bahan baku terlebih dahulu.";
            return;
        }

        if (string.IsNullOrEmpty(pilihSatuan))
        {
            itemError = "Pilih satuan bahan baku.";
            return;
        }

        if (inputJumlah is not > 0)
        {
            itemError = "Jumlah harus lebih dari 0.";
            return;
        }

        // duplikat = bahan baku yang sama (kecuali baris yang sedang diubah)
        var duplikat = formModel.Details
            .Where((d, idx) => idx != editingIndex)
            .Any(d => d.IdBahanBaku == pilihBahanBaku);

        if (duplikat)
        {
            itemError = $"Bahan baku {NamaBahanBaku(pilihBahanBaku)} sudah ada dalam resep.";
            return;
        }

        var item = new DetailResepModel
        {
            IdBahanBaku = pilihBahanBaku,
            IdSatuan = pilihSatuan,
            Jumlah = inputJumlah.Value
        };

        if (editingIndex == -1) formModel.Details.Add(item);    // TAMBAH ITEM
        else formModel.Details[editingIndex] = item;            // UBAH ITEM

        ResetStagingItem();
    }

    private void HapusDetail(int idx)
    {
        formModel.Details.RemoveAt(idx);

        if (editingIndex == idx) ResetStagingItem();
        else if (editingIndex > idx) editingIndex--;
    }

    // =====================================================
    // MODAL FORM: SIMPAN
    // =====================================================
    private async Task SimpanData()
    {
        modalError = "";

        if (formModel.Details.Count == 0)
        {
            modalError = "Resep harus memiliki minimal 1 bahan baku.";
            return;
        }

        sedangSimpan = true;

        var (success, error) = isEditMode
            ? await ResepService.UpdateAsync(formModel.IdResep, formModel)
            : await ResepService.CreateAsync(formModel);

        if (success)
        {
            pesanSukses = $"Resep menu {NamaMenu(formModel.IdMenu)} dengan kode {formModel.IdResep} "
                        + (isEditMode ? "berhasil diperbarui." : "berhasil ditambahkan.");
            modalTampil = false;
            await MuatData();
        }
        else
        {
            modalError = error;
        }

        sedangSimpan = false;
    }
}