@page "/menu-makanan"
@attribute [Authorize(Roles = AppRoles.AdminPenjualan)]

@using System.Globalization
@inject MenuMakananService MenuMakananService
@inject SatuanBahanBakuService SatuanBahanBakuService

@{
    var hasil = Filtered.ToList();
    var totalHalaman = Math.Max(1, (int)Math.Ceiling(hasil.Count / (double)UkuranHalaman));
    if (halaman > totalHalaman) halaman = totalHalaman;

    var view = hasil.Skip((halaman - 1) * UkuranHalaman).Take(UkuranHalaman).ToList();
    var awal = hasil.Count == 0 ? 0 : (halaman - 1) * UkuranHalaman + 1;
    var akhir = awal == 0 ? 0 : awal + view.Count - 1;
}

<div class="menu-makanan-page">

    @* ================= HEADER HALAMAN ================= *@
    <header class="page-head">
        <div>
            <h1>Menu Makanan</h1>
            <p>Kelola data menu makanan dalam satu tempat</p>
        </div>
        <button class="btn-add" @onclick="BukaModalTambah">
            <i class="fa-solid fa-plus"></i> Tambah Menu Makanan
        </button>
    </header>

    @* ================= NOTIFIKASI ================= *@
    <NotifBanner Sukses @bind-Pesan="pesanSukses" />
    <NotifBanner @bind-Pesan="pesanError" />

    @* ================= TOOLBAR: SEARCH + FILTER ================= *@
    <section class="toolbar-card">
        <label class="search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="Cari ID atau menu..."
                   @bind="teksCari" @bind:event="oninput" />
        </label>

        <div class="toolbar-right">
            <div class="segmented">
                <button class="@Seg(FilterStatus.Semua)" @onclick="() => filterStatus = FilterStatus.Semua">
                    Semua <span>@daftarMenuMakanan.Count</span>
                </button>
                <button class="@Seg(FilterStatus.Aktif)" @onclick="() => filterStatus = FilterStatus.Aktif">
                    Aktif <span>@JumlahAktif</span>
                </button>
                <button class="@Seg(FilterStatus.NonAktif)" @onclick="() => filterStatus = FilterStatus.NonAktif">
                    Tidak Aktif <span>@(daftarMenuMakanan.Count - JumlahAktif)</span>
                </button>
            </div>
        </div>
    </section>

    @* ================= TABEL MENU MAKANAN ================= *@
    <section class="panel">

        @if (isLoading)
        {
            <div class="skeleton">
                @for (var s = 0; s < 6; s++)
                {
                    <div class="sk-row">
                        <div class="sk-avatar"></div>
                        <div class="sk-lines"><div></div><div></div></div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Menu Makanan</th>
                            <th>Satuan</th>
                            <th>Jumlah</th>
                            <th>Harga</th>
                            <th>Status</th>
                            <th class="actions">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (item, i) in view.Select((item, i) => (item, i)))
                        {
                            <tr @key="item.IdMenu" style="--i:@Math.Min(i, 12)">
                                <td>
                                    <div class="who">
                                        <div class="avatar tone-@Warna(item.NamaMenu)">@Inisial(item.NamaMenu)</div>
                                        <div>
                                            <div class="name">@item.NamaMenu</div>
                                            <div class="sub">@item.IdMenu</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="mono">@NamaSatuan(item.IdSatuan)</td>
                                <td class="mono">@item.Jumlah</td>
                                <td class="mono">@item.Harga.ToString("C0", IdCulture)</td>
                                <td>
                                    <span class="pill @(item.Status ? "on" : "off")">
                                        <i></i>@(item.Status ? "Aktif" : "Tidak Aktif")
                                    </span>
                                </td>
                                <td class="actions">
                                    <button class="icon-btn" title="Edit" @onclick="() => BukaModalEdit(item)">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (view.Count == 0)
                {
                    <div class="empty">
                        <i class="fa-regular fa-face-frown-open"></i>
                        <strong>Menu Makanan tidak ditemukan</strong>
                        <span>Coba ubah kata kunci atau filter pencarian.</span>
                    </div>
                }
            </div>

            <div class="panel-foot">
                <span>Menampilkan <b>@awal–@akhir</b> dari <b>@hasil.Count</b> menu makanan</span>

                <div class="pager">
                    @if (halaman > 1)
                    {
                        <button class="pg-btn" @onclick="() => halaman--">
                            <i class="fa-solid fa-chevron-left"></i> Sebelumnya
                        </button>
                    }

                    <span class="pg-info">Halaman <b>@halaman</b> / @totalHalaman</span>

                    @if (halaman < totalHalaman)
                    {
                        <button class="pg-btn" @onclick="() => halaman++">
                            Berikutnya <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    }
                </div>
            </div>
        }
    </section>

    @* ================= MODAL FORM MENU MAKANAN ================= *@
    @if (modalTampil)
    {
        <div class="overlay" @onclick="TutupModal">
            <div class="dialog" @onclick:stopPropagation>
                <EditForm Model="formModel" OnValidSubmit="SimpanData">
                    <DataAnnotationsValidator />

                    @* ---------- Header modal ---------- *@
                    <header class="dialog-head">
                        <div>
                            <h5>@(isEditMode ? "Ubah" : "Tambah") Menu Makanan</h5>
                            <p>@(isEditMode ? "Perbarui data menu makanan" : "Isi data menu makanan baru")</p>
                        </div>
                        <button type="button" class="dialog-close" title="Tutup" @onclick="TutupModal">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </header>

                    <div class="dialog-body">

                        @* ---------- Data utama ---------- *@
                        <div class="row2">
                            <div class="field">
                                <label>ID Menu <small>(otomatis)</small></label>
                                <input value="@formModel.IdMenu" disabled />
                            </div>
                            <div class="field">
                                <label>Satuan <b class="req">*</b></label>
                                <InputSelect @bind-Value="formModel.IdSatuan">
                                    <option value="">Pilih Satuan</option>
                                    @foreach (var s in daftarSatuan)
                                    {
                                        <option value="@s.IdSatuan">@s.NamaSatuan</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => formModel.IdSatuan" />
                            </div>
                        </div>

                        <div class="field">
                            <label>Nama Menu <b class="req">*</b></label>
                            <InputText @bind-Value="formModel.NamaMenu" @onblur="KapitalisasiNamaMenu" />
                            <ValidationMessage For="() => formModel.NamaMenu" />
                        </div>

                        <div class="row2">
                            <div class="field">
                                <label>Jumlah</label>
                                <input value="1" disabled />
                            </div>
                            <div class="field">
                                <label>Harga <b class="req">*</b></label>
                                <InputNumber @bind-Value="formModel.Harga" step="1" />
                                <ValidationMessage For="() => formModel.Harga" />
                            </div>
                        </div>

                        <div class="status-row">
                            <span class="status-label">Status</span>
                            <label class="switch">
                                <span class="status-value">@(formModel.Status ? "Aktif" : "Tidak Aktif")</span>
                                <InputCheckbox @bind-Value="formModel.Status" />
                                <span class="sw-track"></span>
                            </label>
                        </div>

                        <NotifBanner @bind-Pesan="modalError" />
                    </div>

                    @* ---------- Footer modal ---------- *@
                    <footer class="dialog-foot">
                        <button type="button" class="btn-ghost" @onclick="TutupModal">Batalkan</button>
                        <button type="submit" class="btn-solid" disabled="@sedangSimpan">
                            @if (sedangSimpan)
                            {
                                <i class="fa-solid fa-spinner fa-spin"></i> <span>Menyimpan...</span>
                            }
                            else
                            {
                                <span>Simpan</span>
                            }
                        </button>
                    </footer>
                </EditForm>
            </div>
        </div>
    }

</div>

@code {
    // =====================================================
    // STATE
    // =====================================================
    private enum FilterStatus { Semua, Aktif, NonAktif }
    private static readonly CultureInfo IdCulture = new("id-ID");

    // --- data ---
    private List<MenuMakananModels> daftarMenuMakanan = new();
    private List<SatuanBahanBakuModels> daftarSatuan = new();

    // --- halaman utama ---
    private bool isLoading = true;
    private string pesanSukses = "";
    private string pesanError = "";

    // --- pagination, pencarian & filter ---
    private const int UkuranHalaman = 10;
    private int halaman = 1;

    private string _teksCari = "";
    private string teksCari
    {
        get => _teksCari;
        set { _teksCari = value; halaman = 1; }
    }

    private FilterStatus _filterStatus = FilterStatus.Semua;
    private FilterStatus filterStatus
    {
        get => _filterStatus;
        set { _filterStatus = value; halaman = 1; }
    }

    // --- modal form ---
    private bool modalTampil = false;
    private bool isEditMode = false;
    private bool sedangSimpan = false;
    private string modalError = "";
    private MenuMakananModels formModel = new();

    // =====================================================
    // LIFECYCLE & MUAT DATA
    // =====================================================
    protected override async Task OnInitializedAsync()
    {
        await MuatData();
    }

    private async Task MuatData()
    {
        isLoading = true;
        var galat = new List<string>();

        try { daftarMenuMakanan = await MenuMakananService.GetAllAsync(); }
        catch (Exception ex) { galat.Add($"Gagal memuat menu makanan: {ex.Message.TrimEnd('.')}."); }

        try
        {
            // hanya satuan jadi yang boleh dipakai untuk menu
            var diizinkan = new[] { "Bungkus", "Pcs", "Porsi" };
            var semua = await SatuanBahanBakuService.GetAllAsync();
            daftarSatuan = semua.Where(s => diizinkan.Contains(s.NamaSatuan)).ToList();
        }
        catch (Exception ex) { galat.Add($"Gagal memuat satuan bahan baku: {ex.Message.TrimEnd('.')}."); }

        pesanError = string.Join(" ", galat);
        isLoading = false;
    }

    // =====================================================
    // HELPER UMUM (format & lookup)
    // =====================================================
    private static string Inisial(string? nama)
    {
        var p = (nama ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length == 0 ? "?"
             : p.Length == 1 ? p[0][..1].ToUpper()
             : (p[0][..1] + p[^1][..1]).ToUpper();
    }

    // Warna avatar stabil per nama (string.GetHashCode() berubah tiap proses, jadi tidak dipakai)
    private static int Warna(string? nama) => (nama ?? "").Sum(ch => ch) % 5;

    private string NamaSatuan(string? id)
        => daftarSatuan.FirstOrDefault(s => s.IdSatuan == id)?.NamaSatuan ?? (id ?? "-");

    // =====================================================
    // DAFTAR: FILTER & PENCARIAN
    // =====================================================
    private int JumlahAktif => daftarMenuMakanan.Count(c => c.Status);

    private IEnumerable<MenuMakananModels> Filtered => daftarMenuMakanan
        .Where(c => filterStatus switch
        {
            FilterStatus.Aktif => c.Status,
            FilterStatus.NonAktif => !c.Status,
            _ => true
        })
        .Where(c => string.IsNullOrWhiteSpace(teksCari)
            || (c.IdMenu ?? "").Contains(teksCari, StringComparison.OrdinalIgnoreCase)
            || (c.NamaMenu ?? "").Contains(teksCari, StringComparison.OrdinalIgnoreCase));

    private string Seg(FilterStatus f) => filterStatus == f ? "seg active" : "seg";

    // =====================================================
    // MODAL FORM: BUKA / TUTUP
    // =====================================================
    // ID otomatis: MN + 7 digit
    private static string BuatIdBerikutnya(IEnumerable<MenuMakananModels> data)
    {
        const string prefix = "MN";

        var max = data
            .Select(c => c.IdMenu)
            .Where(id => !string.IsNullOrEmpty(id)
                         && id.StartsWith(prefix)
                         && int.TryParse(id[prefix.Length..], out _))
            .Select(id => int.Parse(id[prefix.Length..]))
            .DefaultIfEmpty(0)
            .Max();

        return $"{prefix}{max + 1:D7}";
    }

    private async Task BukaModalTambah()
    {
        pesanSukses = "";
        formModel = new MenuMakananModels { Status = true, Jumlah = 1 };
        isEditMode = false;
        modalError = "";

        try
        {
            // data terbaru supaya nomor urut tidak basi
            var terbaru = await MenuMakananService.GetAllAsync();
            formModel.IdMenu = BuatIdBerikutnya(terbaru);
        }
        catch (Exception ex)
        {
            pesanError = $"Gagal menghasilkan ID: {ex.Message.TrimEnd('.')}.";
            return;
        }

        modalTampil = true;
    }

    private void BukaModalEdit(MenuMakananModels item)
    {
        pesanSukses = "";
        formModel = new MenuMakananModels
        {
            IdMenu = item.IdMenu,
            IdSatuan = item.IdSatuan,
            NamaMenu = item.NamaMenu,
            Jumlah = item.Jumlah,
            Harga = Math.Round(item.Harga, 0),
            Status = item.Status
        };
        isEditMode = true;
        modalError = "";
        modalTampil = true;
    }

    private void TutupModal()
    {
        modalTampil = false;
    }

    // =====================================================
    // MODAL FORM: VALIDASI & SIMPAN
    // =====================================================
    private void KapitalisasiNamaMenu()
    {
        if (!string.IsNullOrEmpty(formModel.NamaMenu))
        {
            formModel.NamaMenu = char.ToUpper(formModel.NamaMenu[0]) + formModel.NamaMenu[1..];
        }
    }

    private bool NamaMenuSudahAda()
        => daftarMenuMakanan.Any(m =>
            m.IdMenu != formModel.IdMenu
            && m.NamaMenu.Trim().Equals(formModel.NamaMenu.Trim(), StringComparison.OrdinalIgnoreCase));

    private async Task SimpanData()
    {
        modalError = "";

        if (NamaMenuSudahAda())
        {
            modalError = $"Nama menu \"{formModel.NamaMenu}\" sudah terdaftar";
            return;
        }

        sedangSimpan = true;
        formModel.Jumlah = 1;
        formModel.Harga = Math.Round(formModel.Harga, 0);

        var (success, error) = isEditMode
            ? await MenuMakananService.UpdateAsync(formModel.IdMenu, formModel)
            : await MenuMakananService.CreateAsync(formModel);

        if (success)
        {
            pesanSukses = $"Menu makanan {formModel.NamaMenu} dengan kode {formModel.IdMenu} "
                        + (isEditMode ? "berhasil diperbarui." : "berhasil ditambahkan.");
            modalTampil = false;
            await MuatData();
        }
        else
        {
            modalError = error;
        }

        sedangSimpan = false;
    }
}