@page "/"
@attribute [Authorize]

@using System.Globalization
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Security.Claims
@using System.Text.Json
@using DaffaCatering.Blazor.Models.Pembelian
@using DaffaCatering.Blazor.Services
@using DaffaCatering.Blazor.Services.Pembelian

@inject IHttpClientFactory HttpClientFactory
@inject JwtAuthStateProvider AuthStateProvider
@inject LaporanPenjualanService LaporanService
@inject LaporanPembelianService LaporanPembelian
@inject PelangganService PelangganService
@inject PemasokService PemasokService

<PageTitle>Daffa Catering</PageTitle>

<div class="dashboard-page">

    @* ================= 1. BANNER ================= *@
    <section class="welcome-banner">
        <AuthorizeView>
            <h1>Selamat datang kembali, @context.User.Identity?.Name</h1>
        </AuthorizeView>
        <p>@hariIni.ToString("dddd, dd MMMM yyyy", IdCulture)</p>
    </section>

    @if (!string.IsNullOrEmpty(pesanError))
    {
        <p class="galat">@pesanError</p>
    }

    @if (isLoading)
    {
        <p class="memuat">Memuat ringkasan...</p>
    }
    else if (!bolehPenjualan && !bolehPembelian && !bolehStok)
    {
        <p class="memuat">Belum ada ringkasan untuk peran Anda. Pakai menu di samping untuk mulai bekerja.</p>
    }
    else
    {
        @if (bolehPenjualan)
        {
            @* ================= 2. KARTU ANGKA ================= *@
            <section class="kpi">
                <div class="kartu">
                    <div class="kartu-atas">
                        <span class="kartu-label">Penjualan bulan ini</span>
                        @if (deltaPersen is { } d && d != 0)
                        {
                            <span class="badge @(d > 0 ? "naik" : "turun")">
                                @(d > 0 ? "+" : "-")@Math.Abs(d).ToString("0.#", IdCulture)%
                            </span>
                        }
                    </div>
                    <div class="kartu-nilai">@FormatRupiah(nilaiBulanIni)</div>
                    <div class="kartu-ket">Dibanding periode sama bulan lalu</div>
                </div>

                <div class="kartu">
                    <div class="kartu-atas">
                        <span class="kartu-label">Transaksi bulan ini</span>
                    </div>
                    <div class="kartu-nilai">@jmlTransaksiBulanIni</div>
                </div>

                <div class="kartu">
                    <div class="kartu-atas">
                        <span class="kartu-label">Pesanan hari ini</span>
                    </div>
                    <div class="kartu-nilai">@jmlHariIni</div>
                </div>

                <div class="kartu">
                    <div class="kartu-atas">
                        <span class="kartu-label">Rata-rata per transaksi</span>
                    </div>
                    <div class="kartu-nilai">@FormatRupiah(rataTransaksi)</div>
                </div>
            </section>
        }

        @* ================= 3. KARTU RINGKASAN ================= *@
        <section class="ringkasan">
            @if (bolehPenjualan)
            {
                <div class="kartu lebar">
                    <div class="kartu-label">Pesanan menunggu</div>
                    <div class="kartu-nilai">@jmlPending</div>
                    <div class="garis"></div>
                    <div class="sub-label">Total nilai</div>
                    <div class="sub-nilai">@FormatRupiah(nilaiPending)</div>
                    @if (jmlTelat > 0)
                    {
                        <div class="kartu-ket telat">@jmlTelat pesanan sudah lewat tanggalnya</div>
                    }
                </div>
            }

            @if (bolehPembelian)
            {
                <div class="kartu lebar">
                    <div class="kartu-label">Pembelian belum diterima</div>
                    <div class="kartu-nilai">@jmlBelumDiterima</div>
                    <div class="garis"></div>
                    <div class="sub-label">Pembelian bulan ini</div>
                    <div class="sub-nilai">@FormatRupiah(nilaiPembelianBulanIni)</div>
                    @if (jmlBelumDiterima > 0)
                    {
                        <div class="kartu-ket">Belum diterima senilai @FormatRupiah(nilaiBelumDiterima)</div>
                    }
                </div>
            }

            @if (bolehStok)
            {
                <div class="kartu lebar">
                    <div class="kartu-label">Stok menipis</div>
                    <div class="kartu-nilai">@jmlStokMenipis</div>
                    <div class="garis"></div>
                    <div class="sub-label">Segera kadaluwarsa (@HariPeringatan hari ke depan)</div>
                    <div class="sub-nilai @(jmlSudahKadaluwarsa > 0 ? "telat" : "")">@jmlKadaluwarsa batch</div>
                    @if (jmlSudahKadaluwarsa > 0)
                    {
                        <div class="kartu-ket telat">@jmlSudahKadaluwarsa batch sudah kadaluwarsa</div>
                    }
                </div>
            }
        </section>

        @* ================= 4. DAFTAR & AKSES CEPAT ================= *@
        <section class="dash-body">

            @if (bolehPenjualan || bolehPembelian)
            {
                <div class="kolom">

                    @if (bolehPenjualan)
                    {
                        <div class="panel">
                            <div class="panel-kepala">
                                <h2>Pesanan menunggu</h2>
                                <a href="/pesanan-penjualan">Lihat semua</a>
                            </div>

                            @if (pesananPending.Count == 0)
                            {
                                <p class="kosong">Tidak ada pesanan yang menunggu.</p>
                            }
                            else
                            {
                                <ul class="pesanan-list">
                                    @foreach (var p in pesananPending)
                                    {
                                        var tglAmbil = TglAmbil(p.Trx);
                                        var telat = tglAmbil < hariIni;

                                        <li class="pesanan @(telat ? "telat" : "")">
                                            <div class="p-waktu">
                                                <strong>@Selisih(tglAmbil)</strong>
                                                <span>@tglAmbil.ToString("dd MMM yyyy", IdCulture)</span>
                                            </div>
                                            <div class="p-siapa">
                                                <strong>@NamaPelanggan(p.IdPelanggan)</strong>
                                                <span>@p.Trx.IdTransaksi</span>
                                            </div>
                                            <div class="p-total">@FormatRupiah(p.Trx.TotalTransaksi)</div>
                                        </li>
                                    }
                                </ul>

                                @if (jmlPending > pesananPending.Count)
                                {
                                    <p class="sisa">@(jmlPending - pesananPending.Count) pesanan lainnya tidak ditampilkan.</p>
                                }
                            }
                        </div>
                    }

                    @if (bolehPembelian)
                    {
                        <div class="panel">
                            <div class="panel-kepala">
                                <h2>Pembelian belum diterima</h2>
                                <a href="/pembelian-bahan-baku">Lihat semua</a>
                            </div>

                            @if (pembelianMenunggu.Count == 0)
                            {
                                <p class="kosong">Semua pembelian sudah diterima.</p>
                            }
                            else
                            {
                                <ul class="pesanan-list">
                                    @foreach (var p in pembelianMenunggu)
                                    {
                                        <li class="pesanan">
                                            <div class="p-waktu">
                                                <strong>@LamaMenunggu(p.Trx.Tanggal)</strong>
                                                <span>@p.Trx.Tanggal.ToString("dd MMM yyyy", IdCulture)</span>
                                            </div>
                                            <div class="p-siapa">
                                                <strong>@NamaPemasok(p.IdPemasok)</strong>
                                                <span>@p.Trx.IdTransaksi</span>
                                            </div>
                                            <div class="p-total">@FormatRupiah(p.Trx.TotalTransaksi)</div>
                                        </li>
                                    }
                                </ul>

                                @if (jmlBelumDiterima > pembelianMenunggu.Count)
                                {
                                    <p class="sisa">@(jmlBelumDiterima - pembelianMenunggu.Count) pembelian lainnya tidak ditampilkan.</p>
                                }
                            }
                        </div>
                    }

                </div>
            }

            <div class="panel">
                <div class="panel-kepala">
                    <h2>Akses cepat</h2>
                </div>

                <div class="aksi-list">
                    @if (bolehPenjualan)
                    {
                        <a class="aksi utama" href="/pesanan-penjualan">Buat pesanan</a>
                        <a class="aksi" href="/penjualan">Catat penjualan</a>
                    }
                    @if (bolehPembelian)
                    {
                        <a class="aksi @(bolehPenjualan ? "" : "utama")" href="/pembelian-bahan-baku">Buat pembelian</a>
                        <a class="aksi" href="/penerimaan-bahan-baku">Penerimaan bahan baku</a>
                    }
                    @if (bolehStok)
                    {
                        <a class="aksi @(bolehPenjualan || bolehPembelian ? "" : "utama")" href="/penggunaan-bahan-baku">Penggunaan bahan baku</a>
                        <a class="aksi" href="/penyesuaian-bahan-baku">Penyesuaian bahan baku</a>
                    }
                </div>
            </div>

        </section>
    }

</div>

@code {

    private static readonly CultureInfo IdCulture = new("id-ID");
    private const decimal BatasStok = NotifikasiService.BatasStok;
    private const int HariPeringatan = NotifikasiService.HariKadaluwarsa; // batas peringatan kadaluwarsa
    private const int RentangPembelian = 90;        // berapa hari ke belakang pembelian dicek
    private const string StatusMenunggu = "Pending"; // status pembelian yang belum diterima

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    // --- halaman ---
    private bool isLoading = true;
    private bool bolehPenjualan;
    private bool bolehPembelian;
    private bool bolehStok;
    private string pesanError = "";
    private DateOnly hariIni;

    // --- master, hanya untuk menampilkan nama ---
    private List<PelangganModels> daftarPelanggan = new();
    private List<PemasokModels> daftarPemasok = new();

    // --- penjualan ---
    private decimal nilaiBulanIni;
    private int jmlTransaksiBulanIni;
    private decimal rataTransaksi;
    private decimal? deltaPersen;

    // --- pesanan ---
    private int jmlPending;
    private int jmlTelat;
    private int jmlHariIni;
    private decimal nilaiPending;
    private List<(string IdPelanggan, LaporanBaris Trx)> pesananPending = new();

    // --- pembelian ---
    private decimal nilaiPembelianBulanIni;
    private int jmlBelumDiterima;
    private decimal nilaiBelumDiterima;
    private List<(string IdPemasok, LaporanPembelianBaris Trx)> pembelianMenunggu = new();

    // --- stok ---
    private int jmlStokMenipis;
    private int jmlKadaluwarsa;
    private int jmlSudahKadaluwarsa;

    // =====================================================
    // LIFECYCLE
    // =====================================================
    protected override async Task OnInitializedAsync()
    {
        hariIni = DateOnly.FromDateTime(DateTime.Today);

        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            bolehPenjualan = PunyaPeran(user, AppRoles.AdminPenjualan);
            bolehPembelian = PunyaPeran(user, AppRoles.AdminPembelian);
            bolehStok = PunyaPeran(user, AppRoles.AdminPersediaan);
        }

        var galat = new List<string>();

        if (bolehPenjualan) await MuatPenjualan(galat);
        if (bolehPembelian) await MuatPembelian(galat);
        if (bolehStok) await MuatStok(galat);

        pesanError = string.Join(" ", galat);
        isLoading = false;
    }

    // =====================================================
    // MUAT DATA
    // =====================================================
    private async Task MuatPenjualan(List<string> galat)
    {
        var awalBulan = new DateOnly(hariIni.Year, hariIni.Month, 1);
        var awalBulanLalu = awalBulan.AddMonths(-1);

        try { daftarPelanggan = await PelangganService.GetAllAsync(); } catch { }

        // Penjualan dari awal bulan lalu sampai hari ini: dipakai untuk angka dan perbandingan
        var (penjualan, e1) = await LaporanService.AmbilAsync("penjualan", "pelanggan", awalBulanLalu, hariIni, "", "");
        if (penjualan is null) galat.Add("Gagal memuat penjualan: " + e1);

        var semuaTrx = (penjualan ?? new())
            .SelectMany(g => g.Baris)
            .GroupBy(b => b.IdTransaksi)
            .Select(t => t.First())
            .ToList();

        var bulanIni = semuaTrx.Where(t => t.Tanggal >= awalBulan).ToList();
        nilaiBulanIni = bulanIni.Sum(t => t.TotalTransaksi);
        jmlTransaksiBulanIni = bulanIni.Count;
        rataTransaksi = jmlTransaksiBulanIni == 0 ? 0 : nilaiBulanIni / jmlTransaksiBulanIni;

        // Pembanding: bulan lalu sampai tanggal yang sama dengan hari ini
        var hariPembanding = Math.Min(hariIni.Day, DateTime.DaysInMonth(awalBulanLalu.Year, awalBulanLalu.Month));
        var akhirPembanding = awalBulanLalu.AddDays(hariPembanding - 1);
        var nilaiLalu = semuaTrx
            .Where(t => t.Tanggal >= awalBulanLalu && t.Tanggal <= akhirPembanding)
            .Sum(t => t.TotalTransaksi);
        deltaPersen = nilaiLalu == 0 ? null : (nilaiBulanIni - nilaiLalu) / nilaiLalu * 100;

        // Pesanan yang masih Pending, 30 hari ke belakang sampai 30 hari ke depan
        var (pending, e2) = await LaporanService.AmbilAsync("pesanan", "pelanggan",
            hariIni.AddDays(-30), hariIni.AddDays(30), "", "Pending");
        if (pending is null) galat.Add("Gagal memuat pesanan: " + e2);

        var daftarPending = (pending ?? new())
            .SelectMany(g => g.Baris.GroupBy(b => b.IdTransaksi).Select(t => (IdPelanggan: g.Id, Trx: t.First())))
            .OrderBy(x => TglAmbil(x.Trx))
            .ToList();

        jmlPending = daftarPending.Count;
        jmlTelat = daftarPending.Count(x => TglAmbil(x.Trx) < hariIni);
        jmlHariIni = daftarPending.Count(x => TglAmbil(x.Trx) == hariIni);
        nilaiPending = daftarPending.Sum(x => x.Trx.TotalTransaksi);
        pesananPending = daftarPending.Take(5).ToList();
    }

    private async Task MuatPembelian(List<string> galat)
    {
        var awalBulan = new DateOnly(hariIni.Year, hariIni.Month, 1);

        try { daftarPemasok = await PemasokService.GetAllAsync(); } catch { }

        var (pembelian, e) = await LaporanPembelian.AmbilAsync("pembelian", "pemasok",
            hariIni.AddDays(-RentangPembelian), hariIni);

        if (pembelian is null)
        {
            galat.Add("Gagal memuat pembelian: " + e);
            return;
        }

        var semuaTrx = pembelian
            .SelectMany(g => g.Baris
                .GroupBy(b => b.IdTransaksi)
                .Select(t => (IdPemasok: t.First().IdPemasok ?? g.Id, Trx: t.First())))
            .ToList();

        nilaiPembelianBulanIni = semuaTrx
            .Where(x => x.Trx.Tanggal >= awalBulan)
            .Sum(x => x.Trx.TotalTransaksi);

        // Yang sudah paling lama menunggu tampil paling atas
        var menunggu = semuaTrx
            .Where(x => string.Equals(x.Trx.Status, StatusMenunggu, StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.Trx.Tanggal)
            .ToList();

        jmlBelumDiterima = menunggu.Count;
        nilaiBelumDiterima = menunggu.Sum(x => x.Trx.TotalTransaksi);
        pembelianMenunggu = menunggu.Take(5).ToList();
    }

    private async Task MuatStok(List<string> galat)
    {
        try
        {
            var token = await AuthStateProvider.AmbilTokenAsync();
            var client = HttpClientFactory.CreateClient("API");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var bahanBaku = await client.GetFromJsonAsync<List<BahanBakuResponse>>("api/HeaderBahanBaku")
                            ?? new();

            jmlStokMenipis = bahanBaku
                .Where(x => x.Status && x.Jenis)
                .Count(x => x.Details.Sum(d => d.SisaStok ?? 0) < BatasStok);

            // Batch yang masih ada isinya dan kadaluwarsa dalam HariPeringatan hari (termasuk yang sudah lewat)
            var batasKadaluwarsa = hariIni.AddDays(HariPeringatan);
            var tglBatch = bahanBaku
                .Where(x => x.Status)
                .SelectMany(x => x.Details)
                .Where(d => d.TglKadaluwarsa is not null && (d.SisaStok ?? 0) > 0)
                .Select(d => d.TglKadaluwarsa!.Value)
                .Where(t => t <= batasKadaluwarsa)
                .ToList();

            jmlKadaluwarsa = tglBatch.Count;
            jmlSudahKadaluwarsa = tglBatch.Count(t => t < hariIni);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            galat.Add("Gagal memuat stok: " + ex.Message);
        }
    }

    // =====================================================
    // HELPER
    // =====================================================
    private static string FormatRupiah(decimal v) => v.ToString("C0", IdCulture);
    private static DateOnly TglAmbil(LaporanBaris b) => b.TglPengambilan ?? b.Tanggal;

    // AppRoles.* berisi daftar role dipisah koma (format atribut [Authorize(Roles = ...)])
    private static bool PunyaPeran(ClaimsPrincipal user, string daftarPeran)
        => daftarPeran
            .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .Any(user.IsInRole);

    private string Selisih(DateOnly tgl)
    {
        var n = tgl.DayNumber - hariIni.DayNumber;
        return n switch
        {
            0 => "Hari ini",
            1 => "Besok",
            -1 => "Kemarin",
            < 0 => $"Lewat {-n} hari",
            _ => $"{n} hari lagi"
        };
    }

    private string LamaMenunggu(DateOnly tgl)
    {
        var n = hariIni.DayNumber - tgl.DayNumber;
        return n switch
        {
            <= 0 => "Hari ini",
            1 => "Kemarin",
            _ => $"{n} hari lalu"
        };
    }

    private string NamaPelanggan(string? id)
        => daftarPelanggan.FirstOrDefault(p => p.IdPelanggan == id)?.NamaPelanggan ?? (id ?? "-");

    private string NamaPemasok(string? id)
        => daftarPemasok.FirstOrDefault(p => p.IdPemasok == id)?.NamaPemasok ?? (id ?? "-");

    // =====================================================
    // MODEL RESPONSE
    // =====================================================
    public class BahanBakuResponse
    {
        public string IdBahanBaku { get; set; } = "";
        public string NamaBahanBaku { get; set; } = "";
        public bool Jenis { get; set; }
        public bool Status { get; set; }

        public List<DetailBahanBakuResponse> Details { get; set; } = new();
    }

    public class DetailBahanBakuResponse
    {
        public decimal? SisaStok { get; set; }
        public DateOnly? TglKadaluwarsa { get; set; }
    }
}