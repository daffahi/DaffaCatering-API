@page "/penerimaan-bahan-baku"

@using System.Globalization
@inject PenerimaanBahanBakuService PenerimaanService
@inject PembelianService PembelianService
@inject PemasokService PemasokService
@inject BahanBakuService BahanBakuService
@inject SatuanBahanBakuService SatuanBahanBakuService

@{
    var view = Filtered.ToList();
}

<div class="penerimaan-page">

    @* ================= 1. HEADER HALAMAN ================= *@
    <header class="page-head">
        <div>
            <h1>Penerimaan Bahan Baku</h1>
            <p>Catat transaksi penerimaan bahan baku dari pembelian</p>
        </div>
        <button class="btn-add" @onclick="BukaModalTambah">
            <i class="fa-solid fa-plus"></i> Tambah Penerimaan
        </button>
    </header>

    @* ================= 2. BANNER SUKSES & ERROR ================= *@
    @if (!string.IsNullOrEmpty(pesanSukses))
    {
        <div class="banner ok">
            <i class="fa-solid fa-circle-check"></i>
            <span>@pesanSukses</span>
            <button class="banner-close" @onclick="() => pesanSukses = string.Empty">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(pesanError))
    {
        <div class="banner">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@pesanError</span>
            <button class="banner-close" @onclick="() => pesanError = string.Empty">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @* ================= 3. TOOLBAR: SEARCH ================= *@
    <section class="toolbar-card">
        <label class="search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="Cari nomor penerimaan atau nama pemasok..."
                   @bind="teksCari" @bind:event="oninput" />
        </label>
    </section>

    @* ================= 4. TABEL PENERIMAAN ================= *@
    <section class="panel">

        @if (isLoading)
        {
            <div class="skeleton">
                @for (var s = 0; s < 6; s++)
                {
                    <div class="sk-row">
                        <div class="sk-avatar"></div>
                        <div class="sk-lines"><div></div><div></div></div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Penerimaan</th>
                            <th>Tanggal</th>
                            <th>Nama Pemasok</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (item, i) in view.Select((item, i) => (item, i)))
                        {
                            <tr @key="item.IdPenerimaan" style="--i:@Math.Min(i, 12)">
                                <td>
                                    <div class="who">
                                        <div class="avatar tone-@Warna(item.IdPenerimaan)">PNM</div>
                                        <div>
                                            <div class="name">@item.IdPenerimaan</div>
                                            <div class="sub">Penerimaan</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.TglPenerimaan.ToString("dd MMMM yyyy", IdCulture)</td>
                                <td>@NamaPemasok(item.IdPemasok)</td>
                                <td>
                                    <span class="pill @(IsClose(item) ? "closed" : "pending")">
                                        <i></i>@(string.IsNullOrWhiteSpace(item.Status) ? "-" : item.Status)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (view.Count == 0)
                {
                    <div class="empty">
                        <i class="fa-regular fa-face-frown-open"></i>
                        <strong>Penerimaan atau nama pemasok tidak ditemukan</strong>
                        <span>Coba ubah kata kunci atau tambah penerimaan baru</span>
                    </div>
                }
            </div>

            <div class="panel-foot">
                Menampilkan <b>@view.Count</b> dari <b>@daftarPenerimaan.Count</b> penerimaan
            </div>
        }
    </section>

    @* ================= 5. MODAL FORM PENERIMAAN ================= *@
    @if (modalTampil)
    {
        var detailPembelianView = DaftarDetailPembelian.ToList();
        var statusForm = StatusForm;

        <div class="overlay" @onclick="TutupModal">
            <div class="dialog wide" @onclick:stopPropagation>

                @* ---------- Header modal ---------- *@
                <header class="dialog-head">
                    <div>
                        <h5>Tambah Penerimaan Bahan Baku</h5>
                        <p>Isi data penerimaan baru</p>
                    </div>
                    <button type="button" class="dialog-close" title="Tutup" @onclick="TutupModal">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </header>

                <div class="dialog-body">

                    @* ---------- Data utama ---------- *@
                    <div class="row2">
                        <div class="field">
                            <label>No. Penerimaan <small>(otomatis)</small></label>
                            <input type="text" value="@kodePenerimaan" disabled />
                        </div>
                        <div class="field">
                            <label>Tanggal Penerimaan <b class="req">*</b></label>
                            <input type="date" value="@tglPenerimaanInput" max="@Iso(HariIni)"
                                   disabled="@(items.Count > 0)"
                                   @onchange="e => tglPenerimaanInput = e.Value?.ToString() ?? string.Empty" />
                            @if (items.Count > 0)
                            {
                                <span class="hint">Terkunci selama masih ada item.</span>
                            }
                        </div>
                    </div>

                    <div class="field">
                        <label>No. Pembelian <b class="req">*</b></label>
                        <div class="pick-row">
                            <input type="text" readonly placeholder="Belum ada pembelian dipilih"
                                   value="@(pembelianDipilih?.IdPembelian ?? "")" />
                            <button type="button" class="btn-mini solid"
                                    disabled="@(items.Count > 0)" @onclick="BukaPencarianPembelian">
                                <i class="fa-solid fa-magnifying-glass"></i> Cari
                            </button>
                        </div>
                        @if (items.Count > 0)
                        {
                            <span class="hint">Terkunci selama masih ada item.</span>
                        }
                    </div>

                    <div class="row2">
                        <div class="field">
                            <label>Kode Pemasok <small>(otomatis)</small></label>
                            <input type="text" disabled placeholder="Otomatis dari pembelian"
                                   value="@(pembelianDipilih?.IdPemasok ?? "")" />
                        </div>
                        <div class="field">
                            <label>Nama Pemasok <small>(otomatis)</small></label>
                            <input type="text" disabled placeholder="Otomatis dari pembelian"
                                   value="@(pembelianDipilih?.NamaPemasok ?? "")" />
                        </div>
                    </div>

                    <div class="field">
                        <label>Status <small>(otomatis)</small></label>
                        <div>
                            <span class="pill @(statusForm == "Close" ? "closed" : "pending")">
                                <i></i>@statusForm
                            </span>
                        </div>
                    </div>

                    @* ---------- Data pembelian ---------- *@
                    <div class="section-head">
                        <h6>Data Pembelian</h6>
                        <span class="count-tag">@detailPembelianView.Count bahan baku</span>
                    </div>

                    <div class="detail-wrap">
                        <table class="detail-table batch-table">
                            <thead>
                                <tr>
                                    <th>Bahan Baku</th>
                                    <th>Jumlah Beli</th>
                                    <th>Diterima</th>
                                    <th>Sisa</th>
                                    <th>Satuan</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in detailPembelianView)
                                {
                                    var row = d;
                                    <tr class="@KelasBarisPembelian(row)" @onclick="() => PilihDetailPembelian(row)">
                                        <td>
                                            <div class="name">@row.NamaBahanBaku</div>
                                            <div class="sub">@row.IdBahanBaku</div>
                                        </td>
                                        <td class="mono">@FormatAngka(row.JumlahBeli)</td>
                                        <td class="mono">@FormatAngka(row.JumlahTerima)</td>
                                        <td class="mono">@FormatAngka(row.Sisa)</td>
                                        <td>@NamaSatuan(row.IdSatuan)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @if (detailPembelianView.Count == 0)
                        {
                            <div class="detail-empty">
                                @(pembelianDipilih is null
                                    ? "Pilih No. Pembelian terlebih dahulu untuk menampilkan bahan baku yang dibeli"
                                    : "Pembelian ini tidak memiliki bahan baku")
                            </div>
                        }
                    </div>

                    @* ---------- Data penerimaan ---------- *@
                    <div class="section-head">
                        <h6>Data Penerimaan</h6>
                        <span class="count-tag">@items.Count item</span>
                    </div>

                    <div class="detail-form @(indeksEdit >= 0 ? "editing" : "")">
                        <div class="field">
                            <label>Bahan Baku <b class="req">*</b></label>
                            <input type="text" disabled placeholder="Klik bahan baku pada tabel Data Pembelian"
                                   value="@(bahanDipilih?.NamaBahanBaku ?? "")" />
                        </div>

                        <div class="row4">
                            <div class="field">
                                <label>Jumlah <b class="req">*</b></label>
                                <input type="number" step="0.01" min="0" placeholder="0"
                                       disabled="@(bahanDipilih is null)"
                                       @bind="jumlahInput" @bind:event="oninput" />
                                @if (bahanDipilih is not null)
                                {
                                    <span class="hint">Sisa pembelian: @FormatAngka(SisaBahanDipilih)</span>
                                }
                            </div>
                            <div class="field">
                                <label>Satuan</label>
                                <input type="text" disabled placeholder="Otomatis"
                                       value="@(string.IsNullOrEmpty(idSatuanInput) ? "" : NamaSatuan(idSatuanInput))" />
                            </div>
                            <div class="field">
                                <label>Tgl Kadaluwarsa <b class="req">*</b></label>
                                <input type="date" min="@TglKadaluwarsaMin" value="@tglKadaluwarsaInput"
                                       disabled="@(bahanDipilih is null)"
                                       @onchange="e => tglKadaluwarsaInput = e.Value?.ToString() ?? string.Empty" />
                            </div>
                            <div class="field">
                                <label>Tutup Bahan Baku</label>
                                <label class="switch">
                                    <input type="checkbox" checked="@tutupInput"
                                           disabled="@(bahanDipilih is null)"
                                           @onchange="e => tutupInput = (bool)(e.Value ?? false)" />
                                    <span class="switch-track"></span>
                                    <span class="switch-text">@(tutupInput ? "Ya" : "Tidak")</span>
                                </label>
                            </div>
                        </div>

                        <span class="hint">Aktifkan "Tutup Bahan Baku" bila sisa bahan baku ini tidak akan diterima lagi.</span>

                        @if (!string.IsNullOrEmpty(detailError))
                        {
                            <div class="banner in-dialog">
                                <i class="fa-solid fa-circle-exclamation"></i>
                                <span>@detailError</span>
                            </div>
                        }

                        <div class="detail-actions">
                            @if (indeksEdit >= 0)
                            {
                                <button type="button" class="btn-mini" @onclick="KosongkanInputDetail">Batal Ubah</button>
                            }
                            <button type="button" class="btn-mini solid" @onclick="TambahAtauUbahDetail">
                                <i class="fa-solid @(indeksEdit >= 0 ? "fa-check" : "fa-plus")"></i>
                                @(indeksEdit >= 0 ? "Perbarui Item" : "Tambah Item")
                            </button>
                        </div>
                    </div>

                    <div class="detail-wrap">
                        <table class="detail-table">
                            <thead>
                                <tr>
                                    <th>Bahan Baku</th>
                                    <th>Jumlah</th>
                                    <th>Satuan</th>
                                    <th>Tgl Kadaluwarsa</th>
                                    <th>Status</th>
                                    <th class="actions">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < items.Count; i++)
                                {
                                    var index = i;
                                    var it = items[index];
                                    <tr class="@(index == indeksEdit ? "row-edit" : "")">
                                        <td>
                                            <div class="name">@it.NamaBahanBaku</div>
                                            <div class="sub">@it.IdBahanBaku</div>
                                        </td>
                                        <td class="mono">@FormatAngka(it.Jumlah)</td>
                                        <td>@NamaSatuan(it.IdSatuan)</td>
                                        <td>@it.TglKadaluwarsa.ToString("dd MMMM yyyy", IdCulture)</td>
                                        <td>
                                            <span class="pill @(it.Ditutup ? "closed" : "ok")">
                                                <i></i>@(it.Ditutup ? "Ditutup" : "Diterima")
                                            </span>
                                        </td>
                                        <td class="actions">
                                            <button type="button" class="icon-btn" title="Ubah item"
                                                    @onclick="() => MulaiUbahDetail(index)">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>
                                            <button type="button" class="icon-btn danger" title="Hapus item"
                                                    @onclick="() => HapusDetail(index)">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @if (items.Count == 0)
                        {
                            <div class="detail-empty">
                                Belum ada item. Klik bahan baku pada tabel Data Pembelian, isi jumlah dan tanggal kadaluwarsa, lalu klik "Tambah Item".
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="banner in-dialog">
                            <i class="fa-solid fa-circle-exclamation"></i>
                            <span>@modalError</span>
                        </div>
                    }
                </div>

                @* ---------- Footer modal ---------- *@
                <footer class="dialog-foot">
                    <button type="button" class="btn-ghost" @onclick="TutupModal">Batalkan</button>
                    <button type="button" class="btn-solid" disabled="@sedangSimpan" @onclick="SimpanData">
                        @if (sedangSimpan)
                        {
                            <i class="fa-solid fa-spinner fa-spin"></i> <span>Menyimpan...</span>
                        }
                        else
                        {
                            <span>Simpan</span>
                        }
                    </button>
                </footer>
            </div>
        </div>
    }

    @* ================= 6. MODAL CARI PEMBELIAN ================= *@
    @if (cariPembelianTampil)
    {
        var pembelianView = DaftarPembelianAktif.ToList();

        <div class="overlay stacked" @onclick="TutupPencarianPembelian">
            <div class="dialog wide" @onclick:stopPropagation>

                <header class="dialog-head">
                    <div>
                        <h5>Pilih Pembelian</h5>
                        <p>Cari dan pilih pembelian untuk penerimaan bahan baku</p>
                    </div>
                    <button type="button" class="dialog-close" title="Tutup" @onclick="TutupPencarianPembelian">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </header>

                <div class="dialog-body">
                    <div class="batch-toolbar">
                        <label class="search">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="text" placeholder="Cari nomor pembelian atau nama pemasok..."
                                   @bind="teksCariPembelian" @bind:event="oninput" />
                        </label>
                    </div>

                    <div class="detail-wrap">
                        <table class="detail-table batch-table">
                            <thead>
                                <tr>
                                    <th class="col-kode">No. Pembelian</th>
                                    <th class="col-tgl">Tanggal</th>
                                    <th>Nama Pemasok</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pr in pembelianView)
                                {
                                    var row = pr;
                                    <tr @onclick="() => PilihPembelian(row)">
                                        <td class="mono">@row.IdPembelian</td>
                                        <td>@row.TglPembelian.ToString("dd MMMM yyyy", IdCulture)</td>
                                        <td><div class="name">@row.NamaPemasok</div></td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @if (pembelianView.Count == 0)
                        {
                            <div class="detail-empty">Pembelian dengan status Pending tidak ditemukan</div>
                        }
                    </div>
                </div>

                <footer class="dialog-foot">
                    <button type="button" class="btn-ghost" @onclick="TutupPencarianPembelian">Batalkan</button>
                </footer>
            </div>
        </div>
    }

</div>

@code {
    // =====================================================
    // 1. STATE & MODEL
    // =====================================================
    private static readonly CultureInfo IdCulture = new("id-ID");

    private record PembelianRow(string IdPembelian, string IdPemasok, string NamaPemasok, DateOnly TglPembelian);
    private record BahanRow(string IdBahanBaku, string NamaBahanBaku);

    private record PembelianDetailRow(string IdBahanBaku, string NamaBahanBaku, string IdSatuan, decimal JumlahBeli, decimal JumlahTerima)
    {
        public decimal Sisa => JumlahBeli - JumlahTerima;
    }

    private class ItemPenerimaan
    {
        public string IdBahanBaku { get; set; } = "";
        public string NamaBahanBaku { get; set; } = "";
        public string IdSatuan { get; set; } = "";
        public decimal Jumlah { get; set; }
        public DateOnly TglKadaluwarsa { get; set; }
        public bool Ditutup { get; set; }
    }

    // --- data ---
    private List<PenerimaanBahanBakuModels> daftarPenerimaan = new();
    private List<PembelianModels> daftarPembelian = new();
    private List<PemasokModels> daftarPemasok = new();
    private List<BahanBakuModels> daftarBahanBaku = new();
    private List<SatuanBahanBakuModels> daftarSatuan = new();

    // --- halaman utama ---
    private bool isLoading = true;
    private string pesanSukses = "";
    private string pesanError = "";
    private string teksCari = "";

    // --- modal form: header ---
    private bool modalTampil = false;
    private bool sedangSimpan = false;
    private string modalError = "";
    private string kodePenerimaan = "";
    private string tglPenerimaanInput = "";
    private PembelianRow? pembelianDipilih;

    // --- modal form: detail ---
    private readonly List<ItemPenerimaan> items = new();
    private int indeksEdit = -1;            // -1 = tambah item, >= 0 = ubah item
    private BahanRow? bahanDipilih;
    private string jumlahInput = "";
    private string idSatuanInput = "";
    private string tglKadaluwarsaInput = "";
    private bool tutupInput = false;
    private string detailError = "";

    // --- modal cari pembelian ---
    private bool cariPembelianTampil = false;
    private string teksCariPembelian = "";

    // =====================================================
    // 2. LIFECYCLE & MUAT DATA
    // =====================================================
    protected override async Task OnInitializedAsync()
    {
        await MuatData();
    }

    private async Task MuatData()
    {
        isLoading = true;
        var galat = new List<string>();

        try { daftarPenerimaan = await PenerimaanService.GetAllAsync(); }
        catch (Exception ex) { galat.Add("Gagal memuat penerimaan: " + ex.Message); }

        try { daftarPembelian = await PembelianService.GetAllAsync(); }
        catch (Exception ex) { galat.Add("Gagal memuat pembelian: " + ex.Message); }

        try { daftarPemasok = await PemasokService.GetAllAsync(); }
        catch (Exception ex) { galat.Add("Gagal memuat pemasok: " + ex.Message); }

        try { daftarBahanBaku = await BahanBakuService.GetAllAsync(); }
        catch (Exception ex) { galat.Add("Gagal memuat bahan baku: " + ex.Message); }

        try { daftarSatuan = await SatuanBahanBakuService.GetAllAsync(); }
        catch (Exception ex) { galat.Add("Gagal memuat satuan: " + ex.Message); }

        pesanError = string.Join(" ", galat);
        isLoading = false;
    }

    // =====================================================
    // 3. HELPER UMUM (format & lookup nama)
    // =====================================================
    private static DateOnly HariIni => DateOnly.FromDateTime(DateTime.Today);

    private static string Iso(DateOnly d) => d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private static string FormatAngka(decimal v) => v.ToString("#,##0.##", IdCulture);

    // Warna avatar stabil per teks (string.GetHashCode() berubah tiap proses, jadi tidak dipakai)
    private static int Warna(string? teks) => (teks ?? "").Sum(ch => ch) % 5;

    private static bool TryParseAngka(string? teks, out decimal hasil)
    {
        hasil = 0;
        var t = (teks ?? "").Trim().Replace(',', '.');
        return t.Length > 0
               && decimal.TryParse(t, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out hasil)
               && hasil > 0;
    }

    private string NamaPemasok(string? id)
        => daftarPemasok.FirstOrDefault(p => p.IdPemasok == id)?.NamaPemasok ?? (id ?? "-");

    private string NamaSatuan(string? id)
        => daftarSatuan.FirstOrDefault(s => s.IdSatuan == id)?.NamaSatuan ?? (id ?? "-");

    private string NamaBahan(string? id)
        => daftarBahanBaku.FirstOrDefault(b => b.IdBahanBaku == id)?.NamaBahanBaku ?? (id ?? "-");

    // =====================================================
    // 4. DAFTAR PENERIMAAN: PENCARIAN
    // =====================================================
    private IEnumerable<PenerimaanBahanBakuModels> Filtered => daftarPenerimaan
        .Where(p => string.IsNullOrWhiteSpace(teksCari)
            || (p.IdPenerimaan ?? "").Contains(teksCari, StringComparison.OrdinalIgnoreCase)
            || NamaPemasok(p.IdPemasok).Contains(teksCari, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(p => p.IdPenerimaan);

    private static bool IsClose(PenerimaanBahanBakuModels p)
        => string.Equals(p.Status, "Close", StringComparison.OrdinalIgnoreCase);

    // =====================================================
    // 5. MODAL FORM: BUKA / TUTUP / RESET
    // =====================================================
    // ID otomatis: PNM + 7 digit
    private static string BuatIdBerikutnya(IEnumerable<PenerimaanBahanBakuModels> data)
    {
        const string prefix = "PNM";

        var max = data
            .Select(c => c.IdPenerimaan)
            .Where(id => !string.IsNullOrEmpty(id)
                         && id.StartsWith(prefix)
                         && int.TryParse(id[prefix.Length..], out _))
            .Select(id => int.Parse(id[prefix.Length..]))
            .DefaultIfEmpty(0)
            .Max();

        return $"{prefix}{max + 1:D7}";
    }

    private async Task BukaModalTambah()
    {
        ResetForm();

        try
        {
            // Data terbaru dari server. daftarPenerimaan wajib ikut diperbarui
            // karena dipakai menghitung "Jumlah Terima" (SudahDiterima).
            daftarPenerimaan = await PenerimaanService.GetAllAsync();
            daftarPembelian = await PembelianService.GetAllAsync();
            daftarBahanBaku = await BahanBakuService.GetAllAsync();
            kodePenerimaan = BuatIdBerikutnya(daftarPenerimaan);
        }
        catch (Exception ex)
        {
            pesanError = "Gagal menyiapkan form: " + ex.Message;
            return;
        }

        tglPenerimaanInput = Iso(HariIni);
        modalTampil = true;
    }

    private void ResetForm()
    {
        pesanSukses = "";
        pesanError = "";
        modalError = "";
        cariPembelianTampil = false;
        pembelianDipilih = null;
        items.Clear();
        KosongkanInputDetail();
    }

    private void TutupModal()
    {
        cariPembelianTampil = false;
        modalTampil = false;
    }

    // =====================================================
    // 6. MODAL CARI: PEMBELIAN
    // =====================================================
    private IEnumerable<PembelianRow> DaftarPembelianAktif => daftarPembelian
        .Where(p => p.Status == "Pending")
        .Select(p => new PembelianRow(p.IdPembelian, p.IdPemasok, NamaPemasok(p.IdPemasok), p.TglPembelian))
        .Where(p => string.IsNullOrWhiteSpace(teksCariPembelian)
            || p.IdPembelian.Contains(teksCariPembelian, StringComparison.OrdinalIgnoreCase)
            || p.NamaPemasok.Contains(teksCariPembelian, StringComparison.OrdinalIgnoreCase))
        .OrderBy(p => p.IdPembelian);

    private void BukaPencarianPembelian()
    {
        teksCariPembelian = "";
        cariPembelianTampil = true;
    }

    private void TutupPencarianPembelian() => cariPembelianTampil = false;

    private void PilihPembelian(PembelianRow pr)
    {
        pembelianDipilih = pr;
        KosongkanInputDetail();
        cariPembelianTampil = false;
    }

    // =====================================================
    // 7. MODAL FORM: DATA PEMBELIAN
    // =====================================================
    // Total yang sudah diterima untuk pembelian + bahan baku ini
    private decimal SudahDiterima(string idPembelian, string idBahanBaku)
        => daftarPenerimaan
            .Where(p => p.IdPembelian == idPembelian)
            .SelectMany(p => p.Details)
            .Where(d => d.IdBahanBaku == idBahanBaku)
            .Sum(d => d.Jumlah);

    private IEnumerable<PembelianDetailRow> DaftarDetailPembelian
    {
        get
        {
            var pembelian = daftarPembelian.FirstOrDefault(p => p.IdPembelian == pembelianDipilih?.IdPembelian);
            if (pembelian is null) return Enumerable.Empty<PembelianDetailRow>();

            return pembelian.Details
                .Select(d => new PembelianDetailRow(
                    d.IdBahanBaku,
                    NamaBahan(d.IdBahanBaku),
                    d.IdSatuan,
                    d.Jumlah,
                    SudahDiterima(pembelian.IdPembelian, d.IdBahanBaku)))
                .OrderBy(d => d.IdBahanBaku);
        }
    }

    private decimal SisaBahanDipilih
        => bahanDipilih is null
            ? 0
            : DaftarDetailPembelian.FirstOrDefault(d => d.IdBahanBaku == bahanDipilih.IdBahanBaku)?.Sisa ?? 0;

    // true = persediaan (wajib H+1), false = habis pakai (boleh hari ini)
    private bool IsPersediaan(string idBahanBaku)
        => daftarBahanBaku.FirstOrDefault(b => b.IdBahanBaku == idBahanBaku)?.Jenis ?? false;

    private string TglKadaluwarsaMin
        => Iso(bahanDipilih is not null && IsPersediaan(bahanDipilih.IdBahanBaku) ? HariIni.AddDays(1) : HariIni);

    private string KelasBarisPembelian(PembelianDetailRow r)
        => r.Sisa <= 0 ? "row-disabled"
         : r.IdBahanBaku == bahanDipilih?.IdBahanBaku ? "row-edit"
         : "";

    private void PilihDetailPembelian(PembelianDetailRow r)
    {
        detailError = "";

        if (r.Sisa <= 0)
        {
            detailError = $"Bahan baku {r.NamaBahanBaku} sudah diterima sepenuhnya.";
            return;
        }

        indeksEdit = -1;
        bahanDipilih = new BahanRow(r.IdBahanBaku, r.NamaBahanBaku);
        idSatuanInput = r.IdSatuan;
        jumlahInput = r.Sisa.ToString("0.##", CultureInfo.InvariantCulture);
        tglKadaluwarsaInput = TglKadaluwarsaMin;
        tutupInput = false;
    }

    // =====================================================
    // 8. MODAL FORM: DETAIL (ITEM PENERIMAAN)
    // =====================================================
    private void KosongkanInputDetail()
    {
        indeksEdit = -1;
        bahanDipilih = null;
        jumlahInput = "";
        idSatuanInput = "";
        tglKadaluwarsaInput = Iso(HariIni);
        tutupInput = false;
        detailError = "";
    }

    private void MulaiUbahDetail(int index)
    {
        var it = items[index];

        indeksEdit = index;
        detailError = "";
        bahanDipilih = new BahanRow(it.IdBahanBaku, it.NamaBahanBaku);
        idSatuanInput = it.IdSatuan;
        jumlahInput = it.Jumlah.ToString("0.##", CultureInfo.InvariantCulture);
        tglKadaluwarsaInput = Iso(it.TglKadaluwarsa);
        tutupInput = it.Ditutup;
    }

    private void TambahAtauUbahDetail()
    {
        detailError = "";

        if (pembelianDipilih is null)
        {
            detailError = "Harap pilih No. Pembelian terlebih dahulu.";
            return;
        }

        if (bahanDipilih is null)
        {
            detailError = "Harap pilih bahan baku pada tabel Data Pembelian.";
            return;
        }

        if (string.IsNullOrWhiteSpace(jumlahInput))
        {
            detailError = "Harap masukkan jumlah penerimaan bahan baku.";
            return;
        }

        if (!TryParseAngka(jumlahInput, out var jumlah))
        {
            detailError = "Jumlah penerimaan harus berupa angka lebih dari 0.";
            return;
        }

        var sisa = SisaBahanDipilih;
        if (jumlah > sisa)
        {
            detailError = $"Jumlah penerimaan tidak boleh melebihi sisa pembelian ({FormatAngka(sisa)}).";
            return;
        }

        if (!DateOnly.TryParseExact(tglKadaluwarsaInput, "yyyy-MM-dd", CultureInfo.InvariantCulture,
                                    DateTimeStyles.None, out var tgl))
        {
            detailError = "Harap isi tanggal kadaluwarsa.";
            return;
        }

        if (IsPersediaan(bahanDipilih.IdBahanBaku))
        {
            if (tgl <= HariIni)
            {
                detailError = "Untuk bahan persediaan, tanggal kadaluwarsa minimal H+1 (lebih dari hari ini).";
                return;
            }
        }
        else if (tgl < HariIni)
        {
            detailError = "Tanggal kadaluwarsa tidak boleh kurang dari hari ini.";
            return;
        }

        // Duplikat = bahan baku yang sama
        var kembar = items
            .Where((it, i) => i != indeksEdit)
            .Any(it => it.IdBahanBaku == bahanDipilih.IdBahanBaku);

        if (kembar)
        {
            detailError = $"Bahan baku {bahanDipilih.NamaBahanBaku} sudah ada di daftar penerimaan.";
            return;
        }

        var item = new ItemPenerimaan
        {
            IdBahanBaku = bahanDipilih.IdBahanBaku,
            NamaBahanBaku = bahanDipilih.NamaBahanBaku,
            IdSatuan = idSatuanInput,
            Jumlah = jumlah,
            TglKadaluwarsa = tgl,
            Ditutup = tutupInput
        };

        if (indeksEdit == -1) items.Add(item);   // TAMBAH ITEM
        else items[indeksEdit] = item;           // UBAH ITEM

        KosongkanInputDetail();
    }

    private void HapusDetail(int index)
    {
        items.RemoveAt(index);

        if (indeksEdit == index) KosongkanInputDetail();
        else if (indeksEdit > index) indeksEdit--;
    }

    // =====================================================
    // 9. MODAL FORM: STATUS & SIMPAN
    // =====================================================
    // Pending kalau masih ada bahan baku yang belum terpenuhi dan belum ditutup
    private string HitungStatus()
    {
        foreach (var d in DaftarDetailPembelian)
        {
            var item = items.FirstOrDefault(i => i.IdBahanBaku == d.IdBahanBaku);
            var totalTerima = d.JumlahTerima + (item?.Jumlah ?? 0);
            var ditutup = item?.Ditutup ?? false;

            if (totalTerima < d.JumlahBeli && !ditutup) return "Pending";
        }

        return "Close";
    }

    // Status yang ditampilkan di form
    private string StatusForm => pembelianDipilih is null ? "Pending" : HitungStatus();

    private async Task SimpanData()
    {
        modalError = "";

        if (string.IsNullOrWhiteSpace(kodePenerimaan))
        {
            modalError = "No. Penerimaan belum ter-generate, coba buka form kembali.";
            return;
        }

        if (pembelianDipilih is null)
        {
            modalError = "Harap pilih No. Pembelian terlebih dahulu.";
            return;
        }

        if (!DateOnly.TryParseExact(tglPenerimaanInput, "yyyy-MM-dd", CultureInfo.InvariantCulture,
                                    DateTimeStyles.None, out var tgl))
        {
            modalError = "Harap isi tanggal penerimaan.";
            return;
        }

        if (tgl > HariIni)
        {
            modalError = "Tanggal penerimaan tidak boleh lebih dari hari ini.";
            return;
        }

        if (items.Count == 0)
        {
            modalError = $"Harap tambahkan minimal satu bahan baku untuk penerimaan {kodePenerimaan}.";
            return;
        }

        sedangSimpan = true;
        try
        {
            var model = new PenerimaanBahanBakuModels
            {
                IdPenerimaan = kodePenerimaan,
                IdPemasok = pembelianDipilih.IdPemasok,
                IdPembelian = pembelianDipilih.IdPembelian,
                TglPenerimaan = tgl,
                Status = HitungStatus(),
                Details = items.Select(i => new DetailPenerimaan
                {
                    IdBahanBaku = i.IdBahanBaku,
                    IdSatuan = i.IdSatuan,
                    Jumlah = i.Jumlah,
                    TglKadaluwarsa = i.TglKadaluwarsa,
                    StatusBahanBaku = i.Ditutup ? "Ditutup" : "Diterima"
                }).ToList()
            };

            var (success, error) = await PenerimaanService.CreateAsync(model);

            if (success)
            {
                pesanSukses = $"No. Penerimaan {kodePenerimaan} untuk No. Pembelian {pembelianDipilih.IdPembelian} berhasil ditambahkan.";
                modalTampil = false;
                await MuatData();
            }
            else
            {
                modalError = error;
            }
        }
        catch (Exception ex)
        {
            modalError = "Gagal menyimpan: " + ex.Message;
        }
        finally
        {
            sedangSimpan = false;
        }
    }
}