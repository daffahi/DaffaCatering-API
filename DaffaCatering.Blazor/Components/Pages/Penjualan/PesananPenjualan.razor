@page "/pesanan-penjualan"
@attribute [Authorize(Roles = AppRoles.AdminPenjualan)]
@implements IAsyncDisposable

@using System.Globalization
@inject IConfiguration Config
@inject IJSRuntime JS
@inject PesananPenjualanService PesananPenjualanService
@inject PelangganService PelangganService
@inject MenuMakananService MenuMakananService
@inject SatuanBahanBakuService SatuanBahanBakuService

@{
    var view = Filtered.ToList();
}

<div class="pesanan-penjualan-page">

    @* ================= 1. HEADER HALAMAN ================= *@
    <header class="page-head">
        <div>
            <h1>Pesanan Penjualan</h1>
            <p>Catat transaksi pesanan penjualan dari pelanggan</p>
        </div>
        <button class="btn-add" @onclick="BukaModalTambah">
            <i class="fa-solid fa-plus"></i> Tambah Pesanan Penjualan
        </button>
    </header>

    @* ================= 2. BANNER SUKSES & ERROR ================= *@
    @if (!string.IsNullOrEmpty(pesanSukses))
    {
        <div class="banner ok">
            <i class="fa-solid fa-circle-check"></i>
            <span>@pesanSukses</span>
            <button class="banner-close" @onclick="() => pesanSukses = string.Empty">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(pesanError))
    {
        <div class="banner">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@pesanError</span>
            <button class="banner-close" @onclick="() => pesanError = string.Empty">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @* ================= 3. TOOLBAR: SEARCH ================= *@
    <section class="toolbar-card">
        <label class="search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="Cari nomor pesanan penjualan atau nama pelanggan..."
                   @bind="teksCari" @bind:event="oninput" />
        </label>
    </section>

    @* ================= 4. TABEL PESANAN PENJUALAN ================= *@
    <section class="panel">

        @if (isLoading)
        {
            <div class="skeleton">
                @for (var s = 0; s < 6; s++)
                {
                    <div class="sk-row">
                        <div class="sk-avatar"></div>
                        <div class="sk-lines"><div></div><div></div></div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Pesanan Penjualan</th>
                            <th>Tanggal</th>
                            <th>Nama Pelanggan</th>
                            <th>Status</th>
                            <th class="actions">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (item, i) in view.Select((item, i) => (item, i)))
                        {
                            var tutup = IsClose(item);

                            <tr @key="item.IdPesanan" style="--i:@Math.Min(i, 12)">
                                <td>
                                    <div class="who">
                                        <div class="avatar tone-@Warna(item.IdPesanan)">PP</div>
                                        <div>
                                            <div class="name">@item.IdPesanan</div>
                                            <div class="sub">Pesanan Penjualan</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.TglPesanan.ToString("dd MMMM yyyy", IdCulture)</td>
                                <td>@NamaPelanggan(item.IdPelanggan)</td>
                                <td>
                                    <span class="pill @(tutup ? "closed" : "pending")">
                                        <i></i>@(string.IsNullOrWhiteSpace(item.Status) ? "-" : item.Status)
                                    </span>
                                </td>
                                <td class="actions">
                                    <button class="icon-btn"
                                            title="@(tutup ? "Pesanan Penjualan sudah ditutup" : "Edit")"
                                            disabled="@tutup"
                                            @onclick="() => BukaModalEdit(item)">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <button class="icon-btn" title="Cetak bukti pesanan"
                                            disabled="@sedangCetak"
                                            @onclick="() => CetakBukti(item)">
                                        <i class="fa-solid fa-print"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (view.Count == 0)
                {
                    <div class="empty">
                        <i class="fa-regular fa-face-frown-open"></i>
                        <strong>Pesanan Penjualan atau nama pelanggan tidak ditemukan</strong>
                        <span>Coba ubah kata kunci atau tambah pesanan penjualan baru</span>
                    </div>
                }
            </div>

            <div class="panel-foot">
                Menampilkan <b>@view.Count</b> dari <b>@daftarPesananPenjualan.Count</b> pesanan penjualan
            </div>
        }
    </section>

    @* ================= 5. MODAL FORM PESANAN PENJUALAN ================= *@
    @if (modalTampil)
    {
        <div class="overlay" @onclick="TutupModal">
            <div class="dialog wide" @onclick:stopPropagation>

                @* ---------- Header modal ---------- *@
                <header class="dialog-head">
                    <div>
                        <h5>@(isEditMode ? "Ubah" : "Tambah") Pesanan Penjualan</h5>
                        <p>@(isEditMode ? "Perbarui data pesanan penjualan" : "Isi data pesanan penjualan baru")</p>
                    </div>
                    <button type="button" class="dialog-close" title="Tutup" @onclick="TutupModal">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </header>

                <div class="dialog-body">

                    @* ---------- Data utama ---------- *@
                    <div class="row2">
                        <div class="field">
                            <label>No. Pesanan Penjualan <small>(otomatis)</small></label>
                            <input type="text" value="@kodePesananPenjualan" disabled />
                        </div>
                        <div class="field">
                            <label>Tanggal Pesanan <b class="req">*</b></label>
                            <input type="date" value="@tglPesananInput" max="@Iso(HariIni)"
                                   disabled="@(items.Count > 0)"
                                   @onchange="UbahTglPesanan" />
                        </div>
                    </div>

                    <div class="row2">
                        <div class="field">
                            <label>Tanggal Pengambilan <b class="req">*</b></label>
                            <input type="date" value="@tglPengambilanInput" min="@tglPesananInput"
                                   disabled="@(items.Count > 0)"
                                   @onchange="e => tglPengambilanInput = e.Value?.ToString() ?? string.Empty" />
                        </div>
                        <div class="field">
                            <label>Metode Pembayaran <b class="req">*</b></label>
                            <select @bind="metodePembayaranInput">
                                <option value="">Pilih metode pembayaran</option>
                                <option value="Tunai">Tunai</option>
                                <option value="Debit">Debit</option>
                            </select>
                        </div>
                    </div>

                    <div class="field">
                        <label>Nama Pelanggan <b class="req">*</b></label>
                        <div class="pick-row">
                            <input type="text" readonly placeholder="Belum ada pelanggan dipilih"
                                   value="@(pelangganDipilih?.NamaPelanggan ?? "")" />
                            <button type="button" class="btn-mini solid"
                                    disabled="@(items.Count > 0)" @onclick="BukaPencarianPelanggan">
                                <i class="fa-solid fa-magnifying-glass"></i> Cari
                            </button>
                        </div>
                        @if (items.Count > 0)
                        {
                            <span class="hint">Tanggal pesanan, tanggal pengambilan, dan pelanggan terkunci selama masih ada item</span>
                        }
                    </div>

                    <div class="field">
                        <label>Keterangan</label>
                        <textarea rows="3" maxlength="255" placeholder="Keterangan pesanan (opsional)"
                                  @bind="KeteranganInput" @bind:event="oninput"></textarea>
                    </div>

                    @* ---------- Data detail ---------- *@
                    <div class="section-head">
                        <h6>Data Detail</h6>
                        <span class="count-tag">@items.Count item</span>
                    </div>

                    <div class="detail-form @(indeksEdit >= 0 ? "editing" : "")">
                        <div class="field">
                            <label>Menu Makanan <b class="req">*</b></label>
                            <div class="pick-row">
                                <input type="text" readonly placeholder="Belum ada menu makanan dipilih"
                                       value="@(menuMakananDipilih?.NamaMenuMakanan ?? "")" />
                                <button type="button" class="btn-mini solid" @onclick="BukaPencarianMenuMakanan">
                                    <i class="fa-solid fa-magnifying-glass"></i> Cari
                                </button>
                            </div>
                        </div>

                        <div class="row4">
                            <div class="field">
                                <label>Jumlah <b class="req">*</b></label>
                                <input type="number" step="1" min="0" max="999" placeholder="0"
                                       @bind="jumlahInput" @bind:event="oninput" />
                            </div>
                            <div class="field">
                                <label>Satuan</label>
                                <input type="text" disabled placeholder="-"
                                       value="@(string.IsNullOrEmpty(idSatuanInput) ? "" : NamaSatuan(idSatuanInput))" />
                            </div>
                            <div class="field">
                                <label>Harga</label>
                                <input type="text" disabled placeholder="0" value="@HargaInput" />
                            </div>
                            <div class="field">
                                <label>Subtotal</label>
                                <input type="text" disabled value="@SubtotalInput" />
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(detailError))
                        {
                            <div class="banner in-dialog">
                                <i class="fa-solid fa-circle-exclamation"></i>
                                <span>@detailError</span>
                            </div>
                        }

                        <div class="detail-actions">
                            @if (indeksEdit >= 0)
                            {
                                <button type="button" class="btn-mini" @onclick="KosongkanInputDetail">Batal Ubah</button>
                            }
                            <button type="button" class="btn-mini solid" @onclick="TambahAtauUbahDetail">
                                <i class="fa-solid @(indeksEdit >= 0 ? "fa-check" : "fa-plus")"></i>
                                @(indeksEdit >= 0 ? "Perbarui Item" : "Tambah Item")
                            </button>
                        </div>
                    </div>

                    <div class="detail-wrap">
                        <table class="detail-table">
                            <thead>
                                <tr>
                                    <th>Menu Makanan</th>
                                    <th>Jumlah</th>
                                    <th>Satuan</th>
                                    <th>Harga</th>
                                    <th>Subtotal</th>
                                    <th class="actions">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < items.Count; i++)
                                {
                                    var index = i;
                                    var it = items[index];
                                    <tr class="@(index == indeksEdit ? "row-edit" : "")">
                                        <td>
                                            <div class="name">@it.NamaMenu</div>
                                            <div class="sub">@it.IdMenu</div>
                                        </td>
                                        <td class="mono">@FormatAngka(it.Jumlah)</td>
                                        <td>@NamaSatuan(it.IdSatuan)</td>
                                        <td class="mono">@FormatAngka(it.Harga)</td>
                                        <td class="mono">@FormatAngka(it.Jumlah * it.Harga)</td>
                                        <td class="actions">
                                            <button type="button" class="icon-btn" title="Ubah item"
                                                    @onclick="() => MulaiUbahDetail(index)">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>
                                            <button type="button" class="icon-btn danger" title="Hapus item"
                                                    @onclick="() => HapusDetail(index)">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @if (items.Count == 0)
                        {
                            <div class="detail-empty">
                                Belum ada item. Klik "Cari" untuk memilih menu makanan, isi jumlah dan satuan, lalu klik "Tambah Item"
                            </div>
                        }
                    </div>

                    @* ---------- Uang muka & total ---------- *@
                    <div class="row2" style="margin-top: 20px;">
                        <div class="field">
                            <label>Uang Muka <b class="req">*</b></label>
                            <input type="number" step="1" min="0" placeholder="0"
                                   @bind="uangMukaInput" @bind:event="oninput" />
                        </div>
                        <div class="field">
                            <label>Total Harga</label>
                            <input type="text" disabled value="@FormatAngka(TotalHarga)" />
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="banner in-dialog">
                            <i class="fa-solid fa-circle-exclamation"></i>
                            <span>@modalError</span>
                        </div>
                    }
                </div>

                @* ---------- Footer modal ---------- *@
                <footer class="dialog-foot">
                    <button type="button" class="btn-ghost" @onclick="TutupModal">Batalkan</button>
                    <button type="button" class="btn-solid" disabled="@sedangSimpan" @onclick="SimpanData">
                        @if (sedangSimpan)
                        {
                            <i class="fa-solid fa-spinner fa-spin"></i> <span>Menyimpan...</span>
                        }
                        else
                        {
                            <span>Simpan</span>
                        }
                    </button>
                </footer>
            </div>
        </div>
    }

    @* ================= 6. MODAL CARI PELANGGAN ================= *@
    @if (cariPelangganTampil)
    {
        var pelangganView = DaftarPelangganAktif.ToList();

        <div class="overlay stacked" @onclick="TutupPencarianPelanggan">
            <div class="dialog wide" @onclick:stopPropagation>

                <header class="dialog-head">
                    <div>
                        <h5>Pilih Pelanggan</h5>
                        <p>Klik baris untuk memilih pelanggan</p>
                    </div>
                    <button type="button" class="dialog-close" title="Tutup" @onclick="TutupPencarianPelanggan">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </header>

                <div class="dialog-body">
                    <div class="batch-toolbar">
                        <label class="search">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="text" placeholder="Cari kode atau nama pelanggan..."
                                   @bind="teksCariPelanggan" @bind:event="oninput" />
                        </label>
                    </div>

                    <div class="detail-wrap">
                        <table class="detail-table batch-table">
                            <thead>
                                <tr>
                                    <th class="col-kode">Kode Pelanggan</th>
                                    <th>Nama Pelanggan</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in pelangganView)
                                {
                                    var row = r;
                                    <tr @onclick="() => PilihPelanggan(row)">
                                        <td class="mono">@row.IdPelanggan</td>
                                        <td><div class="name">@row.NamaPelanggan</div></td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @if (pelangganView.Count == 0)
                        {
                            <div class="detail-empty">Pelanggan aktif tidak ditemukan</div>
                        }
                    </div>
                </div>

                <footer class="dialog-foot">
                    <button type="button" class="btn-ghost" @onclick="TutupPencarianPelanggan">Batalkan</button>
                </footer>
            </div>
        </div>
    }

    @* ================= 7. MODAL CARI MENU MAKANAN ================= *@
    @if (cariMenuMakananTampil)
    {
        var menuView = DaftarMenuMakananAktif.ToList();

        <div class="overlay stacked" @onclick="TutupPencarianMenu">
            <div class="dialog wide" @onclick:stopPropagation>

                <header class="dialog-head">
                    <div>
                        <h5>Pilih Menu Makanan</h5>
                        <p>Klik baris untuk memilih menu makanan</p>
                    </div>
                    <button type="button" class="dialog-close" title="Tutup" @onclick="TutupPencarianMenu">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </header>

                <div class="dialog-body">
                    <div class="batch-toolbar">
                        <label class="search">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="text" placeholder="Cari kode atau nama menu makanan..."
                                   @bind="teksCariMenuMakanan" @bind:event="oninput" />
                        </label>
                    </div>

                    <div class="detail-wrap">
                        <table class="detail-table batch-table">
                            <thead>
                                <tr>
                                    <th class="col-kode">Kode Menu</th>
                                    <th>Nama Menu</th>
                                    <th>Harga</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in menuView)
                                {
                                    var row = r;
                                    <tr @onclick="() => PilihMenuMakanan(row)">
                                        <td class="mono">@row.IdMenuMakanan</td>
                                        <td><div class="name">@row.NamaMenuMakanan</div></td>
                                        <td class="mono">@FormatAngka(row.Harga)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @if (menuView.Count == 0)
                        {
                            <div class="detail-empty">Menu makanan aktif tidak ditemukan</div>
                        }
                    </div>
                </div>

                <footer class="dialog-foot">
                    <button type="button" class="btn-ghost" @onclick="TutupPencarianMenu">Batalkan</button>
                </footer>
            </div>
        </div>
    }

    @* ================= 8. BUKTI PESANAN CETAK ================= *@
    @if (buktiCetak is not null)
    {
        var b = buktiCetak;
        var nomor = 0;

        <div id="bukti-cetak" class="bukti">

            <header class="bukti-kop">
                <img src="images/logo.png" class="bukti-logo" alt="" onerror="this.style.display='none'" />
                <div class="bukti-judul">
                    <h1>Bukti Pesanan Penjualan</h1>
                    <div class="bukti-usaha">@NamaUsaha</div>
                    <div class="bukti-alamat">@AlamatUsaha</div>
                </div>
                <div></div>
            </header>

            <hr class="bukti-garis" />

            <div class="bukti-meta">
                <span>Dicetak oleh: <b>@namaPencetak</b></span>
                <span>Tanggal Cetak: <b>@Tgl(HariIni)</b></span>
            </div>

            <div class="bukti-info">
                <table>
                    <tr>
                        <th>Kode Pelanggan</th>
                        <td class="sep">:</td>
                        <td class="isi">@b.IdPelanggan</td>
                    </tr>
                    <tr>
                        <th>Nama Pelanggan</th>
                        <td class="sep">:</td>
                        <td class="isi">@NamaPelanggan(b.IdPelanggan)</td>
                    </tr>
                    <tr>
                        <th>Uang Muka</th>
                        <td class="sep">:</td>
                        <td class="isi">Rp @FormatAngka(b.UangMuka)</td>
                    </tr>
                    <tr>
                        <th>Keterangan</th>
                        <td class="sep">:</td>
                        <td class="isi">@(string.IsNullOrWhiteSpace(b.Keterangan) ? "-" : b.Keterangan)</td>
                    </tr>
                </table>

                <table>
                    <tr>
                        <th>No. Pesanan</th>
                        <td class="sep">:</td>
                        <td class="isi">@b.IdPesanan</td>
                    </tr>
                    <tr>
                        <th>Tgl Pesanan</th>
                        <td class="sep">:</td>
                        <td class="isi">@Tgl(b.TglPesanan)</td>
                    </tr>
                    <tr>
                        <th>Tgl Pengambilan</th>
                        <td class="sep">:</td>
                        <td class="isi">@Tgl(b.TglPengambilan)</td>
                    </tr>
                    <tr>
                        <th>Pembayaran</th>
                        <td class="sep">:</td>
                        <td class="isi">@(string.IsNullOrWhiteSpace(b.MetodePembayaran) ? "-" : b.MetodePembayaran)</td>
                    </tr>
                </table>
            </div>

            <table class="bukti-tabel">
                <colgroup>
                    <col style="width:44px" />
                    <col style="width:120px" />
                    <col />
                    <col style="width:90px" />
                    <col style="width:100px" />
                </colgroup>
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>Kode Menu</th>
                        <th>Nama Menu</th>
                        <th>Jumlah</th>
                        <th>Satuan</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in b.Details)
                    {
                        <tr>
                            <td class="c">@(++nomor)</td>
                            <td class="c">@d.IdMenu</td>
                            <td>@NamaMenuMakanan(d.IdMenu)</td>
                            <td class="c">@FormatAngka(d.Jumlah)</td>
                            <td class="c">@NamaSatuan(d.IdSatuan)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="bukti-ttd">
                <div><p>Penerima</p><div class="garis"></div></div>
                <div><p>Hormat kami</p><div class="garis"></div></div>
            </div>
        </div>
    }

</div>

@code {
    // =====================================================
    // 1. STATE & MODEL
    // =====================================================
    private static readonly CultureInfo IdCulture = new("id-ID");

    private record PelangganRow(string IdPelanggan, string NamaPelanggan);
    private record MenuMakananRow(string IdMenuMakanan, string NamaMenuMakanan, string IdSatuan, decimal Harga);

    private class ItemDetailPesananPenjualan
    {
        public string IdMenu { get; set; } = "";
        public string NamaMenu { get; set; } = "";
        public string IdSatuan { get; set; } = "";
        public decimal Jumlah { get; set; }
        public decimal Harga { get; set; }
    }

    // --- data ---
    private List<PesananPenjualanModels> daftarPesananPenjualan = new();
    private List<PelangganModels> daftarPelanggan = new();
    private List<MenuMakananModels> daftarMenuMakanan = new();
    private List<SatuanBahanBakuModels> daftarSatuan = new();

    // --- halaman utama ---
    private bool isLoading = true;
    private string pesanSukses = "";
    private string pesanError = "";
    private string teksCari = "";

    // --- modal form: header ---
    private bool modalTampil = false;
    private bool isEditMode = false;
    private bool sedangSimpan = false;
    private string modalError = "";
    private string kodePesananPenjualan = "";
    private string tglPesananInput = "";
    private string tglPengambilanInput = "";
    private string metodePembayaranInput = "";
    private string uangMukaInput = "";
    private PelangganRow? pelangganDipilih;

    // Keterangan: huruf pertama otomatis kapital, maksimal 255 karakter
    private string keterangan = "";
    private string KeteranganInput
    {
        get => keterangan;
        set => keterangan = string.IsNullOrEmpty(value) ? "" : char.ToUpper(value[0]) + value[1..];
    }

    // --- modal form: detail ---
    private readonly List<ItemDetailPesananPenjualan> items = new();
    private int indeksEdit = -1;            // -1 = tambah item, >= 0 = ubah item
    private MenuMakananRow? menuMakananDipilih;
    private string jumlahInput = "";
    private string idSatuanInput = "";
    private string hargaInput = "";
    private string detailError = "";

    // --- modal cari pelanggan ---
    private bool cariPelangganTampil = false;
    private string teksCariPelanggan = "";

    // --- modal cari menu makanan ---
    private bool cariMenuMakananTampil = false;
    private string teksCariMenuMakanan = "";

    // =====================================================
    // 2. LIFECYCLE & MUAT DATA
    // =====================================================
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
            namaPencetak = (await AuthState).User.Identity?.Name ?? "";

        await MuatData();
    }

    private async Task MuatData()
    {
        isLoading = true;
        var galat = new List<string>();

        try { daftarPesananPenjualan = await PesananPenjualanService.GetAllAsync(); }
        catch (Exception ex) { galat.Add("Gagal memuat transaksi pesanan penjualan: " + ex.Message); }

        try { daftarPelanggan = await PelangganService.GetAllAsync(); }
        catch (Exception ex) { galat.Add("Gagal memuat pelanggan: " + ex.Message); }

        try { daftarMenuMakanan = await MenuMakananService.GetAllAsync(); }
        catch (Exception ex) { galat.Add("Gagal memuat menu makanan: " + ex.Message); }

        try { daftarSatuan = await SatuanBahanBakuService.GetAllAsync(); }
        catch (Exception ex) { galat.Add("Gagal memuat satuan: " + ex.Message); }

        pesanError = string.Join(" ", galat);
        isLoading = false;
    }

    // =====================================================
    // 3. HELPER UMUM (format & lookup nama)
    // =====================================================
    private static DateOnly HariIni => DateOnly.FromDateTime(DateTime.Today);

    private static string Iso(DateOnly d) => d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private static string FormatAngka(decimal v) => v.ToString("#,##0.##", IdCulture);

    // Warna avatar stabil per teks (string.GetHashCode() berubah tiap proses, jadi tidak dipakai)
    private static int Warna(string? teks) => (teks ?? "").Sum(ch => ch) % 5;

    private static bool TryParseAngka(string? teks, out decimal hasil)
    {
        hasil = 0;
        var t = (teks ?? "").Trim().Replace(',', '.');
        return t.Length > 0
               && decimal.TryParse(t, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out hasil)
               && hasil > 0;
    }

    // Uang muka boleh 0, tetapi tidak boleh negatif
    private static bool TryParseUangMuka(string? teks, out decimal hasil)
    {
        hasil = 0;
        var t = (teks ?? "").Trim().Replace(',', '.');
        return t.Length > 0
               && decimal.TryParse(t, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out hasil)
               && hasil >= 0;
    }

    private string NamaPelanggan(string? id)
        => daftarPelanggan.FirstOrDefault(p => p.IdPelanggan == id)?.NamaPelanggan ?? (id ?? "-");

    private string NamaMenuMakanan(string? id)
        => daftarMenuMakanan.FirstOrDefault(m => m.IdMenu == id)?.NamaMenu ?? (id ?? "-");

    private string NamaSatuan(string? id)
        => daftarSatuan.FirstOrDefault(s => s.IdSatuan == id)?.NamaSatuan ?? (id ?? "-");

    // =====================================================
    // 4. DAFTAR PESANAN PENJUALAN: PENCARIAN
    // =====================================================
    private IEnumerable<PesananPenjualanModels> Filtered => daftarPesananPenjualan
        .Where(p => string.IsNullOrWhiteSpace(teksCari)
            || (p.IdPesanan ?? "").Contains(teksCari, StringComparison.OrdinalIgnoreCase)
            || NamaPelanggan(p.IdPelanggan).Contains(teksCari, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(p => p.IdPesanan);

    private static bool IsClose(PesananPenjualanModels p)
        => string.Equals(p.Status, "Close", StringComparison.OrdinalIgnoreCase);

    // =====================================================
    // 5. MODAL FORM: BUKA / TUTUP / RESET
    // =====================================================
    // ID otomatis: PP + 7 digit
    private static string BuatIdBerikutnya(IEnumerable<PesananPenjualanModels> data)
    {
        const string prefix = "PP";

        var max = data
            .Select(c => c.IdPesanan)
            .Where(id => !string.IsNullOrEmpty(id)
                         && id.StartsWith(prefix)
                         && int.TryParse(id[prefix.Length..], out _))
            .Select(id => int.Parse(id[prefix.Length..]))
            .DefaultIfEmpty(0)
            .Max();

        return $"{prefix}{max + 1:D7}";
    }

    private async Task BukaModalTambah()
    {
        ResetForm();
        isEditMode = false;

        try
        {
            // data terbaru supaya nomor urut tidak basi
            var terbaru = await PesananPenjualanService.GetAllAsync();
            daftarMenuMakanan = await MenuMakananService.GetAllAsync();
            kodePesananPenjualan = BuatIdBerikutnya(terbaru);
        }
        catch (Exception ex)
        {
            pesanError = "Gagal menyiapkan form: " + ex.Message;
            return;
        }

        tglPesananInput = Iso(HariIni);
        tglPengambilanInput = Iso(HariIni);
        modalTampil = true;
    }

    private async Task BukaModalEdit(PesananPenjualanModels item)
    {
        if (IsClose(item)) return;

        ResetForm();

        // Daftar pesanan bisa saja tidak membawa detail, jadi ambil data lengkap per ID
        var lengkap = item;
        if (item.Details == null || !item.Details.Any())
        {
            try
            {
                lengkap = await PesananPenjualanService.GetByIdAsync(item.IdPesanan) ?? item;
            }
            catch (Exception ex)
            {
                pesanError = "Gagal memuat detail pesanan: " + ex.Message;
                return;
            }
        }

        isEditMode = true;
        kodePesananPenjualan = lengkap.IdPesanan;
        tglPesananInput = Iso(lengkap.TglPesanan);
        tglPengambilanInput = Iso(lengkap.TglPengambilan);
        metodePembayaranInput = lengkap.MetodePembayaran ?? "";
        uangMukaInput = lengkap.UangMuka.ToString("0.##", CultureInfo.InvariantCulture);
        KeteranganInput = lengkap.Keterangan ?? "";
        pelangganDipilih = new PelangganRow(lengkap.IdPelanggan, NamaPelanggan(lengkap.IdPelanggan));

        foreach (var d in lengkap.Details)
        {
            items.Add(new ItemDetailPesananPenjualan
            {
                IdMenu = d.IdMenu,
                NamaMenu = NamaMenuMakanan(d.IdMenu),
                IdSatuan = d.IdSatuan,
                Jumlah = d.Jumlah,
                Harga = d.Harga
            });
        }

        modalTampil = true;
    }

    private void ResetForm()
    {
        pesanSukses = "";
        pesanError = "";
        modalError = "";
        cariPelangganTampil = false;
        cariMenuMakananTampil = false;
        pelangganDipilih = null;
        metodePembayaranInput = "";
        uangMukaInput = "";
        keterangan = "";
        items.Clear();
        KosongkanInputDetail();
    }

    private void TutupModal()
    {
        cariPelangganTampil = false;
        cariMenuMakananTampil = false;
        modalTampil = false;
    }

    // Tanggal pengambilan tidak boleh lebih awal dari tanggal pesanan
    private void UbahTglPesanan(ChangeEventArgs e)
    {
        tglPesananInput = e.Value?.ToString() ?? string.Empty;

        if (DateOnly.TryParseExact(tglPesananInput, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var pesan)
            && DateOnly.TryParseExact(tglPengambilanInput, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var ambil)
            && ambil < pesan)
        {
            tglPengambilanInput = tglPesananInput;
        }
    }

