    // =====================================================
    // 8. MODAL FORM: DETAIL (ITEM PESANAN)
    // =====================================================
    private string HargaInput
        => TryParseAngka(hargaInput, out var h) ? FormatAngka(h) : "";

    private string SubtotalInput
        => TryParseAngka(jumlahInput, out var j) && TryParseAngka(hargaInput, out var h)
            ? FormatAngka(j * h)
            : "";

    private decimal TotalHarga => items.Sum(i => i.Jumlah * i.Harga);

    private void KosongkanInputDetail()
    {
        indeksEdit = -1;
        menuMakananDipilih = null;
        jumlahInput = "";
        idSatuanInput = "";
        hargaInput = "";
        detailError = "";
    }

    private void MulaiUbahDetail(int index)
    {
        var it = items[index];

        indeksEdit = index;
        detailError = "";
        menuMakananDipilih = new MenuMakananRow(it.IdMenu, it.NamaMenu, it.IdSatuan, it.Harga);
        jumlahInput = it.Jumlah.ToString("0.##", CultureInfo.InvariantCulture);
        idSatuanInput = it.IdSatuan;
        hargaInput = it.Harga.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private void TambahAtauUbahDetail()
    {
        detailError = "";

        if (pelangganDipilih is null)
        {
            detailError = "Harap pilih pelanggan terlebih dahulu";
            return;
        }

        if (string.IsNullOrWhiteSpace(metodePembayaranInput))
        {
            detailError = "Harap pilih metode pembayaran";
            return;
        }

        if (menuMakananDipilih is null)
        {
            detailError = "Harap pilih menu terlebih dahulu";
            return;
        }

        if (string.IsNullOrWhiteSpace(jumlahInput))
        {
            detailError = "Harap masukkan jumlah pesanan";
            return;
        }

        if (!TryParseAngka(jumlahInput, out var jumlah) || jumlah != decimal.Truncate(jumlah))
        {
            detailError = "Jumlah menu harus berupa angka bulat lebih dari 0";
            return;
        }

        if (jumlah > 999)
        {
            detailError = "Jumlah menu maksimal 3 digit";
            return;
        }

        if (string.IsNullOrWhiteSpace(idSatuanInput))
        {
            detailError = "Menu yang dipilih belum memiliki satuan";
            return;
        }

        if (!TryParseAngka(hargaInput, out var harga))
        {
            detailError = "Harga menu tidak valid";
            return;
        }

        // Duplikat = menu yang sama
        var kembar = items
            .Where((it, i) => i != indeksEdit)
            .Any(it => it.IdMenu == menuMakananDipilih.IdMenuMakanan);

        if (kembar)
        {
            detailError = $"Menu {menuMakananDipilih.NamaMenuMakanan} sudah ada di daftar pesanan penjualan";
            return;
        }

        var item = new ItemDetailPesananPenjualan
        {
            IdMenu = menuMakananDipilih.IdMenuMakanan,
            NamaMenu = menuMakananDipilih.NamaMenuMakanan,
            IdSatuan = idSatuanInput,
            Jumlah = jumlah,
            Harga = harga
        };

        if (indeksEdit == -1) items.Add(item);   // TAMBAH ITEM
        else items[indeksEdit] = item;           // UBAH ITEM

        KosongkanInputDetail();
    }

    private void HapusDetail(int index)
    {
        items.RemoveAt(index);

        if (indeksEdit == index) KosongkanInputDetail();
        else if (indeksEdit > index) indeksEdit--;
    }

    // =====================================================
    // 9. MODAL FORM: SIMPAN
    // =====================================================
    private async Task SimpanData()
    {
        modalError = "";

        if (string.IsNullOrWhiteSpace(kodePesananPenjualan))
        {
            modalError = "No. Pesanan belum ter-generate, coba buka form kembali";
            return;
        }

        if (pelangganDipilih is null)
        {
            modalError = "Harap pilih pelanggan terlebih dahulu";
            return;
        }

        if (!DateOnly.TryParseExact(tglPesananInput, "yyyy-MM-dd", CultureInfo.InvariantCulture,
                                    DateTimeStyles.None, out var tglPesanan))
        {
            modalError = "Harap isi tanggal pesanan";
            return;
        }

        if (tglPesanan > HariIni)
        {
            modalError = "Tanggal pesanan tidak boleh lebih dari hari ini";
            return;
        }

        if (!DateOnly.TryParseExact(tglPengambilanInput, "yyyy-MM-dd", CultureInfo.InvariantCulture,
                                    DateTimeStyles.None, out var tglPengambilan))
        {
            modalError = "Harap isi tanggal pengambilan";
            return;
        }

        if (tglPengambilan < tglPesanan)
        {
            modalError = "Tanggal pengambilan tidak boleh lebih awal dari tanggal pesanan";
            return;
        }

        if (string.IsNullOrWhiteSpace(metodePembayaranInput))
        {
            modalError = "Harap pilih metode pembayaran";
            return;
        }

        if (string.IsNullOrWhiteSpace(uangMukaInput))
        {
            modalError = "Harap masukkan uang muka pesanan";
            return;
        }

        if (!TryParseUangMuka(uangMukaInput, out var uangMuka) || uangMuka != decimal.Truncate(uangMuka))
        {
            modalError = "Uang muka harus berupa angka bulat";
            return;
        }

        if (items.Count == 0)
        {
            modalError = $"Harap tambahkan minimal satu menu untuk pesanan {kodePesananPenjualan}";
            return;
        }

        // Uang muka tidak boleh melebihi atau sama dengan total pesanan
        var total = TotalHarga;
        if (uangMuka >= total)
        {
            modalError = "Uang muka tidak boleh lebih besar dari atau sama dengan total pesanan";
            return;
        }

        sedangSimpan = true;
        try
        {
            var model = new PesananPenjualanModels
            {
                IdPesanan = kodePesananPenjualan,
                IdPelanggan = pelangganDipilih.IdPelanggan,
                MetodePembayaran = metodePembayaranInput,
                TglPesanan = tglPesanan,
                TglPengambilan = tglPengambilan,
                UangMuka = uangMuka,
                Total = total,
                Keterangan = keterangan,
                Status = "Pending",
                Details = items.Select(i => new DetailPesananPenjualan
                {
                    IdMenu = i.IdMenu,
                    IdSatuan = i.IdSatuan,
                    Jumlah = i.Jumlah,
                    Harga = i.Harga
                }).ToList()
            };

            var (success, error) = isEditMode
                ? await PesananPenjualanService.UpdateAsync(kodePesananPenjualan, model)
                : await PesananPenjualanService.CreateAsync(model);

            if (success)
            {
                pesanSukses = $"No. Pesanan {kodePesananPenjualan} atas nama {pelangganDipilih.NamaPelanggan} berhasil {(isEditMode ? "diperbarui" : "ditambahkan")}";
                modalTampil = false;
                await MuatData();
            }
            else
            {
                modalError = error;
            }
        }
        catch (Exception ex)
        {
            modalError = "Gagal menyimpan: " + ex.Message;
        }
        finally
        {
            sedangSimpan = false;
        }
    }

    // =====================================================
    // 10. BUKTI PESANAN (CETAK)
    // =====================================================
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private PesananPenjualanModels? buktiCetak;
    private bool perluCetak;
    private bool sedangCetak;
    private string namaPencetak = "";
    private IJSObjectReference? modulCetak;

    private string NamaUsaha => Config["Usaha:Nama"] ?? "";

    private string AlamatUsaha => Config["Usaha:Alamat"] ?? "";

    private static string Tgl(DateOnly d) => d.ToString("dd/MM/yyyy", IdCulture);

    private async Task CetakBukti(PesananPenjualanModels item)
    {
        pesanError = "";
        sedangCetak = true;

        try
        {
            // Daftar pesanan bisa saja tidak membawa detail, jadi ambil data lengkap per ID
            var lengkap = item;
            if (item.Details == null || !item.Details.Any())
                lengkap = await PesananPenjualanService.GetByIdAsync(item.IdPesanan) ?? item;

            if (lengkap.Details == null || !lengkap.Details.Any())
            {
                pesanError = $"Pesanan {item.IdPesanan} tidak memiliki detail menu";
                return;
            }

            buktiCetak = lengkap;
            perluCetak = true;   // dicetak di OnAfterRenderAsync, setelah bukti ada di DOM
        }
        catch (Exception ex)
        {
            pesanError = "Gagal menyiapkan bukti pesanan: " + ex.Message;
        }
        finally
        {
            sedangCetak = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!perluCetak || buktiCetak is null) return;
        perluCetak = false;

        // Judul ini juga menjadi nama file bawaan saat disimpan sebagai PDF
        modulCetak ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/cetak.js");
        await modulCetak.InvokeVoidAsync("cetakElemen", "bukti-cetak", $"Bukti Pesanan Penjualan {buktiCetak.IdPesanan}");
    }

    public async ValueTask DisposeAsync()
    {
        if (modulCetak is null) return;

        try { await modulCetak.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
