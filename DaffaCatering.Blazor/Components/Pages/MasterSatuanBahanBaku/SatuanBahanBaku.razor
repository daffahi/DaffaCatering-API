@page "/satuan-bahan-baku"
@attribute [Authorize(Roles = AppRoles.AdminPersediaan)]

@inject SatuanBahanBakuService SatuanBahanBakuService

@{
    var hasil = Filtered.ToList();
    var totalHalaman = Math.Max(1, (int)Math.Ceiling(hasil.Count / (double)UkuranHalaman));
    if (halaman > totalHalaman) halaman = totalHalaman;

    var view = hasil.Skip((halaman - 1) * UkuranHalaman).Take(UkuranHalaman).ToList();
    var awal = hasil.Count == 0 ? 0 : (halaman - 1) * UkuranHalaman + 1;
    var akhir = awal == 0 ? 0 : awal + view.Count - 1;
}

<div class="satuan-bahan-baku-page">

    @* ================= HEADER HALAMAN ================= *@
    <header class="page-head">
        <div>
            <h1>Satuan Bahan Baku</h1>
            <p>Kelola data satuan bahan baku dalam satu tempat</p>
        </div>
        <button class="btn-add" @onclick="BukaModalTambah">
            <i class="fa-solid fa-plus"></i> Tambah Satuan Bahan Baku
        </button>
    </header>

    @* ================= NOTIFIKASI ================= *@
    <NotifBanner Sukses @bind-Pesan="pesanSukses" />
    <NotifBanner @bind-Pesan="pesanError" />

    @* ================= TOOLBAR: SEARCH ================= *@
    <section class="toolbar-card">
        <label class="search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="Cari ID atau nama satuan..."
                   @bind="teksCari" @bind:event="oninput" />
        </label>
    </section>

    @* ================= TABEL SATUAN BAHAN BAKU ================= *@
    <section class="panel">

        @if (isLoading)
        {
            <div class="skeleton">
                @for (var s = 0; s < 6; s++)
                {
                    <div class="sk-row">
                        <div class="sk-avatar"></div>
                        <div class="sk-lines"><div></div><div></div></div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Satuan Bahan Baku</th>
                            <th class="actions">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (item, i) in view.Select((item, i) => (item, i)))
                        {
                            <tr @key="item.IdSatuan" style="--i:@Math.Min(i, 12)">
                                <td>
                                    <div class="who">
                                        <div class="avatar tone-@Warna(item.NamaSatuan)">@Inisial(item.NamaSatuan)</div>
                                        <div>
                                            <div class="name">@item.NamaSatuan</div>
                                            <div class="sub">@item.IdSatuan</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="actions">
                                    <button class="icon-btn" title="Edit" @onclick="() => BukaModalEdit(item)">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (view.Count == 0)
                {
                    <div class="empty">
                        <i class="fa-regular fa-face-frown-open"></i>
                        <strong>Satuan bahan baku tidak ditemukan</strong>
                        <span>Coba ubah kata kunci pencarian</span>
                    </div>
                }
            </div>

            <div class="panel-foot">
                <span>Menampilkan <b>@awal–@akhir</b> dari <b>@hasil.Count</b> satuan bahan baku</span>

                <div class="pager">
                    @if (halaman > 1)
                    {
                        <button class="pg-btn" @onclick="() => halaman--">
                            <i class="fa-solid fa-chevron-left"></i> Sebelumnya
                        </button>
                    }

                    <span class="pg-info">Halaman <b>@halaman</b> / @totalHalaman</span>

                    @if (halaman < totalHalaman)
                    {
                        <button class="pg-btn" @onclick="() => halaman++">
                            Berikutnya <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    }
                </div>
            </div>
        }
    </section>

    @* ================= MODAL FORM SATUAN BAHAN BAKU ================= *@
    @if (modalTampil)
    {
        <div class="overlay" @onclick="TutupModal">
            <div class="dialog" @onclick:stopPropagation>
                <EditForm Model="formModel" OnValidSubmit="SimpanData">
                    <DataAnnotationsValidator />

                    @* ---------- Header modal ---------- *@
                    <header class="dialog-head">
                        <div>
                            <h5>@(isEditMode ? "Ubah" : "Tambah") Satuan Bahan Baku</h5>
                            <p>@(isEditMode ? "Perbarui data satuan bahan baku" : "Isi data satuan bahan baku baru")</p>
                        </div>
                        <button type="button" class="dialog-close" title="Tutup" @onclick="TutupModal">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </header>

                    @* ---------- Isi form ---------- *@
                    <div class="dialog-body">
                        <div class="field">
                            <label>ID Satuan <small>(otomatis)</small></label>
                            <InputText @bind-Value="formModel.IdSatuan" disabled="true" />
                        </div>

                        <div class="field">
                            <label>Nama Satuan <b class="req">*</b></label>
                            <InputText @bind-Value="formModel.NamaSatuan" placeholder="Contoh: Kg, Liter, Pcs" />
                            <ValidationMessage For="() => formModel.NamaSatuan" />
                        </div>

                        @if (!string.IsNullOrEmpty(modalError))
                        {
                            <div class="banner in-dialog">
                                <i class="fa-solid fa-circle-exclamation"></i>
                                <span>@modalError</span>
                            </div>
                        }
                    </div>

                    @* ---------- Footer modal ---------- *@
                    <footer class="dialog-foot">
                        <button type="button" class="btn-ghost" @onclick="TutupModal">Batalkan</button>
                        <button type="submit" class="btn-solid" disabled="@sedangSimpan">
                            @if (sedangSimpan)
                            {
                                <i class="fa-solid fa-spinner fa-spin"></i> <span>Menyimpan...</span>
                            }
                            else
                            {
                                <span>Simpan</span>
                            }
                        </button>
                    </footer>
                </EditForm>
            </div>
        </div>
    }

</div>

@code {
    // =====================================================
    // STATE
    // =====================================================
    // --- data & halaman utama ---
    private List<SatuanBahanBakuModels> daftarSatuan = new();
    private bool isLoading = true;
    private string pesanSukses = "";
    private string pesanError = "";

    // --- pagination & pencarian ---
    private const int UkuranHalaman = 10;
    private int halaman = 1;

    private string _teksCari = "";
    private string teksCari
    {
        get => _teksCari;
        set { _teksCari = value; halaman = 1; }
    }

    // --- modal form ---
    private bool modalTampil = false;
    private bool isEditMode = false;
    private bool sedangSimpan = false;
    private string modalError = "";
    private SatuanBahanBakuModels formModel = new();

    // =====================================================
    // LIFECYCLE & MUAT DATA
    // =====================================================
    protected override async Task OnInitializedAsync()
    {
        await MuatData();
    }

    private async Task MuatData()
    {
        isLoading = true;
        pesanError = "";

        try
        {
            daftarSatuan = await SatuanBahanBakuService.GetAllAsync();
        }
        catch (Exception ex)
        {
            pesanError = $"Gagal memuat data satuan bahan baku: {ex.Message.TrimEnd('.')}.";
        }

        isLoading = false;
    }

    // =====================================================
    // HELPER TAMPILAN
    // =====================================================
    private static string Inisial(string? nama)
    {
        var p = (nama ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length == 0 ? "?"
             : p.Length == 1 ? p[0][..1].ToUpper()
             : (p[0][..1] + p[^1][..1]).ToUpper();
    }

    // Warna avatar stabil per nama (string.GetHashCode() berubah tiap proses, jadi tidak dipakai)
    private static int Warna(string? nama) => (nama ?? "").Sum(ch => ch) % 5;

    // =====================================================
    // DAFTAR: PENCARIAN
    // =====================================================
    private IEnumerable<SatuanBahanBakuModels> Filtered => daftarSatuan
        .Where(c => string.IsNullOrWhiteSpace(teksCari)
            || (c.IdSatuan ?? "").Contains(teksCari, StringComparison.OrdinalIgnoreCase)
            || (c.NamaSatuan ?? "").Contains(teksCari, StringComparison.OrdinalIgnoreCase));

    // =====================================================
    // 5. MODAL FORM: BUKA / TUTUP
    // =====================================================
    // ID otomatis: SBB + 7 digit
    private static string BuatIdBerikutnya(IEnumerable<SatuanBahanBakuModels> data)
    {
        const string prefix = "SBB";

        var max = data
            .Select(c => c.IdSatuan)
            .Where(id => !string.IsNullOrEmpty(id)
                         && id.StartsWith(prefix)
                         && int.TryParse(id[prefix.Length..], out _))
            .Select(id => int.Parse(id[prefix.Length..]))
            .DefaultIfEmpty(0)
            .Max();

        return $"{prefix}{max + 1:D7}";
    }

    private async Task BukaModalTambah()
    {
        formModel = new SatuanBahanBakuModels();
        isEditMode = false;
        modalError = "";

        try
        {
            // data terbaru supaya nomor urut tidak basi
            var terbaru = await SatuanBahanBakuService.GetAllAsync();
            formModel.IdSatuan = BuatIdBerikutnya(terbaru);
        }
        catch (Exception ex)
        {
            pesanError = $"Gagal menghasilkan ID: {ex.Message.TrimEnd('.')}.";
            return;
        }

        modalTampil = true;
    }

    private void BukaModalEdit(SatuanBahanBakuModels item)
    {
        formModel = new SatuanBahanBakuModels
        {
            IdSatuan = item.IdSatuan,
            NamaSatuan = item.NamaSatuan
        };
        isEditMode = true;
        modalError = "";
        modalTampil = true;
    }

    private void TutupModal()
    {
        modalTampil = false;
    }

    // =====================================================
    // MODAL FORM: SIMPAN
    // =====================================================
    private async Task SimpanData()
    {
        sedangSimpan = true;
        modalError = "";

        var (success, error) = isEditMode
            ? await SatuanBahanBakuService.UpdateAsync(formModel.IdSatuan, formModel)
            : await SatuanBahanBakuService.CreateAsync(formModel);

        if (success)
        {
            pesanSukses = $"Satuan Bahan Baku {formModel.NamaSatuan} dengan kode {formModel.IdSatuan} berhasil " + (isEditMode ? "diperbarui." : "ditambahkan.");
            modalTampil = false;
            await MuatData();
        }
        else
        {
            modalError = error;
        }

        sedangSimpan = false;
    }
}