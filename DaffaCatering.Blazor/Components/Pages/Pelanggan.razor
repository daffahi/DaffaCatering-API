@page "/pelanggan"
@inject PelangganService PelangganService

<h3>Customers</h3>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else
{
    <button class="btn btn-success mb-3" @onclick="BukaModalTambah">
        <i class="fa-solid fa-plus"></i> Add Customer
    </button>

    @if (!string.IsNullOrEmpty(pesanError))
    {
        <div class="alert alert-danger">@pesanError</div>
    }

    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Contact</th>
                <th>Address</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in daftarPelanggan)
            {
                <tr>
                    <td>@item.IdPelanggan</td>
                    <td>@item.NamaPelanggan</td>
                    <td>@item.NoKontak</td>
                    <td>@item.Alamat</td>
                    <td>
                        @if (item.Status)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => BukaModalEdit(item)">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => HapusData(item.IdPelanggan)">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (modalTampil)
{
    <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditMode ? "Edit" : "Add") Customer</h5>
                    <button type="button" class="btn-close" @onclick="TutupModal"></button>
                </div>
                <EditForm Model="formModel" OnValidSubmit="SimpanData">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">ID Customer</label>
                            <InputText class="form-control" @bind-Value="formModel.IdPelanggan" disabled="@isEditMode" />
                            <ValidationMessage For="() => formModel.IdPelanggan" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="formModel.NamaPelanggan" />
                            <ValidationMessage For="() => formModel.NamaPelanggan" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Contact</label>
                            <InputText class="form-control" @bind-Value="formModel.NoKontak" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Address</label>
                            <InputTextArea class="form-control" @bind-Value="formModel.Alamat" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Join Date</label>
                            <InputDate class="form-control" @bind-Value="formModel.TglBergabung" />
                        </div>
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="formModel.Status" />
                            <label class="form-check-label">Active</label>
                        </div>

                        @if (!string.IsNullOrEmpty(modalError))
                        {
                            <div class="alert alert-danger mt-2">@modalError</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="TutupModal">Cancel</button>
                        <button type="submit" class="btn btn-success" disabled="@sedangSimpan">
                            @(sedangSimpan ? "Saving..." : "Save")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<PelangganModels> daftarPelanggan = new();
    private bool isLoading = true;
    private string pesanError = "";

    private bool modalTampil = false;
    private bool isEditMode = false;
    private bool sedangSimpan = false;
    private string modalError = "";
    private PelangganModels formModel = new();

    protected override async Task OnInitializedAsync()
    {
        await MuatData();
    }

    private async Task MuatData()
    {
        isLoading = true;
        try
        {
            daftarPelanggan = await PelangganService.GetAllAsync();
        }
        catch (Exception ex)
        {
            pesanError = "Failed to load data: " + ex.Message;
        }
        isLoading = false;
    }

    private void BukaModalTambah()
    {
        formModel = new PelangganModels();
        isEditMode = false;
        modalError = "";
        modalTampil = true;
    }

    private void BukaModalEdit(PelangganModels item)
    {
        formModel = new PelangganModels
        {
            IdPelanggan = item.IdPelanggan,
            NamaPelanggan = item.NamaPelanggan,
            NoKontak = item.NoKontak,
            Alamat = item.Alamat,
            TglBergabung = item.TglBergabung,
            Status = item.Status
        };
        isEditMode = true;
        modalError = "";
        modalTampil = true;
    }

    private void TutupModal()
    {
        modalTampil = false;
    }

    private async Task SimpanData()
    {
        sedangSimpan = true;
        modalError = "";

        var (success, error) = isEditMode
            ? await PelangganService.UpdateAsync(formModel.IdPelanggan, formModel)
            : await PelangganService.CreateAsync(formModel);

        if (success)
        {
            modalTampil = false;
            await MuatData();
        }
        else
        {
            modalError = error;
        }

        sedangSimpan = false;
    }

    private async Task HapusData(string id)
    {
        var (success, error) = await PelangganService.DeleteAsync(id);
        if (success)
        {
            await MuatData();
        }
        else
        {
            pesanError = error;
        }
    }
}