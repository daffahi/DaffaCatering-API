  "jumlah": 10,
  "harga": 25000,
  "status": true
}

### ============ HEADER BAHAN BAKU + DETAIL BAHAN BAKU ============
### Get All
GET {{DaffaCatering.API_HostAddress}}/api/HeaderBahanBaku

### Get All (filter status=true)
GET {{DaffaCatering.API_HostAddress}}/api/HeaderBahanBaku?status=true

### Get By ID
GET {{DaffaCatering.API_HostAddress}}/api/HeaderBahanBaku/BB0000016

### Create dengan Detail
POST {{DaffaCatering.API_HostAddress}}/api/HeaderBahanBaku
Content-Type: application/json

{
  "idBahanBaku": "BB0000017",
  "namaBahanBaku": "Test Bahan Baku 2 dengan Detail",
  "jenis": true,
  "status": true,
  "details": [
    { "tglKadaluwarsa": "2026-12-01", "idSatuan": "SBB0000011", "stokAwal": 100, "sisaStok": 100 },
    { "tglKadaluwarsa": "2026-11-15", "idSatuan": "SBB0000011", "stokAwal": 50, "sisaStok": 50 }
  ]
}

### ============ HEADER PEMBELIAN + DETAIL PEMBELIAN ============
### Get All
GET {{DaffaCatering.API_HostAddress}}/api/HeaderPembelian

### Get By ID
GET {{DaffaCatering.API_HostAddress}}/api/HeaderPembelian/PB0000010

### Create - dengan Pemasok valid & 2 item detail
POST {{DaffaCatering.API_HostAddress}}/api/HeaderPembelian
Content-Type: application/json

{
  "idPembelian": "PB0000010",
  "idPemasok": "PMS0000013",
  "tglPembelian": "2026-09-21",
  "status": "Open",
  "details": [
    { "idBahanBaku": "BB0000016", "idSatuan": "SBB0000011", "jumlah": 10, "harga": 5000 },
    { "idBahanBaku": "BB0000017", "idSatuan": "SBB0000011", "jumlah": 2, "harga": 5000 }
  ]
}

### ============ HEADER PENERIMAAN + DETAIL PENERIMAAN ============
### Get All
GET {{DaffaCatering.API_HostAddress}}/api/HeaderPenerimaan

### Get By ID
GET {{DaffaCatering.API_HostAddress}}/api/HeaderPenerimaan/PN0000001

### Create - Terima barang dari pembelian PB0000010
POST {{DaffaCatering.API_HostAddress}}/api/HeaderPenerimaan
Content-Type: application/json

{
  "idPenerimaan": "PNM0000014",
  "idPemasok": "PMS0000013",
  "idPembelian": "PB0000010",
  "tglPenerimaan": "2026-09-22",
  "status": "Selesai",
  "details": [
    { "idBahanBaku": "BB0000016", "idSatuan": "SBB0000011", "jumlah": 10, "tglKadaluwarsa": "2027-03-01", "statusBahanBaku": "Baik" },
    { "idBahanBaku": "BB0000017", "idSatuan": "SBB0000011", "jumlah": 2, "tglKadaluwarsa": "2027-02-15", "statusBahanBaku": "Baik" }
  ]
}

### ============ HEADER PENGGUNAAN + DETAIL PENGGUNAAN ============
### Get All
GET {{DaffaCatering.API_HostAddress}}/api/HeaderPenggunaan

### Get By ID
GET {{DaffaCatering.API_HostAddress}}/api/HeaderPenggunaan/PBP0000008

### Create - FEFO otomatis pilih batch
POST {{DaffaCatering.API_HostAddress}}/api/HeaderPenggunaan
Content-Type: application/json

{
  "idPenggunaan": "PBP0000009",
  "tglPenggunaan": "2026-09-22",
  "details": [
    { "idBahanBaku": "BB0000016", "jumlahPenggunaan": 5 }
  ]
}

### ============ HEADER PENYESUAIAN + DETAIL PENYESUAIAN ============
### Get All
GET {{DaffaCatering.API_HostAddress}}/api/HeaderPenyesuaianBahanBaku

### Get By ID
GET {{DaffaCatering.API_HostAddress}}/api/HeaderPenyesuaianBahanBaku/PSY0000007

### Create - Koreksi + pecah 1 batch jadi 2 tanggal
POST {{DaffaCatering.API_HostAddress}}/api/HeaderPenyesuaianBahanBaku
Content-Type: application/json

{
  "idPenyesuaian": "PSY0000008",
  "tglPenyesuaian": "2026-09-22",
  "details": [
    { "idBahanBaku": "BB0000016", "tglKadaluwarsa": "2027-03-01", "idSatuan": "SBB0000011", "stokFisik": 3, "keterangan": "Koreksi setelah stock opname" },
    { "idBahanBaku": "BB0000016", "tglKadaluwarsa": "2027-06-01", "idSatuan": "SBB0000011", "stokFisik": 2, "keterangan": "Ditemukan batch baru saat stock opname" }
  ]
}

### ============ HEADER RESEP + DETAIL RESEP ============
### Get All
GET {{DaffaCatering.API_HostAddress}}/api/HeaderResep

### Get By ID
GET {{DaffaCatering.API_HostAddress}}/api/HeaderResep/RS0000012

### Create - Resep untuk 1 menu, dengan 2 komposisi bahan baku
POST {{DaffaCatering.API_HostAddress}}/api/HeaderResep
Content-Type: application/json

{
  "idResep": "RS0000013",
  "idMenu": "MN0000015",
  "status": true,
  "details": [
    { "idBahanBaku": "BB0000016", "idSatuan": "SBB0000011", "jumlah": 2 },
    { "idBahanBaku": "BB0000017", "idSatuan": "SBB0000011", "jumlah": 1 }
  ]
}

### ============ HEADER PESANAN + DETAIL PESANAN ============
### Get All
GET {{DaffaCatering.API_HostAddress}}/api/HeaderPesanan

### Get By ID
GET {{DaffaCatering.API_HostAddress}}/api/HeaderPesanan/PP0000007

### Create
POST {{DaffaCatering.API_HostAddress}}/api/HeaderPesanan
Content-Type: application/json

{
  "idPesanan": "PP0000009",
  "idPelanggan": "PLG0000013",
  "tglPesanan": "2026-09-22",
  "tglPengambilan": "2026-09-25",
  "metodePembayaran": "Cash",
  "uangMuka": 50000,
  "keterangan": "Test pesanan",
  "status": "Open",
  "details": [
    { "idMenu": "MN0000015", "idSatuan": "SBB0000011", "jumlah": 3, "harga": 25000 }
  ]
}

### ============ HEADER PENJUALAN + DETAIL PENJUALAN ============
### Get All
GET {{DaffaCatering.API_HostAddress}}/api/HeaderPenjualan

### Get By ID
GET {{DaffaCatering.API_HostAddress}}/api/HeaderPenjualan/PNJ0000010

### Create - Menu terjual, stok bahan baku otomatis berkurang sesuai resep
