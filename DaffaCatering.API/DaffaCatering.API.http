@DaffaCatering.API_HostAddress = http://localhost:5247

### FORMAT > POST = Create, PUT = Update, DELETE = Delete, GET = Get All / Get By ID
### DELETE {{DaffaCatering.API_HostAddress}}/api/{namaTabel}/{idKolom}

### ============ HeaderBahanBaku ============
### Get All
GET {{DaffaCatering.API_HostAddress}}/api/HeaderBahanBaku

### Get All (filter status=true)
GET {{DaffaCatering.API_HostAddress}}/api/HeaderBahanBaku?status=true

### Get By ID
GET {{DaffaCatering.API_HostAddress}}/api/HeaderBahanBaku/BB0000016

### Create
POST {{DaffaCatering.API_HostAddress}}/api/HeaderBahanBaku
Content-Type: application/json

{
  "idBahanBaku": "BB0000016",
  "namaBahanBaku": "Test Bahan Baku",
  "jenis": true,
  "status": true
}

### ============ Pemasok ============
### Get All
GET {{DaffaCatering.API_HostAddress}}/api/Pemasok

### Get By ID
GET {{DaffaCatering.API_HostAddress}}/api/Pemasok/PMS0000013

### Create
POST {{DaffaCatering.API_HostAddress}}/api/Pemasok
Content-Type: application/json

{
  "idPemasok": "PMS0000013",
  "namaPemasok": "Test Pemasok",
  "alamat": "Jl. Merdeka No. 10",
  "noKontak": "081234567890",
  "status": true,
  "tglBergabung": "2026-01-01"
}

