{
  "idPemasok": "PMS0000013",
  "namaPemasok": "Test Pemasok Update",
  "alamat": "Jl. Lingkup No. 15",
  "noKontak": "081233568870",
  "status": true,
  "tglBergabung": "2026-01-01"
}

### Delete
DELETE {{DaffaCatering.API_HostAddress}}/api/Pemasok/PMS0000013