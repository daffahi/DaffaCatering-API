@DaffaCatering.API_HostAddress = http://localhost:5247

### Get All (tanpa filter)
GET {{DaffaCatering.API_HostAddress}}/api/HeaderBahanBaku

### Get All dengan filter status=true
GET {{DaffaCatering.API_HostAddress}}/api/HeaderBahanBaku?status=true

### Get By ID
GET {{DaffaCatering.API_HostAddress}}/api/HeaderBahanBaku/BB0000016

### Create (Test validasi gagal - nama kosong)
POST {{DaffaCatering.API_HostAddress}}/api/HeaderBahanBaku
Content-Type: application/json

{
  "idBahanBaku": "BB0000016",
  "namaBahanBaku": "",
  "jenis": true,
  "status": true
}

### Create (Test duplicate ID)
POST {{DaffaCatering.API_HostAddress}}/api/HeaderBahanBaku
Content-Type: application/json

{
  "idBahanBaku": "BB0000016",
  "namaBahanBaku": "Duplikat Test",
  "jenis": true,
  "status": true
}

### Update
PUT {{DaffaCatering.API_HostAddress}}/api/HeaderBahanBaku/BB0000016
Content-Type: application/json

{
  "idBahanBaku": "BB0000016",
  "namaBahanBaku": "Test Bahan Baku Updated",
  "jenis": true,
  "status": false
}

### Delete
DELETE {{DaffaCatering.API_HostAddress}}/api/HeaderBahanBaku/BB0000016

### Pemasok - Get All
GET {{DaffaCatering.API_HostAddress}}/api/Pemasok/PMS0000012

### Pemasok - Create
PUT {{DaffaCatering.API_HostAddress}}/api/Pemasok/PMS0000012
Content-Type: application/json

{
  "idPemasok": "PMS0000012",
  "namaPemasok": "Toko Sembako Jaya",
  "alamat": "Jl. Merdeka No. 10",
  "noKontak": "081234567890",
  "status": true,
  "tglBergabung": "2026-01-01"
}